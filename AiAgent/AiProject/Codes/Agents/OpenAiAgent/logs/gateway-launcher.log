OnAutoMoveBtnClicked(); }).AddTo(this);\\n            \\n            lockAutoSkill.OnClickAsObservable().Subscribe(_ => { OnLockAutoClicked(); }).AddTo(this);\\n            lockX2.OnClickAsObservable().Subscribe(_ => { OnLockX2Clicked(); }).AddTo(this);\\n            \\n            nodeLocked.OnClickAsObservable().Subscribe(_ => { OnExtraLockedClicked(); }).AddTo(this);\\n\\n            videoClickSprite.OnClickAsObservable().Subscribe(_ =>\\n            {\\n                if (_videoCloseBtn)\\n                {\\n                    Utils.SetActive(_videoCloseBtn.gameObject, true);\\n                }\\n            }).AddTo(this);\\n\\n            if (_videoCloseBtn)\\n            {\\n                _videoCloseBtn.OnClickAsObservable().Subscribe(_ => { Utils.SetActive(guideInfoShow, false); })\\n                    .AddTo(this);\\n            }\\n\\n            if (iconBuff)\\n            {\\n                iconBuff.OnPressAsObservable().Subscribe(OnPressIconBtn).AddTo(this);\\n            }\\n\\n            MessageBroker.Default.Receive<TDWaveChangedEvt>().Subscribe(UpdateWave).AddTo(this);\\n            MessageBroker.Default.Receive<TowerDefenceMgr.EnSquadSelectedEvt>().Subscribe(OnHeroSelected).AddTo(this);\\n            MessageBroker.Default.Receive<TDRemoveSquad>().Subscribe(OnRemoveSquadItem).AddTo(this);\\n\\n            //MessageBroker.Default.Receive<TDSkillCreatedEvt>().Subscribe(_ => { OnIslandSkillCreated(_.actAS); })\\n            //    .AddTo(this);\\n            MessageBroker.Default.Receive<TowerDefenceMgr.TDBeginFightEvt>().Subscribe(_ =>\\n            {\\n                RefreshHouseInfo();\\n                Utils.SetActive(btn_back, !_isFirstLevel); /*第一关不显示*/\\n            }).AddTo(this);\\n            \\n            MessageBroker.Default.Receive<TowerDefenceMgr.TDAutoSetAIStateEvt>().Subscribe(_ =>\\n            {\\n                AutoSetAIState();\\n                btn_Auto_Normal_UIButton.isEnabled = true;\\n                btn_Auto_Skill_UIButton.isEnabled = true;\\n                btn_Auto_Move_UIButton.isEnabled = true;\\n                btn_X2_UIButton.isEnabled = true;\\n            }).AddTo(this);\\n            \\n            \\n            MessageBroker.Default.Receive<TowerDefenseWaveEvent>().Subscribe(_ => { OnWaveStart(_.IsLanding, _.Ship); })\\n                .AddTo(this);\\n            MessageBroker.Default.Receive<TowerDefenceMgr.TDWaveClearedEvt>()\\n                .Subscribe(_ => { OnWaveCleared(_.WaveOrder); }).AddTo(this);\\n            Observable.Interval(TimeSpan.FromSeconds(1f)).Subscribe(_ => { OnTick(); }).AddTo(this);\\n\\n            MessageBroker.Default.Receive<StepTowerDefenseShowTipsEvt>().Subscribe(_ =>\\n            {\\n                var talk = NGUITools.AddChildTo(tDTipsTalk.transform.parent.gameObject, tDTipsTalk);\\n                if (talk)\\n                {\\n                    var scr = talk.GetComponent<TDTipsTalk>();\\n\\n                    string tempTalkSound = _.Data.BaseData.param10;\\n                    float heightOffset = 0;\\n                    float.TryParse(_.Data.BaseData.param9, out heightOffset);\\n                    if (heightOffset > 1 || heightOffset < -1)\\n                    {\\n                        UIWidget widget = talk.GetComponent<UIWidget>();\\n                        if (widget != null)\\n                        {\\n                            widget.bottomAnchor.absolute += (int)heightOffset;\\n                            widget.topAnchor.absolute += (int)heightOffset;\\n                        }\\n\\n                        _TDTalkHeightOffset = heightOffset;\\n                        _TDHeightTalk = scr;\\n                    }\\n                    else\\n                    {\\n                        if (_TDTalkHeightOffset > 1 || _TDTalkHeightOffset < -1)\\n                        {\\n                            UIWidget widget = talk.GetComponent<UIWidget>();\\n                            if (widget != null)\\n                            {\\n                                widget.bottomAnchor.absolute += (int)_TDTalkHeightOffset;\\n                                widget.topAnchor.absolute += (int)_TDTalkHeightOffset;\\n                            }\\n                        }\\n                    }\\n\\n                    if (scr)\\n                    {\\n                        if (_talkSound != tempTalkSound)\\n                        {\\n                            AudioManager.Instance.StopStoryTalkVoice(_talkSound);\\n                            AudioManager.Instance.PlayStoryTalkVoice(tempTalkSound);\\n                            _talkSound = tempTalkSound;\\n                        }\\n\\n                        scr.OnCreate(_.Data, this, ++_talkIndex);\\n                        _TDLastTalk = scr;\\n                    }\\n                }\\n            }).AddTo(this);\\n\\n            MessageBroker.Default.Receive<BossActionTalkEvt>().Subscribe(_ =>\\n            {\\n                if (_TDLastTalk != null)\\n                    return;\\n\\n                var talk = NGUITools.AddChildTo(tDTipsTalk.transform.parent.gameObject, tDTipsTalk);\\n                if (talk)\\n                {\\n                    var scr = talk.GetComponent<TDTipsTalk>();\\n                    string tempTalkSound = _.Data.MonsterTalkSound;\\n                    float heightOffset = _.Data.MonsterTalkOffset;\\n                    if (heightOffset > 1 || heightOffset < -1)\\n                    {\\n                        UIWidget widget = talk.GetComponent<UIWidget>();\\n                        if (widget != null)\\n                        {\\n                            widget.bottomAnchor.absolute += (int)heightOffset;\\n                            widget.topAnchor.absolute += (int)heightOffset;\\n                        }\\n\\n                        _TDTalkHeightOffset = heightOffset;\\n                        _TDHeightTalk = scr;\\n                    }\\n                    else\\n                    {\\n                        if (_TDTalkHeightOffset > 1 || _TDTalkHeightOffset < -1)\\n                        {\\n                            UIWidget widget = talk.GetComponent<UIWidget>();\\n                            if (widget != null)\\n                            {\\n                                widget.bottomAnchor.absolute += (int)_TDTalkHeightOffset;\\n                                widget.topAnchor.absolute += (int)_TDTalkHeightOffset;\\n                            }\\n                        }\\n                    }\\n\\n                    if (scr)\\n                    {\\n                        if (_talkSound != tempTalkSound)\\n                        {\\n                            AudioManager.Instance.StopStoryTalkVoice(_talkSound);\\n                            AudioManager.Instance.PlayStoryTalkVoice(tempTalkSound);\\n                            _talkSound = tempTalkSound;\\n                        }\\n\\n                        scr.OnCreate(_.Data, this, ++_talkIndex);\\n                    }\\n                }\\n            }).AddTo(this);\\n\\n            var village = MonoSingleton<Island>.Instance.GetIslandComponent<Village>();\\n            if (village != null)\\n                village.OnHouseDestroyedVoid += RefreshHouseInfo;\\n\\n            RegisterTutorialEvent();\\n        }\\n\\n        private void UpdateModeLayout()\\n        {\\n            CheckEndLessMode();\\n            CheckTimeLimiteMode();\\n        }\\n\\n        private void CheckEndLessMode()\\n        {\\n            bool isEndlessMode = TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.EndLess;\\n            Utils.SetActive(targetProgress, true);\\n            Utils.SetActive(costTime, isEndlessMode);\\n            waveLabel_UILabel.transform.parent.gameObject.SetActive(!isEndlessMode);\\n            iconBuff.SetActive(isEndlessMode);\\n        }\\n        \\n        private void CheckTimeLimiteMode()\\n        {\\n            if (TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.AllianceBoss ||\\n                TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.AllianceTree ||\\n                TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.AllianceMine)\\n            {\\n                Utils.SetActive(allianceBossPart, true);\\n            }\\n        }\\n\\n        private void UpdateBufferInfo(bool isOnShow = false)\\n        {\\n            Utils.SetActive(tipsBuff, false);\\n\\n            if (iconBuff_UITexture != null)\\n                iconBuff_UITexture.mainTexture = null;\\n\\n            if (TowerDefenceMgr.Instance.CurGameMode != TowerDefenceMgr.GameMode.EndLess)\\n                return;\\n\\n            if (isOnShow && TowerDefenceMgr.Instance.MultiTowerInfo.CurSceneIndex == 0)\\n                return;\\n\\n            string skillBuffId = EndlessBnManager.Instance.CurInscription != null\\n                ? EndlessBnManager.Instance.CurInscription.Id\\n                : string.Empty;\\n            TowerDefenseSkillBuffInfo buffInfo =\\n                Config2.ConfigManager2.Instance.DB_TowerDefenseSkillBuff.GetById(skillBuffId);\\n            if (null != buffInfo)\\n            {\\n                string title = Utils.XLAT(buffInfo.Name);\\n                string desc = Utils.XLAT(buffInfo.Description);\\n                tipsBuff_TDBufferTips.SetData(title, desc, buffInfo.Pic);\\n\\n                BuilderFactory.Instance.HandyBuild(iconBuff_UITexture, buffInfo.Pic);\\n            }\\n            else\\n            {\\n                if (Application.isEditor)\\n                {\\n                    D.Error($\\"[editor] TD Buff is null! buff id:{EndlessBnManager.Instance.BuffId}\\");\\n                }\\n            }\\n        }\\n\\n        private void InitTargetProgress()\\n        {\\n            if (TowerDefenceMgr.Instance.CurGameMode != TowerDefenceMgr.GameMode.EndLess)\\n                return;\\n\\n            int targetCount = EndlessBnManager.GameTargetCount;\\n            AdvanceClimbingLevelInfo levelInfo = EndlessBnManager.Instance.CurLevelInfo;\\n            if (null == levelInfo)\\n                return;\\n\\n            string[] desc = new string[]\\n            {\\n                Utils.XLAT_Extend(\\"infinite_mode_pass_countdown\\", levelInfo.ChStar1 / 60),\\n                Utils.XLAT_Extend(\\"infinite_mode_pass_countdown\\", levelInfo.ChStar2 / 60),\\n                Utils.XLAT_Extend(\\"infinite_mode_pass_countdown\\", levelInfo.ChStar3 / 60),\\n            };\\n\\n            var pastTime = (long)TowerDefenceMgr.Instance.LevelDurationInTotal;\\n            bool[] completeState = new bool[3];\\n            completeState[0] = pastTime < levelInfo.ChStar1;\\n            completeState[1] = pastTime < levelInfo.ChStar2;\\n            completeState[2] = pastTime < levelInfo.ChStar3;\\n\\n            _gameTargetState.Init(levelInfo.ChStar1, levelInfo.ChStar2, levelInfo.ChStar3);\\n            targetProgress_TDTargetProgress.SetData(targetCount, desc, completeState);\\n        }\\n\\n        private void UpdateTargetProgress()\\n        {\\n            int targetCount = EndlessBnManager.GameTargetCount;\\n            \\n            bool[] completeState = new bool[targetCount];\\n\\n            var levelInfo = EndlessBnManager.Instance.CurLevelInfo;\\n            var pastTime = (long)TowerDefenceMgr.Instance.LevelDurationInTotal;\\n            if (levelInfo != null)\\n            {\\n                completeState[0] = pastTime < levelInfo.ChStar1;\\n                completeState[1] = pastTime < levelInfo.ChStar2;\\n                completeState[2] = pastTime < levelInfo.ChStar3;\\n            }\\n\\n            targetProgress_TDTargetProgress.UpdateState(completeState);\\n        }\\n\\n        private void OnPressIconBtn(bool isPress)\\n        {\\n            if (TowerDefenceMgr.Instance.CurGameMode != TowerDefenceMgr.GameMode.EndLess)\\n                return;\\n\\n            if (isPress)\\n            {\\n                Utils.SetActive(tipsBuff, true);\\n            }\\n            else\\n            {\\n                Utils.SetActive(tipsBuff, false);\\n            }\\n        }\\n\\n        public void OnFinishSelectBattleBuff(Vector3 skillCardPos)\\n        {\\n            UpdateBufferInfo();\\n            UpdateGameTime();\\n            PlayBattleBuffActiveAnim(skillCardPos);\\n        }\\n\\n        private void UpdateGameTime()\\n        {\\n            if (TowerDefenceMgr.Instance.CurGameMode != TowerDefenceMgr.GameMode.EndLess)\\n                return;\\n\\n            long passedTime = (long)TowerDefenceMgr.Instance.LevelDurationInTotal;\\n            costTime_UILabel.text = Utils.FormatTime(passedTime);\\n\\n            if (_gameTargetState.StateChange(passedTime))\\n            {\\n                UpdateTargetProgress();\\n            }\\n        }\\n\\n        private void PlayBattleBuffActiveAnim(Vector3 fxBeginPos)\\n        {\\n            if (TowerDefenceMgr.Instance.MultiTowerInfo.CurSceneIndex == 0)\\n            {\\n                Utils.SetActive(icon_FX_trail, false);\\n                Utils.SetActive(iconBuff, false);\\n\\n                icon_FX_trail.transform.position = fxBeginPos;\\n                Utils.SetActive(icon_FX_trail, true);\\n\\n                float flyTime = 0.6f;\\n                Hashtable flyAnimParam = new Hashtable();\\n                flyAnimParam.Add(\\"position\\", iconBuff.transform.position);\\n                flyAnimParam.Add(\\"islocal\\", false);\\n                flyAnimParam.Add(\\"time\\", flyTime);\\n                flyAnimParam.Add(\\"easetype\\", iTween.EaseType.linear);\\n                iTween.MoveTo(icon_FX_trail, flyAnimParam);\\n\\n                Observable.Timer(TimeSpan.FromSeconds(flyTime)).Subscribe(_ =>\\n                    {\\n                        Utils.SetActive(iconBuff, true);\\n                        icon_FX_trail.transform.localPosition= buffShowFetter.transform.localPosition;\\n                        Utils.SetActive(icon_FX_trail, false);\\n                        ShowFetterView();\\n                    })\\n                    .AddTo(this);\\n            }\\n            else\\n            {\\n                Utils.SetActive(iconBuff, true);\\n            }\\n        }\\n\\n        public void OnTalkCreated(float height)\\n        {\\n            // D.Error(\\"OnTalkCreated height:{0}\\",height);\\n            MessageBroker.Default.Publish(new TDTalkMoveEvt\\n            {\\n                fromIndex = _talkIndex,\\n                moveHeight = _lastTDTalkHeight + height\\n            });\\n\\n            _lastTDTalkHeight = height;\\n        }\\n\\n        public void OnTalkDestroyed(TDTipsTalk talk)\\n        {\\n            if (_TDHeightTalk != null && talk != _TDHeightTalk)\\n            {\\n                _lastTDTalkHeight = 0;\\n                _TDHeightTalk = null;\\n            }\\n\\n            if (talk == _TDLastTalk && _TDLastTalk != null)\\n            {\\n                _TDLastTalk = null;\\n            }\\n        }\\n\\n        private void RegisterTutorialEvent()\\n        {\\n            MessageBroker.Default.Receive<TutorialPublishStepEvt>().Subscribe(obj =>\\n            {\\n                //using (new ScopedProfiler(\\"TDBattleDlg.TutorialPublishStepEvt\\"))\\n                {\\n                    string p = obj.Param;\\n                    if (string.IsNullOrEmpty(p)) return;\\n\\n                    switch (p)\\n                    {\\n                        case \\"TDCameraMove\\":\\n                        {\\n                            if (string.IsNullOrEmpty(obj.Param1))\\n                            {\\n                                break;\\n                            }\\n\\n                            if (float.TryParse(obj.Param1, out var dur))\\n                            {\\n                                var node = Utils.FindChild(Island.Instance.gameObject, \\"DummyCameraPos\\");\\n                                if (node)\\n                                {\\n                                    var panY = Utils.FindChild(node, \\"DummyPanY\\");\\n                                    var panX = Utils.FindChild(node, \\"DummyPanX\\");\\n                                    var yaw = Utils.FindChild(node, \\"DummyYaw\\");\\n                                    var pitch = Utils.FindChild(node, \\"DummyPitch\\");\\n                                    var cam = Utils.FindChild(node, \\"DummyCam\\");\\n                                    if (panY && panX && yaw && pitch && cam)\\n                                    {\\n                                        var sizeNode = cam.transform.childCount > 0 ? cam.transform.GetChild(0) : null;\\n                                        float size = 4;\\n                                        float.TryParse(sizeNode.name, out size);\\n                                        LevelCamera.Instance.StartMoveByTutorial(new Vector4(\\n                                                panY.transform.localPosition.y,\\n                                                panX.transform.localPosition.x,\\n                                                yaw.transform.eulerAngles.y, pitch.transform.eulerAngles.x),\\n                                            size, dur / 3.0f);\\n                                    }\\n                                }\\n                            }\\n\\n                            break;\\n                        }\\n                        case \\"ShowVillageName\\":\\n                        {\\n                            break;\\n                        }\\n                        case \\"HideVillageName\\":\\n                        {\\n                            break;\\n                        }\\n                        case \\"SpawnHeroes\\":\\n                        {\\n                            Island.Instance.BeginBattle();\\n                            break;\\n                        }\\n                        case \\"TDTarget2Begin\\":\\n                        {\\n                            break;\\n                        }\\n                        case \\"TDTutorial\\":\\n                        {\\n                            if (string.IsNullOrEmpty(obj.Param1))\\n                            {\\n                                break;\\n                            }\\n\\n                            if (obj.Param1 == \\"Close\\")\\n                            {\\n                                //这里感觉有问题，不应该有引导走到这里，但我没敢删。如果出了问题，应该参考关卡的标准退出方式如Island.SetGameResultOver,Island.CheckGameOver\\n                                Island.Instance.ChangeToState(Island.GameState.Finished);\\n                                OnCloseButtonPress();\\n\\n                                if (GameEngine.IsAvailable)\\n                                    TowerDefenceMgr.Instance.ExitScene();\\n                            }\\n                            else if (obj.Param1 == \\"PlayVillagersEscape\\")\\n                            {\\n                                PlayAnim(\\"Story_Villagers_Escape\\");\\n                            }\\n                            else if (obj.Param1 == \\"PlayBoatEscape\\")\\n                            {\\n                                PlayAnim(\\"Story_Boat_Escape\\");\\n                            }\\n                            else if (obj.Param1 == \\"Camera\\")\\n                            {\\n                                Utils.SetActive(LevelCamera.Instance.gameObject, obj.Param2 == \\"Open\\");\\n                            }\\n\\n                            break;\\n                        }\\n                        case \\"TDTarget\\":\\n                        {\\n                            if (string.IsNullOrEmpty(obj.Param1))\\n                            {\\n                                break;\\n                            }\\n\\n                            if (obj.Param1 == \\"Modify\\")\\n                            {\\n                                if (string.IsNullOrEmpty(obj.Param2))\\n                                {\\n                                    break;\\n                                }\\n\\n                                if (Island.GamePlayTD.LevelInfo == null) break;\\n\\n                                var keyArr = Island.GamePlayTD.LevelInfo.TargetText.Split(\';\');\\n                                if (keyArr.Length < 2) break;\\n\\n                                if (obj.Param2 == \\"2\\")\\n                                {\\n                                    _targetKey = keyArr[1];\\n                                    int.TryParse(Island.GamePlayTD.LevelInfo.Target2AchieveParameter, out _targetParam);\\n                                    UpdateTargetLabel();\\n                                }\\n                            }\\n\\n                            break;\\n                        }\\n                        case \\"TDTouch\\":\\n                        {\\n                            if (string.IsNullOrEmpty(obj.Param1))\\n                                break;\\n\\n                            if (obj.Param1 == \\"Open\\")\\n                            {\\n                                XTutorialMgr.TutorialDlg.SetOverrideForceValue(XTutorialDlg.BlockScreenOverrideForceEnum.Default, false);\\n                                XTutorialMgr.TutorialDlg.SetBgClickTips(false);\\n                            }\\n                            else if (obj.Param1 == \\"Close\\")\\n                            {\\n                                XTutorialMgr.TutorialDlg.SetOverrideForceValue(XTutorialDlg.BlockScreenOverrideForceEnum.Default);\\n                                XTutorialMgr.TutorialDlg.SetBgClickTips(true, obj.Param2);\\n                            }\\n\\n                            break;\\n                        }\\n                    }\\n                }\\n            }).AddTo(this);\\n        }\\n\\n        public override void OnShow(UIParameter orgParam = null)\\n        {\\n            base.OnShow(orgParam);\\n\\n            if (Island.GamePlayTD.LevelInfo == null) return;\\n\\n            if (!string.IsNullOrEmpty(Island.GamePlayTD.LevelInfo.SoundLevel))\\n            {\\n                float.TryParse(Island.GamePlayTD.LevelInfo.SoundLevel, out var soundLevel);\\n                AudioManager.Instance.TDBgmVolumeRatio = soundLevel;\\n            }\\n\\n            float.TryParse(Island.GamePlayTD.LevelInfo.DelaySettlement, out var tmpDelay);\\n            TowerDefenceMgr.DelaySettlement = tmpDelay / 1000;\\n            TowerDefenceMgr.FailureCheckMode = (int)Island.GamePlayTD.LevelInfo.FailureModes;\\n\\n            Utils.SetActive(bossGroup, false);\\n            ResetBossInfo();\\n\\n            _islandCastBtn.gameObject.SetActive(false);\\n\\n\\n            if (targetLabel_UILabel)\\n                targetLabel_UILabel.text = Utils.XLAT(Island.GamePlayTD.LevelInfo.TargetDescription);\\n\\n            ShowBattleUI();\\n            RefreshHouseInfoInternal(false);\\n            UpdateModeLayout();\\n            InitTargetProgress();\\n            UpdateGameTime();\\n            UpdateBufferInfo(true);\\n            Utils.SetActive(btn_autoplay,false);\\n            Observable.Timer(TimeSpan.FromSeconds(1.5f)).Subscribe(_ => {UpdateAutoIdleButton(); }).AddTo(this);\\n        }\\n        \\n        void UpdateAutoIdleButton()\\n        {\\n            var fits = AdvanceLineManager.Instance.CanOpenAutoIdleFeature &&\\n                       TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.AdvanceLine;\\n            var pass=  AdvanceLineManager.Instance.IsLevelPassed(AdvanceLineManager.Instance.LastLevelInfo);\\n            Utils.SetActive(btn_autoplay,fits&&!pass);\\n            if (fits && !XTutorialMgr.Instance.HasActivatedStep())\\n            {\\n                EventManager.Instance.PushEvent(EventDef.STEP_COMMON_TRIGGER,AdvanceLineManager.ShowLegionAutoIdleXTTrigger);\\n            }\\n        }\\n        \\n        private void OnAutoIdleClicked()\\n        {\\n            var parameter = new MessageBoxWith2Buttons.Parameter();\\n            parameter.title = Utils.XLAT(\\"id_uppercase_note\\");// 提示\\n            parameter.content = Utils.XLAT(\\"advance_idle_open_desc\\");\\n            parameter.yes = Utils.XLAT(\\"btn_cancel\\"); //取消\\n            parameter.no = Utils.XLAT(\\"id_uppercase_confirmation\\"); // 确认\\n            parameter.noCallback = () =>\\n            {\\n                AdvanceLineManager.Instance.CurAutoIdleState = AdvanceLineManager.LegionAutoIdleState.Open;\\n                MonoSingleton<SquadSelector>.Instance.SelectSquad(null);\\n                Island.Instance.GetIslandComponent<TimeManager>().ClearTimeScale();\\n                // 退出战斗场景\\n                TowerDefenceMgr.Instance.ExitSceneToCityMode();\\n                UI.UIManager.inst.ShowPublicHud();\\n            };\\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.MessageBoxTowerDefense, parameter);\\n        }\\n\\n        private void PlayAnim(string animName)\\n        {\\n            if (_escapeAnim)\\n            {\\n                _escapeAnim.Play(animName);\\n            }\\n        }\\n\\n        private void UpdateWave(TDWaveChangedEvt evt)\\n        {\\n            if (!_hasShownBoss && evt.arriveLeft == 0)\\n            {\\n                PlayBossRelateSfx(evt);\\n\\n                bool needShowBoss = false;\\n                if (_tutorialDriver && !bossGroup.activeSelf)\\n                {\\n                    needShowBoss = true;\\n                }\\n                else if (!_tutorialDriver && !bossGroup.activeSelf)\\n                {\\n                    needShowBoss = true;\\n                }\\n\\n                GameObject bossNode = bossGroup;\\n                if (needShowBoss && evt.playBossSfx)\\n                {\\n                    _hasShownBoss = true;\\n                    float toScale = 0.001f;\\n                    Utils.SetActive(bossGroup, true);\\n                    _timeManager.RequestTimeScale(this, toScale);\\n                    Observable.TimerFrame(2).Subscribe(_ =>\\n                    {\\n                        Observable.Timer(TimeSpan.FromSeconds(3 * toScale)).Subscribe(s =>\\n                        {\\n                            _timeManager.RemoveTimeScale(this);\\n                            Observable.TimerFrame(2).Subscribe(_ =>\\n                            {\\n                                CheckBossHp(evt);\\n                                Utils.SetActive(bossGroup, false);\\n                            }).AddTo(this);\\n                        }).AddTo(this);\\n                    }).AddTo(this);\\n\\n                    return;\\n                }\\n            }\\n\\n            if (evt.wave >= _curWaveOrder && evt.arriveLeft == 0)\\n            {\\n                Utils.SetActive(waveBase, false);\\n                CheckBossHp(evt);\\n\\n                if (evt.showTips)\\n                {\\n                    Utils.SetActive(eliteBossGroup, true);\\n                }\\n            }\\n\\n            if (evt.wave == _curWaveOrder && evt.arriveLeft >= _timeArriveLeft)\\n                return;\\n\\n            _timeArriveLeft = evt.arriveLeft;\\n\\n            if (evt.wave > _curWaveOrder)\\n            {\\n                if (evt.arriveLeft == 0)\\n                {\\n                    Utils.SetActive(waveBase, false);\\n                }\\n                else\\n                {\\n                    if (!IsShowingAnyBossHp())\\n                        Utils.SetActive(waveBase, true);\\n                }\\n            }\\n\\n            if (evt.wave >= _curWaveOrder && (evt.wave == 1 && (evt.playBossSfx || evt.playBossUISfx || evt.showTips)))\\n                Utils.SetActive(waveBase, false);\\n            \\n            _curWaveOrder = Math.Max(evt.wave, _curWaveOrder);\\n            UILabel refWaveLabel = waveLabel_UILabel;\\n            UILabel refTipsLabel = tipsLabel_UILabel;\\n\\n            if (_tutorialDriver)\\n            {\\n                if (evt.wave == 1)\\n                {\\n                    EventManager.Instance.PushEvent(EventDef.STEP_COMMON_TRIGGER,\\n                        $\\"{EventDef.TD_FIRST_WAVE_COMING_COMMON_TRIGGER}|{Island.GamePlayTD.LevelInfo.Id}\\");\\n                    D.Log(\\"For debug first wave:{0}|{1},at:{2}\\", EventDef.TD_FIRST_WAVE_COMING_COMMON_TRIGGER,\\n                        Island.GamePlayTD.LevelInfo.Id, Time.time);\\n                }\\n                else if (evt.wave == 2)\\n                {\\n                    EventManager.Instance.PushEvent(EventDef.STEP_COMMON_TRIGGER,\\n                        $\\"{EventDef.TD_SECOND_WAVE_COMING_COMMON_TRIGGER}|{Island.GamePlayTD.LevelInfo.Id}\\");\\n                }\\n            }\\n\\n            var waveMax = Island.Instance.GetIslandComponent<RaidDriverContainer>().waveMax;\\n            refWaveLabel.text = $\\"{Utils.XLAT(\\"lead_in_2021_td_wave\\")} {_curWaveOrder}/{waveMax}\\";\\n            int keyIndex = 1;\\n            if (1 < _curWaveOrder && _curWaveOrder < waveMax)\\n            {\\n                keyIndex = 2;\\n            }\\n            else if (_curWaveOrder == waveMax)\\n            {\\n                keyIndex = 3;\\n            }\\n\\n            if (_waveLangKeyDict.ContainsKey(keyIndex))\\n            {\\n                refTipsLabel.text = Utils.XLAT_Extend(_waveLangKeyDict[keyIndex], _timeArriveLeft);\\n            }\\n\\n            MessageBroker.Default.Publish(new TowerDefenseWaveStartEvent\\n                { LevelId = Island.GamePlayTD.LevelInfo.Id, Wave = evt.wave });\\n        }\\n        \\n\\n        #region Auto & Speed\\n        private void InitExtraButtons()\\n        {\\n            _openX2SingleLock = ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.TOWER_DEFENSE_SPEED_LOCK);\\n            _autoAIBtn = new ExtraFuncBtn(checkAuto, fX_BtnAuto);\\n            _timeX2Btn = new ExtraFuncBtn(checkX2, fX_BtnX2);\\n            _autoMoveBtn = new ExtraFuncBtn(checkAutoMove, fX_BtnAutoMove);\\n            _autoSkillBtn = new ExtraFuncBtn(checkAutoSkill, fX_BtnAutoSkill);\\n\\n            RefreshAutoAIBtn();\\n            RefreshX2Btn();\\n            RefreshAutoMoveBtn();\\n            \\n            if (Island.GamePlayTD.LevelInfo != null)\\n            {\\n                if (Island.GamePlayTD.LevelInfo.IsShowAi != 0)\\n                {\\n                    _isAutoMove = Island.GamePlayTD.LevelInfo.LevelMoveMode ==\\n                                      TowerDefenseLevelsInfo.AutoMoveMode.Auto;\\n                    \\n                    btn_Auto_Skill_UIButton.isEnabled = false;\\n                    btn_Auto_Normal_UIButton.isEnabled = false;\\n                    btn_Auto_Move_UIButton.isEnabled = false;\\n                    btn_X2_UIButton.isEnabled = false;\\n                    \\n                    Utils.SetActive(btn_Auto_Skill,true);\\n                    Utils.SetActive(btn_X2,true);\\n                    Utils.SetActive(btn_Auto_Move,_isAutoMove);\\n                    \\n                    bool extraFuncUnlocked = CheckExtraFunctionUnlock();\\n                    _isNodeLock = !_openX2SingleLock && !extraFuncUnlocked;\\n                    //Utils.SetActive(nodeLocked,!_openX2SingleLock && !extraFuncUnlocked);\\n                    //Utils.SetActive(lockAuto,_openX2SingleLock && !extraFuncUnlocked);\\n                    //Utils.SetActive(lockX2,_openX2SingleLock && !CheckX2Unlock());\\n                    \\n                    Utils.SetActive(nodeLocked, false);\\n                    Utils.SetActive(lockAutoSkill,_isNodeLock || (_openX2SingleLock && !extraFuncUnlocked));\\n                    Utils.SetActive(lockX2,_isNodeLock || (_openX2SingleLock && !CheckX2Unlock()));\\n                    \\n                    SwitchAutoUIStateOnly();\\n                }\\n                else\\n                {\\n                    Utils.SetActive(btn_Auto_Normal,false);\\n                    Utils.SetActive(btn_X2,false);\\n                    Utils.SetActive(nodeLocked,false);\\n                    Utils.SetActive(btn_Auto_Move, false);\\n                    Utils.SetActive(btn_Auto_Skill, false);\\n                }\\n            }\\n        }\\n\\n        private void RefreshAutoAIBtn()\\n        {\\n            //_autoAIBtn.CheckGo.SetActive(_squadSpawner.enableSkill);\\n            //_autoAIBtn.VfxGo.SetActive(_squadSpawner.enableSkill);\\n            \\n            _autoSkillBtn.CheckGo.SetActive(_squadSpawner.enableSkill);\\n            _autoSkillBtn.VfxGo.SetActive(_squadSpawner.enableSkill);\\n            \\n            // UpdateAIState(_squadSpawner.enableAI,1);\\n        }\\n        \\n        private void RefreshAutoMoveBtn()\\n        {\\n            _autoMoveBtn.CheckGo.SetActive(_squadSpawner.enableMove);\\n            _autoMoveBtn.VfxGo.SetActive(_squadSpawner.enableMove);\\n            \\n            // _autoAIBtn.CheckGo.SetActive(_squadSpawner.enableAI);\\n            // _autoAIBtn.VfxGo.SetActive(_squadSpawner.enableAI);\\n            // UpdateAIState(_squadSpawner.enableAI,1);\\n        }\\n\\n        private void RefreshX2Btn()\\n        {\\n            var isDefault = Math.Abs(_timeManager.defaultTimeScale - 1f) < 0.001f;\\n            _timeX2Btn.CheckGo.SetActive(!isDefault);\\n            _timeX2Btn.VfxGo.SetActive(!isDefault);\\n        }\\n        \\n        private void AutoSetAIState()\\n        {\\n            if (Island.GamePlayTD.LevelInfo.IsShowAi == 0 || (!_openX2SingleLock && !CheckExtraFunctionUnlock()))\\n                return;\\n\\n            int localState = PlayerPrefsEx.GetIntByUid(TD_AUTO_LOCAL_STATE, 0);\\n            if ((localState & (1 << 1)) == (1 << 1)) // auto\\n            {\\n                OnAutoBattleBtnClicked();    \\n            }\\n            \\n            if ((localState & 1) == 1) // speed 2X\\n            {\\n                OnSpeedUpBtnClicked();    \\n            }\\n        }\\n\\n        private void UpdateAIState(bool val,int offset)                                                                                                                                          \\n        {\\n            int localState = PlayerPrefsEx.GetIntByUid(TD_AUTO_LOCAL_STATE,0);\\n            D.Log(\\"UpdateAIState,local:{0}\\", localState);\\n            localState &= ~(1 << offset);\\n            int toValue = val ? (1 << offset) : 0;\\n            PlayerPrefsEx.SetIntByUid(TD_AUTO_LOCAL_STATE, localState | toValue);\\n            D.Log(\\"UpdateAIState set to local:{0}\\", localState | toValue);\\n        }\\n        \\n        private void SwitchAutoUIStateOnly()\\n        {\\n            bool extraFuncUnlocked = CheckExtraFunctionUnlock();\\n            if (_openX2SingleLock)\\n            {\\n                if (!extraFuncUnlocked) UpdateAIState(false,1);\\n                if (!CheckX2Unlock()) UpdateAIState(false,0);\\n            }\\n            else\\n            {\\n                if (!extraFuncUnlocked)\\n                {\\n                    UpdateAIState(false,0);\\n                    UpdateAIState(false,1);\\n                }\\n            }\\n\\n            int localState = PlayerPrefsEx.GetIntByUid(TD_AUTO_LOCAL_STATE, 0);\\n            if ((localState & (1 << 1)) == (1 << 1)) // auto\\n            {\\n                //Utils.SetActive(_autoAIBtn.CheckGo,true);\\n                //Utils.SetActive(_autoAIBtn.VfxGo,true);\\n                \\n                Utils.SetActive(_autoSkillBtn.CheckGo,true);\\n                Utils.SetActive(_autoSkillBtn.VfxGo,true);\\n            }\\n            \\n            if ((localState & 1) == 1) // speed 2X\\n            {\\n                Utils.SetActive(_timeX2Btn.CheckGo,true);\\n                Utils.SetActive(_timeX2Btn.VfxGo,true);\\n            }\\n\\n            if (_isAutoMove)\\n            {\\n                Utils.SetActive(_autoMoveBtn.CheckGo,true);\\n                Utils.SetActive(_autoMoveBtn.VfxGo,true);\\n            }\\n        }\\n        \\n        void OnAutoBattleBtnClicked()\\n        {\\n            // if (_openX2SingleLock && !CheckExtraFunctionUnlock())\\n            // {\\n            //     UIManager.inst.toast.Show(Utils.XLAT(\\"linear_levels_complete_to_unlock_battle_speeder_2\\"));\\n            //     return;\\n            // }\\n            //\\n            // if (!_openX2SingleLock && !CheckExtraFunctionUnlock())\\n            // {\\n            //     var key = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(\\"linear_levels_complete_to_unlock_battle_speeder\\");\\n            //     UIManager.inst.toast.Show(key);\\n            //     return;\\n            // }\\n            \\n            _squadSpawner.enableSkill = !_squadSpawner.enableSkill;\\n            UpdateAIState(_squadSpawner.enableSkill,1);\\n        }\\n        \\n        void OnAutoMoveBtnClicked()\\n        {\\n            // if (_openX2SingleLock && !CheckExtraFunctionUnlock())\\n            // {\\n            //     UIManager.inst.toast.Show(Utils.XLAT(\\"linear_levels_complete_to_unlock_battle_speeder_2\\"));\\n            //     return;\\n            // }\\n            //\\n            // if (!_openX2SingleLock && !CheckExtraFunctionUnlock())\\n            // {\\n            //     var key = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(\\"linear_levels_complete_to_unlock_battle_speeder\\");\\n            //     UIManager.inst.toast.Show(key);\\n            //     return;\\n            // }\\n            \\n            _squadSpawner.enableMove = !_squadSpawner.enableMove;\\n        }\\n\\n        void OnSpeedUpBtnClicked()\\n        {\\n            // if (_openX2SingleLock && !CheckX2Unlock())\\n            // {\\n            //     return;\\n            // }\\n            //\\n            // if (!_openX2SingleLock && !CheckExtraFunctionUnlock())\\n            // {\\n            //     var key = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(\\"linear_levels_complete_to_unlock_battle_speeder\\");\\n            //     UIManager.inst.toast.Show(key);\\n            //     return;\\n            // }\\n            \\n            bool is1x = Math.Abs(_timeManager.defaultTimeScale - 1f) < 0.001f;\\n            _timeManager.defaultTimeScale = is1x ? 1.5f : 1f;\\n            UpdateAIState(is1x,0);\\n            \\n        }\\n\\n        void OnExtraLockedClicked()\\n        {\\n            if (!CheckExtraFunctionUnlock() && Island.Instance != null && Island.Instance.State == Island.GameState.Playing)\\n            {\\n                UIManager.inst.toast.Show(Utils.XLAT(\\"linear_levels_complete_to_unlock_battle_speeder\\"));\\n            }\\n        }\\n\\n        private bool CheckExtraFunctionUnlock()\\n        {\\n            //需求是如果不在对应的区间，默认就解锁\\n            var info = ConfigManager.inst.DB_FunctionOpenLv.GetDataByType(ConfigFunctionOpenLv.TOWER_DEFENSE_EXTRA);\\n            if (info == null)\\n                return true;\\n\\n            if (ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.TOWER_DEFENSE_EXTRA))\\n            {\\n                bool valid = NewGroupManager.Instance.IsV209RatioServer;\\n                if (!valid)\\n                {\\n                    var vipLv = ConfigManager2.Instance.DB_GameConfigs.GetIntValue(\\"tower_autofight_open_vip_lv\\");\\n                    if (PlayerData.inst.hostPlayer.VIPLevel >= vipLv)\\n                        return true;\\n                }\\n                \\n                valid = EnoughLevelConditionById(\\"tower_autofight_open_td_new\\");\\n                if (valid)\\n                {\\n                    return true;\\n                }\\n                \\n                /*var lineTdId = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(\\"tower_autofight_open_td_new\\");\\n                AdvanceLineLevelInfo levelInfo = ConfigManager2.Instance.DB_AdvanceLineLevel.GetById(lineTdId);\\n                if (AdvanceLineManager.Instance.IsLevelPassed(levelInfo))\\n                    return true;*/\\n            }\\n\\n            return false;\\n        }\\n        \\n        #region Speed purchase\\n\\n        void SpeedConfirmPopup()\\n        {\\n            MessageBoxWith1Button.Parameter parameter = new MessageBoxWith1Button.Parameter();\\n            parameter.Title = Utils.XLAT(\\"id_tips\\");\\n            parameter.Content = Utils.XLAT(\\"tower_speed_tips\\");\\n            parameter.Okay = Utils.XLAT(\\"id_uppercase_confirm\\");\\n            parameter.OkayCallback = OnCancelBuyX2;\\n            parameter.OnCloseCallback = OnCancelBuyX2;\\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.MessageBoxWith1Button, parameter);\\n        }\\n\\n        bool EnoughLevelCondition()\\n        {   \\n            var lineTdIds = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(\\"tower_speedfight_open_td_new\\");\\n            if (!string.IsNullOrEmpty(lineTdIds))\\n            {\\n                var lineTdIdArray = lineTdIds.Split(\'|\');\\n                foreach (var lineTdId in lineTdIdArray)\\n                {\\n                    AdvanceLineLevelInfo levelInfo = ConfigManager2.Instance.DB_AdvanceLineLevel.GetById(lineTdId);\\n                    if (AdvanceLineManager.Instance.IsLevelPassed(levelInfo))\\n                        return true;\\n                }\\n                return false;\\n            }\\n            \\n            return true;\\n        }\\n\\n        bool EnoughLevelConditionById(string key)\\n        {\\n            var lineTdIds = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(key);\\n            if (string.IsNullOrEmpty(lineTdIds))\\n            {\\n                return false;\\n            }\\n\\n            var lineTdIdArray = lineTdIds.Split(\'|\');\\n            foreach (var lineTdId in lineTdIdArray)\\n            {\\n                AdvanceLineLevelInfo levelInfo = ConfigManager2.Instance.DB_AdvanceLineLevel.GetById(lineTdId);\\n                if (AdvanceLineManager.Instance.IsLevelPassed(levelInfo))\\n                    return true;\\n            }\\n\\n            return false;\\n        }\\n\\n        private bool CheckX2Unlock()\\n        {\\n            if (ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.TOWER_DEFENSE_SPEED_LOCK))\\n            {\\n                if (NewGroupManager.Instance.IsNewServer)\\n                {\\n                    bool valid = EnoughLevelCondition();\\n                    return valid;\\n                }\\n             \\n                var mcd = DB.DBManager.inst.DB_MonthCard.Get(PlayerData.inst.uid);\\n                var monthJob = JobManager.Instance.GetJob(mcd.Work_point_month_card_job);\\n                long curTime = NetServerTime.inst.ServerTimestamp;\\n                if (null != monthJob && curTime < monthJob.EndTime())\\n                    return true;\\n\\n                var lineTdId = ConfigManager2.Instance.DB_GameConfigs.GetStringValue(\\"tower_speedfight_open_td_new\\");\\n                AdvanceLineLevelInfo levelInfo = ConfigManager2.Instance.DB_AdvanceLineLevel.GetById(lineTdId);\\n                if (AdvanceLineManager.Instance.IsLevelPassed(levelInfo))\\n                    return true;\\n            }\\n\\n            return false;\\n        }\\n\\n        private void OnLockAutoClicked()\\n        {\\n            if (!btn_Auto_Normal_UIButton.isEnabled)\\n            {\\n                return;\\n            }\\n\\n            if (_isNodeLock)\\n            {\\n                OnExtraLockedClicked();\\n                return;\\n            }\\n            \\n            bool valid = NewGroupManager.Instance.IsV209RatioServer;\\n            if (valid)\\n            {\\n                UIManager.inst.toast.Show(Utils.XLAT(\\"toast_tower_autofight_open_tips_key_sever_ratio\\"));\\n            }\\n            else\\n            {\\n                UIManager.inst.toast.Show(Utils.XLAT(\\"linear_levels_complete_to_unlock_battle_speeder_2\\"));\\n            }\\n        }\\n\\n        private void OnLockX2Clicked()\\n        {\\n            if (!btn_X2_UIButton.isEnabled)\\n            {\\n                return;\\n            }\\n            \\n            if (_isNodeLock)\\n            {\\n                OnExtraLockedClicked();\\n                return;\\n            }\\n\\n            SpeedConfirmPopup();\\n            \\n            /*UIManager.inst.OpenPopupAsync(UIManager.PopupType.TowerConfirmPopup,\\n                new UIOptimize.TowerConfirmPopup.TowerConfirmPopup.TowerConfirmPopup.Parameter\\n                {\\n                    onConfirmCallback = OnConfirmBuyX2,\\n                    onCancelCallback = OnCancelBuyX2\\n                });*/\\n            \\n            _timeManager.RequestTimeScale(this, 0.001f);\\n        }\\n\\n        private void OnConfirmBuyX2()\\n        {\\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.TowerMonthCardPopup,\\n                new UIOptimize.TowerMonthCardPopup.TowerMonthCardPopup.TowerMonthCardPopup.Parameter\\n                {\\n                    onCloseCallback = OnCancelBuyX2,\\n                    onBuySucceedCallback = OnBuyMonthCardSucceed\\n                });\\n        }\\n\\n        private void OnCancelBuyX2()\\n        {\\n            _timeManager.RemoveTimeScale(this);\\n        }\\n\\n        private void OnBuyMonthCardSucceed()\\n        {\\n            Observable.TimerFrame(1).Subscribe(_ =>\\n            {\\n                if (!CheckX2Unlock())\\n                {\\n                    D.Error(\\"month card is still locked after completing purchase\\");\\n                    return;\\n                }\\n            \\n                Utils.SetActive(lockX2,false);\\n                OnSpeedUpBtnClicked();    \\n            }).AddTo(this);\\n\\n            var hash = Utils.Hash(\\"action\\", \\"buy_succeed\\");\\n            OperationTrace.TraceClick(\\"tower_defense_month_card\\", hash);\\n        }\\n\\n        #endregion\\n        \\n        #endregion\\n        \\n        #region BossHp\\n\\n        private void ResetBossInfo()\\n        {\\n            if (_bossHpItems != null)\\n            {\\n                int count = _bossHpItems.Count;\\n                for (int i = 0; i < count; i++)\\n                {\\n                    var inst = _bossHpItems[i];\\n                    if (inst != null)\\n                        inst.Clear();\\n                }\\n            }\\n        }\\n\\n        private bool IsShowingAnyBossHp()\\n        {\\n            if (_bossHpItems != null)\\n            {\\n                int count = _bossHpItems.Count;\\n                for (int i = 0; i < count; i++)\\n                {\\n                    var inst = _bossHpItems[i];\\n                    if (inst != null && inst.IsShowing)\\n                        return true;\\n                }\\n            }\\n\\n            return false;\\n        }\\n\\n        public void CheckHideBossHp()\\n        {\\n            if (!IsShowingAnyBossHp())\\n            {\\n                if (_bossHpItems != null)\\n                {\\n                    int count = _bossHpItems.Count;\\n                    for (int i = 0; i < count; i++)\\n                    {\\n                        var inst = _bossHpItems[i];\\n                        if (inst != null)\\n                            inst.Clear();\\n                    }\\n                }\\n            }\\n        }\\n\\n        private void UpdateBossHp()\\n        {\\n            if (_bossHpItems != null)\\n            {\\n                int count = _bossHpItems.Count;\\n                for (int i = 0; i < count; i++)\\n                {\\n                    var inst = _bossHpItems[i];\\n                    if (inst != null)\\n                        inst.UpdateBossHp();\\n                }\\n            }\\n        }\\n\\n        private void CheckBossHp(TDWaveChangedEvt evt)\\n        {\\n            if (evt != null && evt.waveInfo != null)\\n            {\\n                if (evt.waveInfo.BossHp)\\n                {\\n                    if (evt.waveInst != null)\\n                    {\\n                        CheckShowBossHp(evt.waveInst.GetFirstAgent(), evt);\\n                    }\\n                }\\n            }\\n        }\\n\\n        private void CheckShowBossHp(Agent boss, TDWaveChangedEvt evt)\\n        {\\n            if (boss != null && _bossHpItems != null)\\n            {\\n                Utils.SetActive(waveBase, false);\\n\\n                int count = _bossHpItems.Count;\\n                if (count < BOSS_HP_ITEM_LIMIT)\\n                {\\n                    GameObject go = GameObject.Instantiate(tDBossBloodItem);\\n                    if (go != null)\\n                    {\\n                        Transform tr = go.transform;\\n                        TDBossBloodItem item = go.GetComponent<TDBossBloodItem>();\\n\\n                        if (tr != null && item != null)\\n                        {\\n                            tr.parent = bossBloodGroup.transform;\\n                            tr.SetSiblingIndex(count);\\n                            tr.localScale = Vector3.one;\\n\\n                            item.ShowBossHp(boss, evt, this);\\n                            _bossHpItems.Add(item);\\n                        }\\n\\n                        go.SetActive(true);\\n                        bossBloodGroup_UIGrid.repositionNow = true;\\n                        bossBloodGroup_UIGrid.Reposition();\\n                    }\\n                }\\n                else\\n                {\\n                    if (_bossHpItems != null)\\n                    {\\n                        for (int i = 0; i < count; i++)\\n                        {\\n                            var inst = _bossHpItems[i];\\n                            if (inst != null && inst.IsCanReUseNow)\\n                            {\\n                                inst.ShowBossHp(boss, evt, this);\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n\\n        //暂时先这么临时处理，如果后期变复杂，需要在配置表配置相应字段，正规一些\\n        public void AddAllianceBossHpManaully(TDWaveChangedEvt evt)\\n        {\\n            CheckShowBossHp(evt.waveInst.GetFirstAgent(), evt);\\n        }\\n\\n        #endregion\\n\\n        #region HouseInfo\\n\\n        private void RefreshHouseInfo()\\n        {\\n            RefreshHouseInfoInternal();\\n        }\\n        \\n        private void RefreshHouseInfoInternal(bool check = true)\\n        {\\n            var village = MonoSingleton<Island>.Instance.GetIslandComponent<Village>();\\n            if (village != null)\\n            {\\n                int num = village.LivingHouseCount;\\n                if (iconGuardNum_UILabel != null)\\n                {\\n                    iconGuardNum_UILabel.text = num.ToString();\\n                    Utils.SetActive(fX_Num_Change,false);\\n                    Utils.SetActive(fX_Num_Change,true);\\n                }\\n\\n                bool needToCheck = false;\\n          \\n                if (TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.AdvanceLine)\\n                {\\n                    needToCheck = true;\\n                }\\n                else if(TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.TD)\\n                {\\n                    if (Island.GamePlayTD.ExtraData == null && Island.GamePlayTD.IntelligenceQuestData == null)\\n                        needToCheck = true;\\n\\n                    if (Island.GamePlayTD.ExtraData != null)\\n                    {\\n                        if (Island.GamePlayTD.ExtraData is AdvanceLevelsInfo)\\n                            needToCheck = true;\\n                    }\\n                }\\n\\n                bool isRed = false;\\n                if (needToCheck && check)\\n                {\\n                    isRed = village.Houses != null && village.Houses.Length > village.LivingHouseCount &&\\n                                village.Houses.Length > 0;\\n                }\\n                \\n                if (isRed)\\n                {\\n                    if (targetLabel != null)\\n                        targetLabel_UILabel.color = Utils.GetColorFromHex(0xcc4747);\\n            \\n                    if (iconGuardNum_UILabel != null)\\n                        iconGuardNum_UILabel.color = Utils.GetColorFromHex(0xcc4747);\\n\\n                    if (houseIcon_UISprite)\\n                        houseIcon_UISprite.color = Utils.GetColorFromHex(0xcc4747);\\n                }\\n                else\\n                {\\n                    if (targetLabel != null)\\n                        targetLabel_UILabel.color = Color.white;\\n            \\n                    if (iconGuardNum_UILabel != null)\\n                        iconGuardNum_UILabel.color = Color.white;\\n\\n                    if (houseIcon_UISprite)\\n                        houseIcon_UISprite.color = Color.white;\\n                }\\n            }\\n        }\\n\\n        #endregion\\n\\n        private void PlayBossRelateSfx(TDWaveChangedEvt evt)\\n        {\\n            //TowerDefenceMgr.Instance.PlayBossBreatheSfx();\\n            if (evt.playBossUISfx)\\n            {\\n                TowerDefenseAudioDispatcher.PlayCombatSound(\\"td_boss_coming_ui\\", \\"\\");\\n            }\\n\\n            // if (evt.playBossSfx)\\n            // {\\n            //     TowerDefenceMgr.Instance.PlayFinalBossSfx();\\n            // }\\n        }\\n\\n        private void OnHeroSelected(TowerDefenceMgr.EnSquadSelectedEvt e)\\n        {\\n            if (e.PlaySound)\\n                TowerDefenseAudioDispatcher.Instance.PlaySound(e.EnSquad == null ? \\"troop_move\\" : \\"troop_select\\");\\n\\n            if (e.EnSquad && !string.IsNullOrEmpty(e.EnSquad.HeroDef.HeroInfo.SelectAudio))\\n            {\\n                AudioManager.Instance.PlaySound(e.EnSquad.HeroDef.HeroInfo.SelectAudio);\\n            }\\n\\n            _curHeroSkillPower = null;\\n\\n            //隐藏龙技能\\n            _islandCastBtn.gameObject.SetActive(false);\\n            ActiveAbility skill = null;\\n            if (e.EnSquad != null)\\n            {\\n                var heroDef = e.EnSquad.HeroDef;\\n                ShowHeroSkillItem(false); //隐藏英雄技能\\n                ShowHeroSkillItem(true, heroDef);\\n            }\\n            else\\n            {\\n                ShowHeroSkillItem(false); //隐藏英雄技能\\n                //显示龙技能\\n                if (!_islandCastBtn.ForceHide)\\n                    _islandCastBtn.gameObject.SetActive(true);\\n            }\\n        }\\n\\n        private void Update()\\n        {\\n            UpdateBossHp();\\n        }\\n\\n        private void InitBattleUI(TowerDefenseLevelsInfo info)\\n        {\\n            if (info == null)\\n                return;\\n\\n            MessageBroker.Default.Publish(new TowerDefenceMgr.EnSquadSelectedEvt() { PlaySound = false });\\n        }\\n\\n        private void OnTick()\\n        {\\n            UpdateIndicator();\\n            UpdateGameTime();\\n            UpdateTimeLimitMode();\\n        }\\n\\n        private void PlayVideo(TowerDefenseLevelsInfo info)\\n        {\\n            if (!TowerDefenceMgr.Instance.IsVideoVisible)\\n            {\\n                return;\\n            }\\n\\n            if (string.IsNullOrEmpty(info.GuidePicName))\\n            {\\n                return;\\n            }\\n\\n            Utils.SetActive(guideInfoShow, true);\\n            string videoPath = $\\"StoryVideo/{info.GuidePicName}\\";\\n            //\\n            var videoClip = FunPlus.AssetManager.AssetManagerEx.Instance.LoadHandle(videoPath);\\n            urlVideo_UrlVideoView.Init(new UrlVideoView.Parameter\\n            {\\n                videoClip = videoClip,\\n                loop = true\\n            });\\n\\n            Observable.Timer(TimeSpan.FromSeconds(0.1)).Subscribe(_ => { urlVideo_UrlVideoView.Show(); }).AddTo(this);\\n        }\\n\\n        #region wave indicator\\n\\n        private readonly Dictionary<Longship, Transform> _indicatorCache = new Dictionary<Longship, Transform>();\\n        private Rect _screenRect;\\n        private float _gapOffset = 20f;\\n\\n        private readonly Dictionary<VikingAgent.VikingType, string> _indicatorTypeDict =\\n            new Dictionary<VikingAgent.VikingType, string>\\n            {\\n                { VikingAgent.VikingType.SwordShield, \\"img_prompt_EnemyStrike_01\\" },\\n                { VikingAgent.VikingType.Hatchet, \\"img_prompt_EnemyStrike_03\\" },\\n                { VikingAgent.VikingType.Archer, \\"img_prompt_EnemyStrike_05\\" },\\n                { VikingAgent.VikingType.Shaman, \\"img_prompt_EnemyStrike_08\\" },\\n\\n                { VikingAgent.VikingType.BigBoss, \\"img_prompt_EnemyStrike_07\\" },\\n\\n                { VikingAgent.VikingType.SwordShieldBoss, \\"img_prompt_EnemyStrike_02\\" },\\n                { VikingAgent.VikingType.HatchetBoss, \\"img_prompt_EnemyStrike_04\\" },\\n                { VikingAgent.VikingType.ArcheryBoss, \\"img_prompt_EnemyStrike_06\\" },\\n                { VikingAgent.VikingType.ShamanBoss, \\"img_prompt_EnemyStrike_09\\" }\\n            };\\n\\n        protected Rect ScreenRect\\n        {\\n            get\\n            {\\n                if (_screenRect.width <= 0)\\n                {\\n                    _screenRect = new Rect(_gapOffset, _gapOffset, Screen.width - _gapOffset * 2,\\n                        Screen.height - _gapOffset * 2);\\n                }\\n\\n                return _screenRect;\\n            }\\n        }\\n\\n        private void OnWaveStart(bool isLanding, Longship ship)\\n        {\\n            if (isLanding)\\n            {\\n                if (ship == null)\\n                    return;\\n\\n                TowerDefenseIndicator tmpObj = null;\\n                string spriteName = string.Empty;\\n                _indicatorTypeDict.TryGetValue(ship.VikingType, out spriteName);\\n\\n                VikingAgent.VikingType vikiType = ship.VikingType;\\n\\n                if (vikiType >= VikingAgent.VikingType.BigBoss && vikiType < VikingAgent.VikingType.Elite)\\n                {\\n                    tmpObj = bossArrow_TowerDefenseIndicator;\\n                }\\n                else if (vikiType >= VikingAgent.VikingType.Elite)\\n                {\\n                    tmpObj = eliteArrow_TowerDefenseIndicator;\\n                }\\n                else\\n                {\\n                    tmpObj = monsterArrow_TowerDefenseIndicator;\\n                }\\n\\n                tmpObj = Instantiate(tmpObj, transform);\\n                if (!string.IsNullOrEmpty(spriteName))\\n                    tmpObj.IndicatorSprite.spriteName = spriteName;\\n\\n                if (!_indicatorCache.ContainsKey(ship))\\n                    _indicatorCache.Add(ship, tmpObj.transform);\\n            }\\n            else\\n            {\\n                HideIndicator(ship);\\n            }\\n        }\\n\\n        private void OnWaveCleared(int waveOrder)\\n        {\\n            if (_tutorialDriver)\\n            {\\n                //if (Island.Instance.LevelId == 1 && waveOrder == 1)\\n                if (waveOrder == 1)\\n                {\\n                    EventManager.Instance.PushEvent(EventDef.STEP_COMMON_TRIGGER,\\n                        $\\"{EventDef.TD_FIRST_TARGET_DONE_COMMON_TRIGGER}|{Island.GamePlayTD.LevelInfo.Id}\\");\\n                }\\n            }\\n        }\\n\\n        private void HideIndicator(Longship ship)\\n        {\\n            Transform trans = null;\\n            if (_indicatorCache.TryGetValue(ship, out trans) && trans.gameObject.activeSelf)\\n            {\\n                Utils.SetActive(trans.gameObject, false);\\n            }\\n        }\\n\\n        private void RemoveIndicator()\\n        {\\n            foreach (var kv in _indicatorCache)\\n            {\\n                Destroy(kv.Value.gameObject);\\n            }\\n\\n            _indicatorCache.Clear();\\n        }\\n\\n        private void UpdateIndicator()\\n        {\\n            foreach (var kv in _indicatorCache)\\n            {\\n                if (!kv.Key.HasAnyVikings)\\n                    HideIndicator(kv.Key);\\n\\n                // 更新 indicator状态\\n                StartCoroutine(UpdateIndicator(kv.Key, kv.Value));\\n            }\\n        }\\n\\n        private IEnumerator UpdateIndicator(Longship ship, Transform indicator)\\n        {\\n            yield return null;\\n\\n            Vector3 start = ship.StartPos;\\n            Vector3 end = ship.EndPos;\\n            Vector3 cur = ship.transform.position;\\n            Camera cameraRef = MonoSingleton<LevelCamera>.Instance.CameraRef;\\n\\n            start = cameraRef.WorldToScreenPoint(start).GetZeroZ();\\n            end = cameraRef.WorldToScreenPoint(end).GetZeroZ();\\n            cur = cameraRef.WorldToScreenPoint(cur).GetZeroZ();\\n\\n            Vector2 result = Vector2.zero;\\n            if (ExtraMath.LineRectIntersection(start, end, ScreenRect, ref result))\\n            {\\n                // 是否在屏幕内\\n                bool isInScreen = ScreenRect.Contains(cur);\\n                if (indicator.gameObject.activeSelf && isInScreen)\\n                {\\n                    Observable.Timer(TimeSpan.FromSeconds(1.0f)).Subscribe(_ =>\\n                    {\\n                        TowerDefenseAudioDispatcher.PlayCombatSound(\\"whitewalkers_howl\\", \\"\\");\\n                    }).AddTo(this);\\n                }\\n\\n                Utils.SetActive(indicator.gameObject, !isInScreen);\\n\\n                if (!isInScreen)\\n                {\\n                    // indicator位置设置为交点位置\\n                    result = UIManager.inst.ui2DCamera.ScreenToWorldPoint(\\n                        new Vector3(result.x, result.y, -cameraRef.transform.position.z));\\n                    indicator.position = result;\\n\\n                    Vector3 dir = start - end;\\n                    float radians = Mathf.Atan2(dir.y, dir.x);\\n                    // 弧度转换为角度\\n                    float angle = radians * Mathf.Rad2Deg;\\n                    indicator.rotation = Quaternion.Euler(0f, 0f, angle);\\n                }\\n            }\\n            else\\n            {\\n                Utils.SetActive(indicator.gameObject, false);\\n            }\\n        }\\n\\n        #endregion\\n\\n        #region TutorialPart\\n\\n        private string _targetKey;\\n        private int _targetParam;\\n        private int _target2FinishedNum;\\n\\n        private void UpdateTargetLabel(int num = 0)\\n        {\\n            _target2FinishedNum = num;\\n            if (_target2FinishedNum >= _targetParam)\\n            {\\n                EventManager.Instance.PushEvent(EventDef.STEP_COMMON_TRIGGER,\\n                    $\\"{EventDef.TD_SECOND_TARGET_DONE_COMMON_TRIGGER}|{Island.GamePlayTD.LevelInfo.Id}\\");\\n\\n                if (_escapeAnim)\\n                {\\n                    _escapeAnim.Stop();\\n                }\\n            }\\n        }\\n\\n        public void OnAnimCallback(AnimationEvent e)\\n        {\\n            UpdateTargetLabel(_target2FinishedNum + 1);\\n        }\\n\\n        #endregion\\n\\n        #region BtnEvent\\n\\n        private void ShowBattleUI()\\n        {\\n            if (_curState == battlePart)\\n                return;\\n\\n            InitBattleUI(Island.GamePlayTD.LevelInfo);\\n\\n            _curState = battlePart;\\n            _needShowLink = false;\\n\\n            InitButtons();\\n            Utils.SetActive(battlePart, true);\\n        }\\n\\n        //\\n        private void OnQuitBtnClick()\\n        {\\n            var parameter = new MessageBoxWith2Buttons.Parameter();\\n            parameter.title = Utils.XLAT(\\"lead_in_2021_td_exit_battle_title\\");\\n            parameter.content = Utils.XLAT(\\"lead_in_2021_td_exit_battle_1\\") +\\n                                Utils.XLAT(\\"lead_in_2021_td_exit_battle_2\\");\\n            parameter.yes = Utils.XLAT(\\"id_uppercase_confirm\\");\\n            parameter.no = Utils.XLAT(\\"id_uppercase_cancel\\");\\n\\n            parameter.yesCallback = () =>\\n            {\\n                //OnCloseButtonPress();\\n                UIManager.inst.CloseTopPopup();\\n                TowerDefenceMgr.Instance.QuitManner = TowerDefenceMgr.QuitLevelType.Manual;\\n                Island.Instance.SetGameResultOver(false, true);\\n            };\\n\\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.MessageBoxTowerDefense, parameter);\\n        }\\n\\n        #endregion\\n\\n        #region HeroSkill\\n\\n        public void RealInitHeroSkill()\\n        {\\n            //全局技能\\n            if (Island.Instance.GetIslandComponent<SquadSpawner>().IslandEnSquad != null)\\n            {\\n                //只处理一个技能\\n                var activeAbilitySquad = Island.Instance.GetIslandComponent<SquadSpawner>().IslandEnSquad.abilitySquad;\\n                if (activeAbilitySquad.Abilities.Count > 0)\\n                {\\n                    var ability = activeAbilitySquad.Abilities[0];\\n                    if (ability != null)\\n                    {\\n                        _islandCastBtn.SetData(ability);\\n                        _islandCastBtn.ForceHide = Island.GamePlayTD.LevelInfo.Skillhide1 != 0;\\n                        Utils.SetActive(_islandCastBtn.gameObject, !_islandCastBtn.ForceHide);\\n                    }\\n                }\\n            }\\n            else\\n            {\\n                _islandCastBtn.ForceHide = Island.GamePlayTD.LevelInfo.Skillhide1 != 0;\\n                Utils.SetActive(_islandCastBtn.gameObject, false);\\n            }\\n\\n            var levelInfo = Island.GamePlayTD.LevelInfo;\\n            _heroSkillItemMap.Clear();\\n            if (levelInfo != null)\\n            {\\n                foreach (var itor in Squad.All)\\n                {\\n                    if (itor is EnglishSquad enSquad)\\n                    {\\n                        if (enSquad.HeroDef != null && !string.IsNullOrEmpty(enSquad.HeroDef.HeroId))\\n                        {\\n                            heroIds.Add(enSquad.HeroDef.HeroId);\\n                            enSquad.OnSquadSpawnComplete += () => { CreateHeroSkillItem(enSquad, true); };\\n                        }\\n                    }\\n                }\\n\\n                _heroSkillGrid.repositionNow = true;\\n                _heroSkillGrid.Reposition();\\n            }\\n\\n            GetHeroData();\\n        }\\n\\n        private List<string> heroIds = new List<string>();\\n        private List<long> heroFettes = new List<long>();\\n        private int fetterCount = 0;\\n        private int heroFetterCount = 1;\\n\\n        private void GetHeroData()\\n        {\\n            foreach (var heroId in heroIds)//tower_defense_hero_22\\n            {\\n                var towerHeroData = !string.IsNullOrEmpty(heroId)\\n                    ? ConfigManager2.Instance.DB_TowerDefenseHeros.GetById(heroId)\\n                    : null;\\n                var heroInfo = towerHeroData != null\\n                    ? ConfigManager.inst.DB_ParliamentHero.Get(towerHeroData.RealHeroId)\\n                    : null;\\n                if (heroInfo != null)\\n                {\\n                    heroFettes.Add(heroInfo.HeroColour);\\n                }\\n                else\\n                {\\n                    if (towerHeroData != null)\\n                    {\\n                        heroFettes.Add(towerHeroData.ResonanceNum);\\n                    }\\n                }\\n            }\\n            heroFettes.Sort((x,y)=>x.CompareTo(y));\\n            \\n            for (int i = 0; i < heroFettes.Count - 1; i++)\\n            {\\n                if (heroFettes[i] == heroFettes[i + 1])\\n                {\\n                    heroFetterCount++;\\n                }\\n            }\\n\\n            var fettersInfo = HeroExploreManager.Instance.CalculateTdHeroResonance(heroFettes.ToArray());\\n            if (fettersInfo != null&& fettersInfo.Count>0)\\n            {\\n                InitFatterView(fettersInfo);\\n            }\\n            else\\n            {\\n                Utils.SetActive(battleFetterContent,false);\\n            }\\n        }\\n\\n        private void InitFatterView(List<TowerDefenseResonanceInfo> infos)\\n        {\\n            string fetterIcon=\\"\\";\\n            if (infos.Count > 1)\\n            {\\n                fetterSlotShow2_TowerBattleFetterTips.SetData(infos[1]);\\n                fetterSlotTips2_TowerBattleFetterTips.SetData(infos[1]);\\n                HeroFetterListPopup.HeroFetterListPopup.HeroFetterListPopup.IsAvailableFetterSpriteName((ParliamentHeroInfo.ENUM_RESONACE_TYPE)infos[1].Type, out fetterIcon);\\n                iconFetter2_UISprite.spriteName = fetterIcon;\\n                Utils.SetActive(doubleBattleFetter,true);\\n                fettleCount_UILabel.text = \\"2\\";\\n                heroFetterCount = 2;\\n            }\\n            if (infos.Count > 0)\\n            {\\n                fetterSlotShow_TowerBattleFetterTips.SetData(infos[0], heroFetterCount);\\n                fetterSlotTips_TowerBattleFetterTips.SetData(infos[0], heroFetterCount);\\n                HeroFetterListPopup.HeroFetterListPopup.HeroFetterListPopup.IsAvailableFetterSpriteName((ParliamentHeroInfo.ENUM_RESONACE_TYPE)infos[0].Type, out fetterIcon);\\n                iconFetter_UISprite.spriteName = fetterIcon;\\n                fettleCount_UILabel.text = heroFetterCount.ToString();\\n            }\\n\\n          \\n\\n            fetterCount = infos.Count;\\n            if (TowerDefenceMgr.Instance.CurGameMode == TowerDefenceMgr.GameMode.EndLess)\\n                return;\\n\\n            ShowFetterView();\\n        }\\n\\n        private void ShowFetterView()\\n        {\\n            if (fetterCount <= 0) return;\\n            Observable.Timer(TimeSpan.FromSeconds(4f)).Subscribe((_) =>\\n            {\\n                Utils.SetActive(buffShowFetter, true);\\n                if (fetterCount > 1)\\n                    Utils.SetActive(fetterSlotShow2, true);\\n                HideFetter();\\n            }).AddTo(this);\\n        }\\n\\n        private void HideFetter()\\n        {\\n            Observable.Timer(TimeSpan.FromSeconds(1.2f)).Subscribe((_) =>\\n            {\\n                Utils.SetActive(fetterSlotShow2, false);\\n                Utils.SetActive(buffShowFetter, false);\\n               // icon_FX_trail.transform.position = buffShowFetter.transform.position;\\n                Utils.SetActive(icon_FX_trail, true);\\n                icon_FX_trail.transform.DOMove(battleFetter.transform.position, 0.66f);\\n                battleFetterContent_UIBuildingButton.GetComponent<BoxCollider>().enabled = true;\\n            }).AddTo(this);\\n        }\\n\\n        private void OnClickFatterTips()\\n        {\\n            if (fetterCount > 1)\\n                Utils.SetActive(tipsFetter2, !tipsFetter2.activeSelf);\\n            Utils.SetActive(tipsFetter, !tipsFetter.activeSelf);\\n        }\\n        \\n        private void CreateHeroSkillItem(EnglishSquad enSquad, bool reposition = false)\\n        {\\n            GameObject go = GameObject.Instantiate(_heroSkillItemTemplate.gameObject, _heroSkillGrid.transform);\\n            go.name = enSquad.HeroDef.HeroId;\\n            go.transform.parent = _heroSkillGrid.transform;\\n            go.transform.localScale = Vector3.one;\\n            go.transform.localPosition = Vector3.zero;\\n\\n            TDHeroSkillItem item = go.GetComponent<TDHeroSkillItem>();\\n            item.SetHeroData(enSquad, this);\\n            go.SetActive(true);\\n            _heroSkillItemMap.Add(enSquad.HeroDef, item);\\n\\n            if (reposition)\\n            {\\n                _heroSkillGrid.repositionNow = true;\\n                _heroSkillGrid.Reposition();\\n            }\\n        }\\n\\n        private void RemoveHeroSkillItem(HeroDefinition hero, bool reposition = true)\\n        {\\n            if (_heroSkillItemMap != null && _heroSkillItemMap.ContainsKey(hero))\\n            {\\n                var item = _heroSkillItemMap[hero];\\n                Destroy(item.gameObject);\\n                _heroSkillItemMap.Remove(hero);\\n\\n                if (reposition)\\n                {\\n                    _heroSkillGrid.repositionNow = true;\\n                    _heroSkillGrid.Reposition();\\n                }\\n            }\\n        }\\n\\n        private void OnRemoveSquadItem(TDRemoveSquad evt)\\n        {\\n            if (_heroSkillItemMap != null)\\n            {\\n                HeroDefinition heroInfo = null;\\n                string heroId = evt.heroId;\\n                foreach (var itor in _heroSkillItemMap)\\n                {\\n                    if (itor.Key.HeroId == heroId)\\n                    {\\n                        heroInfo = itor.Key;\\n                        break;\\n                    }\\n                }\\n\\n                if (heroInfo != null && _heroSkillItemMap.ContainsKey(heroInfo))\\n                {\\n                    RemoveHeroSkillItem(heroInfo);\\n                }\\n            }\\n        }\\n\\n        private void ShowHeroSkillItem(boo\\n# ... 文件过大，已截断\\n```\\n\\n## 检查 Skill\\n\\n### Game\\\\.agents\\\\skills\\\\unity-code-review\\\\SKILL.md\\n\\n````markdown\\n---\\nname: unity-code-review\\ndescription: Reviews Unity C# code against Unity\'s official style guide. Supports local git diff and GitHub PR review.\\nargument-hint: [file | diff | PR_URL]\\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\\n---\\n\\n# Unity Code Review Skill\\n\\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\\n\\n## Trigger Conditions\\n\\nThis skill activates when:\\n\\n- User invokes `/unity-code-review` with a file or diff.\\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\\n\\n## Review Modes\\n\\n### Local Git Diff Review\\n\\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\\n\\n### GitHub PR Review\\n\\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\\n\\n## Unity C# Style Guide Core Rules\\n\\n### Naming Conventions\\n\\n| Type | Rule | Example |\\n| --- | --- | --- |\\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\\n| Local Variables | camelCase | `playerPosition`, `damage` |\\n\\nAvoid:\\n\\n- Single letter names except loop counters.\\n- Hungarian notation.\\n- Vague names such as `data`, `temp`, or `manager`.\\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\\n\\n### Single Responsibility\\n\\n- Each MonoBehaviour should have one clear engine-facing responsibility.\\n- Keep gameplay logic testable outside Unity where practical.\\n- Avoid boolean flag parameters when separate methods communicate intent better.\\n- Keep methods small enough to review and test.\\n\\n### Comments\\n\\n- Comments should explain why, not what.\\n- Public APIs may use XML documentation.\\n- Do not leave commented-out code or stale TODOs.\\n\\n## Unity-Specific Review Focus\\n\\n### MonoBehaviour Lifecycle\\n\\n- Use `Awake` for local initialization and component caching.\\n- Use `Start` only for initialization that depends on other objects being ready.\\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\\n\\n### Coroutine and Async Patterns\\n\\n- Store coroutine references when cancellation is needed.\\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\\n- Stop async work when the owning object is disabled or destroyed.\\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\\n\\n### Unity API Misuse\\n\\n| Issue | Correct Approach |\\n| --- | --- |\\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\\n| `tag == \\"Enemy\\"` | use `CompareTag()` |\\n| allocating physics queries | use non-alloc APIs where appropriate |\\n| frequent `Instantiate` / `Destroy` | use object pooling |\\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\\n\\n### Performance Concerns\\n\\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\\n- Avoid LINQ and string concatenation in hot paths.\\n- Cache repeated lookups and temporary collections where appropriate.\\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\\n\\n### Testing\\n\\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\\n- Use Unity Test Framework for engine-dependent behavior.\\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\\n\\n## Review Workflow\\n\\n1. Run `git diff` or inspect the specified file / PR diff.\\n2. Read full changed files and nearby related files for context.\\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\\n4. Lead with correctness, runtime risk, and missing validation.\\n5. Keep findings actionable and cite exact files.\\n\\n## Review Output Format\\n\\n```markdown\\n## Code Review: [scope]\\n\\n### Findings\\n\\n1. **Issue title** (`path/to/file.cs`)\\n   - What is wrong.\\n   - Why it matters.\\n   - Suggested fix.\\n\\n### Open Questions\\n\\n- Any assumptions or unclear ownership.\\n\\n### Test Gaps\\n\\n- Validation that is missing or could not be run.\\n```\\n\\n## Related Agents\\n\\n- unity-reviewer\\n\\n## Related Commands\\n\\n- unity-review\\n\\n## Common Code Smells\\n\\n| Code Smell | Description | Fix |\\n| --- | --- | --- |\\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\\n| Inflexibility | Small change requires many changes | Check SRP violations |\\n| Fragility | Minor change breaks everything | Review dependencies |\\n| Immobility | Code not reusable elsewhere | Decouple logic |\\n| Duplicate code | Copy-pasted logic | Extract core functionality |\\n| Excessive commentary | Comments for every line | Use better names, trust the code |\\n\\n````"}]',)
