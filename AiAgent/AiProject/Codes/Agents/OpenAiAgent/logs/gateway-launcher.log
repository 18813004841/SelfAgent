 DB;\nusing UniRx;\nusing UnityEngine;\nusing XTutorial;\n\nnamespace UI.QuickSearch\n{\n    public partial class QuickSearchNewView : MonoBehaviour\n    {\n        [SerializeField] private GameObject _searchArea;\n        [SerializeField] private UISlider _uiSlider;\n        [SerializeField] private UIComponentList _componentList;\n        [SerializeField] private UICenterOnChild _centerOnChild;\n        [SerializeField] private UILabel _currentLabel;\n        [SerializeField] private UILabel _destribute;\n        [SerializeField] private UILabel _dialog;\n        [SerializeField] private GameObject _troggle;\n        [SerializeField] private GameObject _sliderRoot;\n        \n        public Action OnClosePannel;\n        public Action OnUpdateArea;\n\n        private List<WorldSearchGroupInfo> _infos;\n        private WorldSearchGroupInfo _curSearchInfo;\n        private int _currentSelectItemIndex = -1;\n        private long _histroySliderValue = -1;\n        private long _historySelectIndex = -1;\n        private long _gotoSliderValue = -1;\n      \n\n        private long _minSliderValue = 0;\n        private long _curSilderValue = -1;\n        private long _maxSliderValue = long.MaxValue;\n        private Color _descriptionTextColor;\n        private TileData _result = null;\n        \n        private Dictionary<SearchState, string> _getKeyByState = new Dictionary<SearchState, string>{\n            {SearchState.DontSearchMonster,\"map_search_no_monster\"},                            //附近未找到这种怪兽\n            {SearchState.EnterCD          ,\"map_search_nearby_no_monster\"},                     //领主大人，附近暂时没有这种怪兽，请稍后再试\n            {SearchState.NearNoResource   ,\"map_search_nearby_no_resource\"}};                   //领地周围未找到这种资源田\n\n        private void Awake()\n        {\n            _descriptionTextColor = _destribute.color;\n        }\n\n        public int CurrentSelectItemIndex\n        {\n            get { return _currentSelectItemIndex; }\n            set\n            {\n                if (_currentSelectItemIndex == value)\n                    return;\n\n                _currentSelectItemIndex = value;\n\n                _curSearchInfo = _infos[_currentSelectItemIndex];\n                _historySelectIndex = _currentSelectItemIndex;\n                if (_gotoSliderValue > 0)\n                {\n                    _histroySliderValue = _gotoSliderValue;\n                    _gotoSliderValue = -1;\n                }\n                else\n                {\n                    _histroySliderValue = SearchItemManger.Instance.GetHistorySelectItemByIdx(_currentSelectItemIndex);\n                }\n\n                if (_searchArea != null)\n                    LinkerHub.Instance.DisposeHint(_searchArea.transform);\n                \n                UpdateSlider(true);\n                UpdateSeachArea();\n\n                if (OnUpdateArea != null)\n                    OnUpdateArea.Invoke();\n            }\n        }\n\n        public void Initialize(List<WorldSearchGroupInfo> infos, int historySelectIndex, long historySliderValue, long gotoSliderValue)\n        {\n            if (infos == null || infos.Count == 0)\n                return;\n\n            historySelectIndex = Mathf.Clamp(historySelectIndex, 0, infos.Count - 1);\n            \n            _infos = infos;\n            _componentList.Initialize(SetData);\n            _componentList.SetData(infos.Count, true);\n            \n            _historySelectIndex = historySelectIndex;\n            _histroySliderValue = historySliderValue;\n            _gotoSliderValue = gotoSliderValue;\n\n            _curSilderValue = _histroySliderValue;\n\n            CenterOnChild(historySelectIndex);\n\n            SearchItemManger.Instance.OnDataHasPraper += OnSearchDataComplete;\n        }\n\n        private void SetData(int index, GameObject obj)\n        {\n            SearchResouceItem item = obj.GetComponent<SearchResouceItem>();\n\n            if (item == null)\n                return;\n\n            WorldSearchGroupInfo groupInfo = _infos[index];\n            long unLockLevel = groupInfo.Unlock;\n            bool isLock = SearchItemManger.Instance.IsLock(groupInfo.Type);\n            if ((TileType)groupInfo.Type == TileType.AllianceSuperMine)\n            {\n                isLock = true;\n                bool haveFortress = DBManager.inst.DB_AllianceBuilding.GetMyFirstOrDefaultFortress() != null;\n                if (haveFortress)\n                {\n                    var cor = AllianceZoneManager.Instance.GetAnyResourceLocation(out var tmpLock);\n                    if (!tmpLock && cor != Coordinate.zero)\n                    {\n                        isLock = false;\n                    }\n                }\n            }\n            item.SetData(groupInfo, index, isLock, unLockLevel, CenterOnChild);\n        }\n\n        private void UpdateSliderAfter()\n        {\n            if (_curSearchInfo == null) return;\n\n            var curGameMode = GameEngine.Instance.CurrentGameMode;\n            var curMonsterLv = PlayerData.inst.userData.monster_level;\n\n            if (curGameMode == GameEngine.GameMode.FantasyMode)\n                curMonsterLv = PlayerData.inst.userData.FantasyMonsterLevel;\n\n            //小怪\n            bool isMonster = IsMonster(_curSearchInfo.Type);\n            if (isMonster)\n            {\n                long maxLevel =\n                    ConfigManager.inst.DB_ConfigWorldSearchGroup.GetSearchResourceLevelByOpenDay(_curSearchInfo.Type,\n                        int.MaxValue, curGameMode);\n                long levelLimit =\n                    ConfigManager.inst.DB_ConfigWorldSearchGroup.GetSearchResourceLevelLimit(_curSearchInfo.Type,\n                        curGameMode);\n                long level = (int) Mathf.Clamp(curMonsterLv + 1, 1, maxLevel);\n                if (curMonsterLv >= _maxSliderValue)\n                {\n                    if (curMonsterLv < levelLimit)\n                    {\n                        _dialog.text = Utils.XLAT(\"map_monster_search_locked_level_shown\", 0, level);\n                    }\n                    else\n                    {\n                        if (curGameMode == GameEngine.GameMode.NisaSeasonMode)\n                        {\n                            _dialog.text = Utils.XLAT(\"map_search_highest_can_kill\", 0, level);\n                        }\n                        else\n                        {\n                            _dialog.text = Utils.XLAT(\"map_search_highest_can_kill\", 0, levelLimit);\n                        }\n                    }\n                }\n                else if (curMonsterLv < _maxSliderValue)\n                {\n                    _dialog.text = Utils.XLAT(\"map_search_highest_can_kill\", 0, level);\n                }\n            }\n\n            _destribute.color = _descriptionTextColor;\n\n            //gve营地\n            if(_curSearchInfo.Type == (long)TileType.GveCamp)\n            {\n                if (ActivityManager.Instance.killDevilActivityData.IsOpen())\n                {\n                    _destribute.text = Utils.XLAT(\"devil_king_camp_description\");\n                }\n                else if (curGameMode == GameEngine.GameMode.FantasyMode)\n                {\n                    var gveBoss =\n                        ConfigManager.inst.DB_GveBoss.GetByType(ConfigGveBoss.GveBossType.Fantasy, _curSilderValue);\n                    var fantasyUser = DBManager.Instance.DB_FantasyUser.Get(PlayerData.inst.uid);\n\n                    int dreamDef = gveBoss != null ? gveBoss.DreamDef : 0;\n                    long antiMagic = fantasyUser != null ? fantasyUser.AntiMagic : 0;\n\n                    // 攻打石头傀儡、傀儡营地时，幻术抗性+n\n                    if (AstrolabeTalentManager.Instance.IsIncreaseAntiMagicAttackPVEMonsterOrGVEMonster())\n                    {\n                        if (AstrolabeTalentManager.Instance.GetIncreaseAntiMagicAttackPVEMonsterOrGVEMonster