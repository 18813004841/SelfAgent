State;\\n\\n                if (stateChange)\\n                {\\n                    _curCompleteTarget[0] = newTarget1CompleteState;\\n                    _curCompleteTarget[1] = newTarget2CompleteState;\\n                    _curCompleteTarget[2] = newTarget3CompleteState;\\n                }\\n\\n                return stateChange;\\n            }\\n        }\\n\\n        [SerializeField] private TDIslandCastButton _islandCastBtn;\\n        [SerializeField] private UIGrid _heroSkillGrid;\\n        [SerializeField] private TDHeroSkillItem _heroSkillItemTemplate;\\n\\n        private ExtraFuncBtn _autoAIBtn;\\n        private ExtraFuncBtn _timeX2Btn;\\n        private ExtraFuncBtn _autoSkillBtn;\\n        private ExtraFuncBtn _autoMoveBtn;\\n        private bool _openX2SingleLock;\\n        private bool _isAutoMove;\\n        private bool _isNodeLock;\\n        \\n        private HeroSkillPower _curHeroSkillPower;\\n\\n        private Dictionary<HeroDefinition, TDHeroSkillItem> _heroSkillItemMap =\\n            new Dictionary<HeroDefinition, TDHeroSkillItem>();\\n\\n        private Animation _escapeAnim;\\n        private bool _needShowLink;\\n\\n        private GameObject _curState;\\n        private bool _tutorialDriver;\\n\\n        private int _curWaveOrder;\\n        private int _timeArriveLeft;\\n        private bool _hasShownBoss;\\n        private string _talkSound;\\n        private bool _isFirstLevel;\\n        private TDTipsTalk _TDHeightTalk = null;\\n        private TDTipsTalk _TDLastTalk = null;\\n        private float _TDTalkHeightOffset = 0;\\n        private float _lastTDTalkHeight;\\n        private int _talkIndex;\\n        private SquadSpawner _squadSpawner;\\n        private TimeManager _timeManager;\\n        private GameTargetState _gameTargetState = new GameTargetState();\\n\\n        private readonly Dictionary<int, string> _waveLangKeyDict = new Dictionary<int, string>\\n        {\\n            { 1, \\"lead_in_2021_td_wave_notice_1\\" },