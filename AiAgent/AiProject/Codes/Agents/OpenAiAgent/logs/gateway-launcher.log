efreshCell -= OnTabItemRefresh;\\n            bagGrid_UICustomContainer.OnRefreshCell -= OnRefreshBag;\\n\\n            HeroArtifactManager.Instance.OnResponseEquipArtifact -= OnResponseEquipArtifact;\\n            HeroArtifactManager.Instance.OnResponseDecomposeArtifact -= OnResponseDecomposeArtifact;\\n            HeroArtifactManager.Instance.OnResponseEnhanceArtifactTarget -= OnResponseEnhanceArtifact;\\n            DisposeBulkArtifactEnhance();\\n            \\n        }\\n\\n        private void InitHeroArtifaceDatas()\\n        {\\n            if (_bankDataVoList == null)\\n            {\\n                _bankDataVoList = HeroArtifactManager.Instance.GetAllDatas();\\n            }\\n            \\n        }\\n\\n        /// <summary>\\n        /// 装备神器返回\\n        /// </summary>\\n        /// <param name=\\"legendCardData\\"></param>\\n        /// <param name=\\"heroArtifactInfo\\"></param>\\n        private void OnResponseEquipArtifact(LegendCardData legendCardData, ParliamentHeroArtifactInfo preArtifactInfo, ParliamentHeroArtifactInfo heroArtifactInfo, EquipmentLordDataVO.HandleState handleState)\\n        {\\n\\n            if(_selectDataVo!=null)\\n                _selectInternalId = _selectDataVo.HeroArtifactInfo.InternalId;\\n            \\n            if (_heroArtifactType != HeroArtifactType.None)\\n            {\\n                UpdateUI();//刷新神器显示\\n            }\\n            if (_heroArtifactType == HeroArtifactType.All || _heroArtifactType == HeroArtifactType.None)\\n            {\\n                UpdateMaterial();//刷新卷轴显示\\n            }\\n        }\\n        \\n        //拆卸返回\\n        private void OnResponseDecomposeArtifact(ParliamentHeroArtifactInfo heroArtifactInfo)\\n        {\\n            if (_heroArtifactType != HeroArtifactType.None)\\n            {\\n                UpdateUI();//刷新神器显示\\n            }\\n            if (_heroArtifactType == HeroArtifactType.All || _heroArtifactType == HeroArtifactType.None)\\n            {\\n                UpdateMaterial();//刷新卷轴显示\\n            }\\n\\n        }\\n\\n        /// <summary>\\n        /// 强化返回，按实际目标恢复选择，支持一次强化多个等级。\\n        /// </summary>\\n        /// <param name=\\"arg1\\"></param>\\n        /// <param name=\\"arg2\\"></param>\\n        private void OnResponseEnhanceArtifact(LegendCardData legendCardData, ParliamentHeroArtifactInfo heroArtifactInfo, ParliamentHeroArtifactInfo targetInfo)\\n        {\\n            if (_heroArtifactType != HeroArtifactType.None)\\n            {\\n                //被强化的神器\\n                if (_selectDataVo != null)\\n                {\\n                    _equipedEnhance = _selectDataVo.IsEquiped;\\n                    _selectInternalId = targetInfo != null ? targetInfo.InternalId : heroArtifactInfo.NextId; //强化成功后选中实际目标神器，兼容单级强化。\\n                }\\n                _selectDataVo = null;\\n                \\n                UpdateUI();//刷新神器显示\\n            }\\n            if (_heroArtifactType == HeroArtifactType.All || _heroArtifactType == HeroArtifactType.None)\\n            {\\n                UpdateMaterial();//刷新卷轴显示\\n            }\\n        }\\n\\n        private void OnRefreshBag(int cellindex, GameObject cell, object userdata)\\n        {\\n            var item = cell.GetComponent<HeroArtifactItem>();\\n            if (userdata is HeroArtifactDataVO)\\n            {\\n                var data = userdata as HeroArtifactDataVO;\\n                if (item != null)\\n                {\\n                    string redPointKey = string.Format(RedPointDefinition.HeroArtifact_Bank + \\".{0}.{1}\\",_tabSelectedIdx,cellindex);\\n                    item.SetData(cellindex,data,OnClickBagArtifact, redPointKey);\\n                    item.SetBulkEnhanceMode(_isBulkArtifactMode);\\n                    item.SetChoose(_isBulkArtifactMode ? -1 : _bagSelectedIdx);\\n                    ConfigureBulkArtifactToggle(item, data);\\n                }\\n            }\\n            else if(userdata is ItemlistInfo)\\n            {\\n                var itemInfo = userdata as ItemlistInfo;\\n                var count = ItemBag.Instance.GetItemCount(itemInfo.InternalId);\\n                item.SetData(cellindex,itemInfo,count,onClickItem:OnClickBagItem);\\n                item.SetBulkEnhanceMode(_isBulkArtifactMode);\\n                item.SetChoose(_isBulkArtifactMode ? -1 : _bagSelectedIdx);\\n                if (item.bulkEnhanceToggle != null) item.bulkEnhanceToggle.SetData(null, false, false);\\n            }\\n            \\n     \\n        }\\n\\n        private void OnClickBagItem(int index,ItemlistInfo itemInfo)\\n        {\\n            SetSelected(itemInfo,index);\\n        }\\n\\n        private void OnClickBagArtifact(int index, HeroArtifactDataVO dataVO)\\n        {\\n            if (_isBulkArtifactMode) return;\\n            _selectDataVo = dataVO;\\n            SetSelected(_selectDataVo,index);\\n        }\\n        private void OnTabItemRefresh(int index, GameObject go,object userData)\\n        {\\n            if (go == null || groups == null) return;\\n            var tab = go.GetComponent<HeroArtifactGroupTab>();\\n            var data = (HeroArtifactType) userData;\\n            if (tab != null)\\n            {\\n                bool isShowRedPoint = false;\\n                //产品说神器库的左边页签不需要加红点了\\n               /* if (data != HeroArtifactType.All)\\n                {\\n                    var dataVos = _bankDataVoList.FindAll(x => x.HeroArtifactInfo.ArtifactType == data);\\n                    var tmpDatas = dataVos.FindAll(ele => ele.RedPoint); //第一进界面刷新红点使用\\n                    isShowRedPoint = tmpDatas.Count > 0;\\n                }*/\\n                string redPointKey = string.Format(RedPointDefinition.HeroArtifact_Bank + \\".{0}\\",index);\\n                tab.SetData(data, redPointKey, isShowRedPoint);\\n                tabObjList.Add(tab.comonObj);\\n                tabObjList.Add(tab.selectObj);\\n                _tabs.Add(tab);\\n            }\\n            \\n        }\\n        private void OnTabHandle(int index)\\n        {\\n            if (BlockBulkArtifactTab(index)) return;\\n            \\n            if (null != _tabs && _tabs.Count > index)\\n            {\\n                Clear();\\n                \\n                _tabSelectedIdx = index;\\n                HeroArtifactGroupTab groupTab = _tabs[index];\\n                HeroArtifactType type = groupTab.GroupType;\\n                \\n                _heroArtifactType = type;\\n                \\n                NGUITools.SetActive(heroArtifactItemInfo_HeroArtifactItemInfo.gameObject, false);\\n                NGUITools.SetActive(heroArtifactIllustratedInfo_HeroArtifactScrollInfo.gameObject,false);\\n\\n                if (_heroArtifactType != HeroArtifactType.None)\\n                {\\n                    UpdateUI();//刷新神器显示\\n                }\\n                if (_heroArtifactType == HeroArtifactType.All || _heroArtifactType == HeroArtifactType.None)\\n                {\\n                    UpdateMaterial();//刷新卷轴显示\\n                }\\n                \\n            }\\n        }\\n        \\n        /// <summary>\\n        /// 点击装备、移除、替换\\n        /// </summary>\\n        public void OnClickEquipRemoveReplaceBtn()\\n        {\\n            //穿戴神器\\n            if (_selectDataVo == null) return;\\n            HeroArtifactManager.Instance.SendRequestEquipArtifact(_selectDataVo.HeroArtifactInfo, _selectDataVo.CanHandleState);\\n        }\\n        private void OnClickEnhance()\\n        {\\n            if (_selectDataVo == null) return;\\n            if (_selectDataVo.IsEnhancedToMax)\\n            {\\n                UIManager.inst.toast.Show(Utils.XLAT(\\"toast_hero_weapon_level_max\\"));//装备已达最高级\\n                return;\\n            }\\n\\n            HeroArtifactManager.Instance.OpenNewEnhancePopup(_selectDataVo);\\n         \\n        }\\n\\n        private void OnClickDismantle()\\n        {\\n            //打开熔炼界面\\n            if (_selectDataVo == null) return;\\n\\n            if (_selectDataVo.IsEquiped)\\n            {\\n                UIManager.inst.toast.Show(Utils.XLAT(\\"toast_hero_weapon_equipped_cannot_forge\\"));\\n                return;\\n            }\\n            \\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.HeroArtifactDismantlePopup,\\n                new HeroArtifactDismantlePopup.HeroArtifactDismantlePopup.HeroArtifactDismantlePopup.OpenParameter{\\n                    dataVO = _selectDataVo\\n                });\\n        }\\n\\n        private void Clear()\\n        {\\n            _selectInternalId = 0;\\n            _selectDataVo = null;\\n            _equipedEnhance = false;\\n        }\\n        public void SetData(HeroArtifactDataVO heroArtifactDataVo_GOTO = null)\\n        {\\n            if (heroArtifactDataVo_GOTO != null &&  heroArtifactDataVo_GOTO.HeroArtifactInfo != null)\\n            {\\n                _heroArtifactType = HeroArtifactType.All;\\n            }\\n            _heroArtifactDataVo_GOTO = heroArtifactDataVo_GOTO;\\n            //初始化页签\\n            InitGroupTap();\\n            //_heroArtifactType = HeroArtifactType.All;\\n            int bagViewTabIndex = GetBagTabIndexByType(_heroArtifactType) ;\\n            tabs_UIButtonBar.SelectedIndex = bagViewTabIndex;\\n            /*\\n            if (tabs_UIButtonBar.SelectedIndex != bagViewTabIndex)\\n            {\\n                tabs_UIButtonBar.SelectedIndex = bagViewTabIndex;\\n            }\\n            else\\n            {\\n                OnTabHandle(bagViewTabIndex);\\n            }\\n            */\\n\\n        }\\n        \\n        //初始化页签\\n        private void InitGroupTap()\\n        {\\n            tabObjList = new List<GameObject>();\\n            _tabs = new List<HeroArtifactGroupTab>();\\n            groups = new List<HeroArtifactType> {HeroArtifactType.All};\\n            //全部\\n            _parliamentInfoList = ConfigManager2.Instance.DB_Parliament.GetParliamentInfoList();\\n            if (_parliamentInfoList != null)\\n            {\\n                int count = _parliamentInfoList.Count;\\n                for (int i = 0; i < count; i++)\\n                {\\n                    int type = 0;\\n                    int.TryParse(_parliamentInfoList[i].Id, out type);\\n                    groups.Add((HeroArtifactType)type);\\n                }\\n                groups.Add(HeroArtifactType.None);//用这个表示神器材料页签\\n            }\\n            \\n            tabGrid_UICustomContainer.ClearAll();\\n            for (int i = 0; i < groups.Count; i++)\\n            {\\n                tabGrid_UICustomContainer.AddCell(0,groups[i]);\\n            }\\n            tabGrid_UICustomContainer.UpdateImmediately();\\n            \\n            //设置tabbutton\\n            tabs_UIButtonBar.buttons = tabObjList.ToArray();\\n        }\\n\\n\\n\\n        private void UpdateMaterial()\\n        {\\n            if (_isBulkArtifactMode) return;\\n            materialList = ItemBag.Instance.GetItemsInfoByType(ItemBag.ItemType.parliament_hero_artifact_learn_material);//材料列表\\n            materialList.Sort((a, b) => b.Priority.CompareTo(a.Priority));\\n            //全部清理掉 只添加材料数据\\n            if (HeroArtifactType.None == _heroArtifactType) //材料页签\\n            {\\n                NGUITools.SetActive(noArtifact, materialList.Count <= 0);//没有材料\\n                NGUITools.SetActive(bag_ScrollView, materialList.Count > 0);//有材料\\n\\n      \\n\\n                \\n                _itemsList = new List<UICustomContainer.CellData>();\\n                bagGrid_UICustomContainer.ClearAll();\\n                for (int i = 0; i < materialList.Count; i++)\\n                {\\n                    _itemsList.Add(bagGrid_UICustomContainer.AddCell(0, materialList[i]));\\n                }\\n                bagGrid_UICustomContainer.UpdateImmediately();\\n                \\n                //有材料就选中第一个\\n                if(materialList.Count > 0 && !_isBulkArtifactMode)\\n                    SetSelected(materialList[0]);\\n            }\\n            else if (HeroArtifactType.All == _heroArtifactType) //全部页签  在神器后面 ，添加上材料的数据\\n            {\\n                NGUITools.SetActive(noArtifact, curTypeDataVoList.Count <= 0 && materialList.Count <= 0);//没有神器和材料\\n                NGUITools.SetActive(bag_ScrollView, curTypeDataVoList.Count > 0 || materialList.Count > 0);//有神器或者材料\\n                \\n                for (int i = 0; i < materialList.Count; i++)\\n                {\\n                    _itemsList.Add(bagGrid_UICustomContainer.AddCell(0, materialList[i]));\\n                }\\n                bagGrid_UICustomContainer.UpdateImmediately();\\n\\n                //全部页签下 如果没有神器只有材料，默认选中第一个材料\\n                if (curTypeDataVoList.Count <= 0)\\n                {\\n                    //有材料就选中第一个\\n                    if(materialList.Count > 0 && !_isBulkArtifactMode)\\n                        SetSelected(materialList[0]);\\n                }\\n            }\\n\\n        }\\n        \\n        private void UpdateUI()\\n        {\\n            _dataVoList = HeroArtifactManager.Instance.GetAllHeroArtifactData();//玩家所有神器数据\\n            \\n            if (HeroArtifactType.All != _heroArtifactType)\\n            {\\n                curTypeDataVoList = _dataVoList.FindAll(x => x.HeroArtifactInfo.ArtifactType == _heroArtifactType);\\n            }\\n            else\\n            {\\n                curTypeDataVoList = _dataVoList;\\n            }\\n            NGUITools.SetActive(noArtifact, curTypeDataVoList.Count <= 0);//没有神器\\n            NGUITools.SetActive(bag_ScrollView, curTypeDataVoList.Count > 0);//有神器\\n            \\n            _itemsList = new List<UICustomContainer.CellData>();\\n            bagGrid_UICustomContainer.ClearAll();\\n            foreach (var t in curTypeDataVoList)\\n            {\\n                _itemsList.Add(bagGrid_UICustomContainer.AddCell(0, t));\\n            }\\n            bagGrid_UICustomContainer.UpdateImmediately();\\n            bag_ScrollView_UIScrollView.ResetPosition();\\n\\n            if (_isBulkArtifactMode)\\n            {\\n                NGUITools.SetActive(heroArtifactItemInfo_HeroArtifactItemInfo.gameObject, false);\\n                NGUITools.SetActive(heroArtifactIllustratedInfo_HeroArtifactScrollInfo.gameObject, false);\\n                return;\\n            }\\n            \\n            if (curTypeDataVoList.Count > 0)\\n            {\\n                if (!IsSelectDataVo_GOTO())\\n                {\\n                    if (0 != _selectInternalId)\\n                    {\\n                        for (int i= 0; i < curTypeDataVoList.Count; i++)\\n                        {\\n                            if (_equipedEnhance)\\n                            {\\n                                if (curTypeDataVoList[i].HeroArtifactInfo.InternalId == _selectInternalId && curTypeDataVoList[i].IsEquiped)\\n                                {\\n                                    _selectDataVo = curTypeDataVoList[i];\\n                                    _bagSelectedIdx = i;\\n                                    break;\\n                                }\\n                            }\\n                            else\\n                            {\\n                                if (curTypeDataVoList[i].HeroArtifactInfo.InternalId == _selectInternalId)\\n                                {\\n                                    _selectDataVo = curTypeDataVoList[i];\\n                                    _bagSelectedIdx = i;\\n                                    break;\\n                                }\\n                            }\\n                        }\\n                    }\\n                    else\\n                    {\\n                        _selectDataVo = curTypeDataVoList[0];\\n                        _bagSelectedIdx = 0;\\n                    }\\n                }\\n                SetSelected(_selectDataVo, _bagSelectedIdx);\\n            }\\n            else\\n            {\\n                NGUITools.SetActive(heroArtifactItemInfo_HeroArtifactItemInfo.gameObject, false);\\n                NGUITools.SetActive(heroArtifactIllustratedInfo_HeroArtifactScrollInfo.gameObject,false);\\n            }\\n            \\n        }\\n\\n        private bool IsSelectDataVo_GOTO()\\n        {\\n            if(_heroArtifactDataVo_GOTO == null || _heroArtifactDataVo_GOTO.HeroArtifactInfo == null) return  false;\\n            int count = curTypeDataVoList.Count;\\n            int cellIndex = 0;\\n            for (int i = 0; i < count; i++)\\n            {\\n                var dataVo = curTypeDataVoList[i];\\n                if(dataVo == null && dataVo.HeroArtifactInfo == null) continue;\\n                if (dataVo.HeroArtifactInfo.InternalId == _heroArtifactDataVo_GOTO.HeroArtifactInfo.InternalId)\\n                {\\n                    if (_heroArtifactDataVo_GOTO.IsEquiped)\\n                    {\\n                        if (dataVo.IsEquiped)\\n                        {\\n                            cellIndex = i;\\n                            _selectDataVo = dataVo;\\n                            break;\\n                        }\\n                    }\\n                    else\\n                    {\\n                        cellIndex = i;\\n                        _selectDataVo = dataVo;\\n                        break;\\n                    }\\n                }\\n            }\\n\\n            bagGrid_UICustomContainer.FocusOnChild(bag_ScrollView_UIScrollView, cellIndex, 0, 463, 100, true);\\n            _bagSelectedIdx = cellIndex;\\n           // bagGrid_UICustomContainer.UpdateImmediately();\\n            _heroArtifactDataVo_GOTO = null;//跳转逻辑走完之后，清理goto对象，避免对后续逻辑造成影响\\n            return true;\\n        }\\n        //选中卷轴材料\\n        public void SetSelected(ItemlistInfo itemlistInfo,int selectedIdx = 0)\\n        {\\n            NGUITools.SetActive(heroArtifactItemInfo_HeroArtifactItemInfo.gameObject, false);\\n            NGUITools.SetActive(heroArtifactIllustratedInfo_HeroArtifactScrollInfo.gameObject,itemlistInfo != null);\\n            if (null == itemlistInfo)\\n            {\\n                return;\\n            }\\n            _bagSelectedIdx = selectedIdx;\\n            heroArtifactIllustratedInfo_HeroArtifactScrollInfo.SetData(itemlistInfo.InternalId);\\n            int count = _itemsList.Count;\\n            for (int i = 0; i < count; i++)\\n            {\\n                var cell = _itemsList[i];\\n                if (cell.CellInstance != null)\\n                {\\n                    var item = cell.CellInstance.GetComponent<HeroArtifactItem>();\\n                    item.SetChoose(selectedIdx);\\n                }\\n            }\\n        }\\n        \\n        \\n        //选中神器\\n        public void SetSelected(HeroArtifactDataVO selectDataVO, int selectedIdx = 0)\\n        {\\n            NGUITools.SetActive(heroArtifactItemInfo_HeroArtifactItemInfo.gameObject, null != selectDataVO);\\n            NGUITools.SetActive(heroArtifactIllustratedInfo_HeroArtifactScrollInfo.gameObject,false);\\n            if (null == selectDataVO)\\n            {\\n                return;\\n            }\\n            _bagSelectedIdx = selectedIdx;\\n            string redPointKey = string.Format(RedPointDefinition.HeroArtifact_Bank + \\".{0}.{1}\\",_tabSelectedIdx,_bagSelectedIdx);\\n            heroArtifactItemInfo_HeroArtifactItemInfo.SetData(selectDataVO, redPointKey);\\n            int count = _itemsList.Count;\\n            for (int i = 0; i < count; i++)\\n            {\\n                var cell = _itemsList[i];\\n                if (cell.CellInstance != null)\\n                {\\n                    var item = cell.CellInstance.GetComponent<HeroArtifactItem>();\\n                    item.SetChoose(selectedIdx);\\n                }\\n            }\\n        }\\n        private int GetBagTabIndexByType(HeroArtifactType heroArfifactType)\\n        {\\n            int index = 0;\\n            if (HeroArtifactType.All != heroArfifactType)\\n            {\\n                int type = (int)heroArfifactType;\\n                ParliamentInfo info = _parliamentInfoList.Find(x => x.Id == type.ToString());\\n                if (null != info)\\n                {\\n                    index = (int)info.Priority;\\n                }\\n                else\\n                {\\n                    index = 9;//材料\\n                }\\n            }\\n            return index;\\n        }\\n\\n\\n    }\\n}\\n\\n```\\n\\n## 检查 Skill\\n\\n### Game\\\\.agents\\\\skills\\\\unity-code-review\\\\SKILL.md\\n\\n````markdown\\n---\\nname: unity-code-review\\ndescription: Reviews Unity C# code against Unity\'s official style guide. Supports local git diff and GitHub PR review.\\nargument-hint: [file | diff | PR_URL]\\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\\n---\\n\\n# Unity Code Review Skill\\n\\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\\n\\n## Trigger Conditions\\n\\nThis skill activates when:\\n\\n- User invokes `/unity-code-review` with a file or diff.\\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\\n\\n## Review Modes\\n\\n### Local Git Diff Review\\n\\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\\n\\n### GitHub PR Review\\n\\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\\n\\n## Unity C# Style Guide Core Rules\\n\\n### Naming Conventions\\n\\n| Type | Rule | Example |\\n| --- | --- | --- |\\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\\n| Local Variables | camelCase | `playerPosition`, `damage` |\\n\\nAvoid:\\n\\n- Single letter names except loop counters.\\n- Hungarian notation.\\n- Vague names such as `data`, `temp`, or `manager`.\\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\\n\\n### Single Responsibility\\n\\n- Each MonoBehaviour should have one clear engine-facing responsibility.\\n- Keep gameplay logic testable outside Unity where practical.\\n- Avoid boolean flag parameters when separate methods communicate intent better.\\n- Keep methods small enough to review and test.\\n\\n### Comments\\n\\n- Comments should explain why, not what.\\n- Public APIs may use XML documentation.\\n- Do not leave commented-out code or stale TODOs.\\n\\n## Unity-Specific Review Focus\\n\\n### MonoBehaviour Lifecycle\\n\\n- Use `Awake` for local initialization and component caching.\\n- Use `Start` only for initialization that depends on other objects being ready.\\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\\n\\n### Coroutine and Async Patterns\\n\\n- Store coroutine references when cancellation is needed.\\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\\n- Stop async work when the owning object is disabled or destroyed.\\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\\n\\n### Unity API Misuse\\n\\n| Issue | Correct Approach |\\n| --- | --- |\\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\\n| `tag == \\"Enemy\\"` | use `CompareTag()` |\\n| allocating physics queries | use non-alloc APIs where appropriate |\\n| frequent `Instantiate` / `Destroy` | use object pooling |\\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\\n\\n### Performance Concerns\\n\\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\\n- Avoid LINQ and string concatenation in hot paths.\\n- Cache repeated lookups and temporary collections where appropriate.\\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\\n\\n### Testing\\n\\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\\n- Use Unity Test Framework for engine-dependent behavior.\\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\\n\\n## Review Workflow\\n\\n1. Run `git diff` or inspect the specified file / PR diff.\\n2. Read full changed files and nearby related files for context.\\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\\n4. Lead with correctness, runtime risk, and missing validation.\\n5. Keep findings actionable and cite exact files.\\n\\n## Review Output Format\\n\\n```markdown\\n## Code Review: [scope]\\n\\n### Findings\\n\\n1. **Issue title** (`path/to/file.cs`)\\n   - What is wrong.\\n   - Why it matters.\\n   - Suggested fix.\\n\\n### Open Questions\\n\\n- Any assumptions or unclear ownership.\\n\\n### Test Gaps\\n\\n- Validation that is missing or could not be run.\\n```\\n\\n## Related Agents\\n\\n- unity-reviewer\\n\\n## Related Commands\\n\\n- unity-review\\n\\n## Common Code Smells\\n\\n| Code Smell | Description | Fix |\\n| --- | --- | --- |\\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\\n| Inflexibility | Small change requires many changes | Check SRP violations |\\n| Fragility | Minor change breaks everything | Review dependencies |\\n| Immobility | Code not reusable elsewhere | Decouple logic |\\n| Duplicate code | Copy-pasted logic | Extract core functionality |\\n| Excessive commentary | Comments for every line | Use better names, trust the code |\\n\\n````"}]',)
