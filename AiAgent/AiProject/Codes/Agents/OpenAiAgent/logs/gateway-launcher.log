counter != null ? worldEncounter.DreamDef : 0;\n                    long antiMagic = fantasyUser != null ? fantasyUser.AntiMagic : 0;\n\n                    // 攻打石头傀儡、傀儡营地时，幻术抗性+n\n                    if (AstrolabeTalentManager.Instance.IsIncreaseAntiMagicAttackPVEMonsterOrGVEMonster())\n                    {\n                        if (AstrolabeTalentManager.Instance.GetIncreaseAntiMagicAttackPVEMonsterOrGVEMonsterValue(out long n))\n                        {\n                            antiMagic += n;\n                        }\n                    }\n\n                    _destribute.text = Utils.XLAT(FantasyWorldManager.Instance.GetKeyByMapType(\"fantasy_world_monster_spell_defense_recommend\"),\n                        \"0\", dreamDef,\n                        \"1\", antiMagic);\n                    _destribute.color = antiMagic >= dreamDef ? Color.green : Color.red;\n                }\n                else\n                {\n                    _destribute.text = Utils.XLAT(_curSearchInfo.DialongText);\n                }\n            }\n            else\n            {\n                _destribute.text = Utils.XLAT(_curSearchInfo.DialongText);\n            }\n        }\n\n        public void UpdateSlider(bool updateData)\n        {\n            if (_curSearchInfo == null)\n                return;\n\n            _dialog.text = \"\";\n            if ((TileType)_curSearchInfo.Type == TileType.AllianceSuperMine)\n            {\n                _destribute.text = Utils.XLAT(_curSearchInfo.DialongText);\n                _minSliderValue = _maxSliderValue = 1;\n                _uiSlider.value = 1;\n                _currentLabel.text = $\"Lv{_maxSliderValue.ToString()}\";\n                return;\n            }\n\n            if (updateData)\n            {\n                var curGameMode = GameEngine.Instance.CurrentGameMode;\n                var curMonsterLv = PlayerData.inst.userData.monster_level;\n                \n                if (curGameMode == GameEngine.GameMode.FantasyMode)\n                    curMonsterLv = PlayerData.inst.userData.FantasyMonsterLevel;\n\n                _minSliderValue = ConfigManager.inst.DB_ConfigWorldSearchMain.GetMinSearchLevel(_curSearchInfo.Type);\n                _maxSliderValue = SearchItemManger.Instance.GetSearchResourceMaxLevel(_curSearchInfo.Type, curGameMode);\n\n                bool isMonster = IsMonster(_curSearchInfo.Type);\n                \n                if (_histroySliderValue != 0)\n                {\n                    _curSilderValue = _histroySliderValue;\n                }\n                else\n                {\n                    if (isMonster)\n                    {\n                        _curSilderValue = curMonsterLv;\n                    }\n                    else if(_curSearchInfo.Type == (long)TileType.GveCamp)\n                    {\n                        _curSilderValue = _minSliderValue;\n                    }\n                    else\n                    {\n                        _curSilderValue = _maxSliderValue;\n                    }\n                }\n                \n                Utils.SetActive(_dialog.gameObject, isMonster);\n            }\n\n            _uiSlider.value = Mathf.Clamp(_curSilderValue / (_maxSliderValue * 1.0f), 0, 1.0f);\n            \n            _histroySliderValue = _curSilderValue;\n            \n            SearchItemManger.Instance.SetHistorySelectItemByIdxAndValue(CurrentSelectItemIndex,_curSilderValue);\n\n            _currentLabel.text = $\"Lv{_curSilderValue.ToString()}\";\n\n            Vector3 pos = _uiSlider.thumb.position;\n            Vector3 currentPos = _currentLabel.transform.position;\n            _currentLabel.transform.position = new Vector3(pos.x, currentPos.y, currentPos.z);\n\n            UpdateSliderAfter();\n        }\n\n        public void UnSelectChild()\n        {\n            for (int i = 0; i < _infos.Count; i++)\n            {\n                SearchResouceItem child = _componentList.GetChild(i).GetComponent<SearchResouceItem>();\n                child.OnSetHighLightState(false);\n            }\n        }\n\n        public void CenterOnChild(int index)\n        {\n            UnSelectChild();\n            GameObject obj = _componentList.GetChild(index);\n\n            if (obj == null)\n                return;\n            \n            SearchResouceItem item = obj.GetComponent<SearchResouceItem>();\n            item.OnSetHighLightState(true);\n\n            var info = _infos[index];\n            Utils.SetActive(_sliderRoot,true);\n            if ((TileType)info.Type == TileType.TILE_GENERAL_TRIALS_USER)\n            {\n                Utils.SetActive(_sliderRoot,false);\n            }\n            \n            CurrentSelectItemIndex = index;\n        }\n        \n        \n        public void OnStartSearch()\n        {\n            if (!SearchItemManger.Instance.IsDataComplete)\n                return;\n\n            if (NewGroupManager.Instance.IsNewServer && (TileType)_curSearchInfo.Type == TileType.AllianceSuperMine)\n            {\n                var cor = AllianceZoneManager.Instance.GetAnyResourceLocation(out var isLocked);\n                if (cor != Coordinate.zero)\n                {\n                    AllianceZoneManager.Instance.GotoSpecificDstLoc(cor);\n                }\n                return;    \n            }\n\n            if ((TileType)_curSearchInfo.Type == TileType.TILE_GENERAL_TRIALS_USER)\n            {\n                // 还有怪没打完，找最小等级的跳过去\n                if (HasValidGeneralTrialMonsterAndGoto())\n                    return;\n                \n                bool isValid = false;\n                var curGameMode = GameEngine.Instance.CurrentGameMode;\n                if ((curGameMode == GameEngine.GameMode.PVPMode || curGameMode == GameEngine.GameMode.FantasyMode) &&\n                    PlayerData.inst.IsInMyWorld || PlayerData.inst.IsInFantasyWorld)\n                {\n                    isValid = true;\n                }\n\n                if (!isValid)\n                {\n                    // 回到原王国地图后才能进行操作\n                    UIManager.inst.toast.Show(Utils.XLAT(\"toast_general_trial_return_original_kingdom\"));\n                    return;\n                }\n\n                var sendParam = Utils.Hash(\"allianceBossId\", 0);\n                RequestManager.Instance.SendRequestAsObservable(PortType.GENERAL_TRIAL_START_CHALLENGE, sendParam)\n                    .Subscribe(o =>\n                    {\n                        HasValidGeneralTrialMonsterAndGoto();\n                        OnClosePannel?.Invoke();\n                    }).AddTo(this);\n                \n                return;\n            }\n            \n            SearchMainData mainData =\n                ConfigManager.inst.DB_ConfigWorldSearchMain.GetSearchData(_curSearchInfo.Type, _curSilderValue);\n\n            if (mainData == null)\n                return;\n\n            SearchItemManger.Instance.PrepareTileData(PlayerData.inst.CityData.Location, _curSearchInfo.Type,\n                _curSilderValue, mainData.SearchTileNum, mainData.CanCreate);\n\n            OperationTrace.TraceClick(ClickArea.QuickSearchNewButtonClick);\n        }\n\n        private bool HasValidGeneralTrialMonsterAndGoto()\n        {\n            var monsterData = DBManager.Instance.DB_GeneralTrialBossDB.GetMinLevelMonsterData();\n            if (monsterData != null)\n            {\n                Vector3 pos, scale;\n                Vector3 pixelPosition = PVPMapData.MapData.ConvertTileKXYToPixelPosition(monsterData.Location);\n                \n                pos = new Vector3(\n                    pixelPosition.x,\n                    pixelPosition.y,\n                    pixelPosition.z - 150\n                );\n                scale = Vector3.one;\n                \n            \n                var map = PVPSystem.Instance.Map;\n                if (map != null)\n                {\n                    PVPSystem.Instance.Map.GotoLocation(monsterData.Location, false);\n                    map.ShowHighlight(pos, scale);\n                    Utils.StartCoroutine(map, map.AutoOpenMapMonsterPanel(monsterData.Location, TileType.TILE_GENERAL_TRIALS_USER));\n                }\n                \n                OnClosePannel?.Invoke();\n                return true;\n            }\n\n            return false;\n        }\n\n        public void OnSearchDataComplete(SearchState state)\n        {\n            if (state == SearchState.SearchSuccess)\n            {\n                SearchTileData result = SearchItemManger.Instance.GetJumpCoordinate();\n\n                if (result == null)\n                    return;\n\n                if (null != PVPSystem.Instance.Map)//firebase容错\n                {\n                PVPSystem.Instance.Map.GotoLocation(result.Location, false);   //  镜头跳转\n                OnGotoLocationOver(result);                                                   //  地块变白\n                StartTutorial(result);                                                        //  检测引导\n                }\n\n                if (OnClosePannel != null)\n                    OnClosePannel();\n            }\n            else\n            {\n                UI.UIManager.inst.toast.Show(Utils.XLAT(_getKeyByState[state]));\n            }\n        }\n\n        public void StartTutorial(SearchTileData data)\n        {\n            /* if (data == null)\n                yield break;\n            \n            StepBase curStep = XTutorialMgr.Instance.GetCurrentTochStep();\n            if (curStep == null)\n                yield break;\n            \n            //等待正在进行的引导变为是pvpmapsearchsource类型\n            yield return curStep.Data.baseData.type.Equals(\"pvpmapsearchresource\");*/\n            \n            if(data == null || XTutorialMgr.Instance.GetCurrentTouchStep() == null)\n                return;\n\n            {//发送新手引导事件\n                Vector3 worldPos = PVPSystem.Instance.Map.MapData.ConvertTileKXYToWorldPosition(data.Location);\n\n                Event_PvpMapSearchResource entStep = new Event_PvpMapSearchResource(\n                    \"Encounter\",\n                    data.ResourceLevel.ToString(),\n                    worldPos);\n\n                XTutorialMgr.Instance.PushEvent(EventDef.CIRCLE_PVP_MAP_SEARCH_RESOURCE, entStep);\n            }\n        }\n\n        public void OnSliderValueChange()\n        {\n            if (_curSearchInfo == null)\n                return;\n\n            if (_curSilderValue != _uiSlider.value * _maxSliderValue - 0.02f)\n            {\n                _curSilderValue = Mathf.RoundToInt(_uiSlider.value * _maxSliderValue);\n                _curSilderValue = CheckSliderStep();\n\n                UpdateSlider(false);\n                \n                \n            }\n        }\n\n        public void OnSliderSubstractBtnClick()\n        {\n            int step = GetGveCampStep(_curSearchInfo.Type);\n\n            _curSilderValue -= step;\n            long count = (long)Mathf.Max(_curSilderValue, _minSliderValue);\n\n            _curSilderValue = count;\n            UpdateSlider(false);\n        }\n\n        public void OnSliderPlusBtnClick()\n        {\n            int step = GetGveCampStep(_curSearchInfo.Type);\n\n            _curSilderValue += step;\n            long count = (long)Math.Min(_curSilderValue, _maxSliderValue);\n\n            _curSilderValue = count;\n            UpdateSlider(false);\n        }\n\n        public long CheckSliderStep()\n        {\n            int step = GetGveCampStep(_curSearchInfo.Type);\n            int count = Mathf.RoundToInt(_curSilderValue / step);\n            return (long)Mathf.Clamp(count * step, _minSliderValue, _maxSliderValue);\n        }\n\n        public void UpdateSeachArea()\n        {\n            GameObject go = _componentList.GetChild(_currentSelectItemIndex);\n            if (go == null)\n                return;\n\n            Vector3 pos = _searchArea.transform.position;\n            pos.x = go.transform.position.x;\n            _searchArea.transform.position = pos;\n\n            Utils.SetActive(_searchArea, true);\n            Utils.SetActive(_troggle.gameObject, false);\n        }\n\n        public void Dispose()\n        {\n            _result = null;\n            SearchItemManger.Instance.HistroySelectItem = _currentSelectItemIndex;\n            SearchItemManger.Instance.HistorySliderValue = _curSilderValue;\n            SearchItemManger.Instance.SetHistorySelectItemByIdxAndValue(_currentSelectItemIndex,_curSilderValue);\n            SearchItemManger.Instance.OnDataHasPraper -= OnSearchDataComplete;\n        }\n\n        public void CloseSearchArea()\n        {\n            Utils.SetActive(_searchArea, false);\n        }\n\n        public void OnGotoLocationOver(SearchTileData result)\n        {\n            if (result == null)\n            {\n                D.Error(\"result数据出现错误\");\n                return;\n            }\n\n            Vector3 pos, scale;\n            Vector3 pixelPosition = PVPMapData.MapData.ConvertTileKXYToPixelPosition(result.Location);\n            if (result.Type == (long)TileType.GveCamp)\n            {\n                pos = new Vector3(\n                    pixelPosition.x,\n                    pixelPosition.y - PVPMapData.MapData.PixelsPerTile.y * 0.5f,\n                    pixelPosition.z - 150\n                );\n                scale = new Vector3(2.0f, 2.0f, 1.0f);\n            }\n            else\n            {\n                pos = new Vector3(\n                    pixelPosition.x,\n                    pixelPosition.y,\n                    pixelPosition.z - 150\n                );\n                scale = Vector3.one;\n            }\n            \n            var map = PVPSystem.Instance.Map;\n            if (map == null)\n                return;\n            \n            map.ShowHighlight(pos, scale);\n            Utils.StartCoroutine(map, map.AutoOpenMapMonsterPanel(result.Location, (TileType)result.Type));\n        }\n\n        public bool IsMonster(long type)\n        {\n            return (type == (long)TileType.Encounter);\n        }\n\n        public int GetGveCampStep(long type)\n        {\n            if (type == (long)TileType.GveCamp)      //野蛮人营地步长为3\n                return 3;\n            return 1;\n        }\n    }\n}\n```\n\n## 检查 Skill\n\n### Game\\.agents\\skills\\unity-code-review\\SKILL.md\n\n````markdown\n---\nname: unity-code-review\ndescription: Reviews Unity C# code against Unity's official style guide. Supports local git diff and GitHub PR review.\nargument-hint: [file | diff | PR_URL]\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\n---\n\n# Unity Code Review Skill\n\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\n\n## Trigger Conditions\n\nThis skill activates when:\n\n- User invokes `/unity-code-review` with a file or diff.\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\n\n## Review Modes\n\n### Local Git Diff Review\n\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\n\n### GitHub PR Review\n\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\n\n## Unity C# Style Guide Core Rules\n\n### Naming Conventions\n\n| Type | Rule | Example |\n| --- | --- | --- |\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\n| Local Variables | camelCase | `playerPosition`, `damage` |\n\nAvoid:\n\n- Single letter names except loop counters.\n- Hungarian notation.\n- Vague names such as `data`, `temp`, or `manager`.\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\n\n### Single Responsibility\n\n- Each MonoBehaviour should have one clear engine-facing responsibility.\n- Keep gameplay logic testable outside Unity where practical.\n- Avoid boolean flag parameters when separate methods communicate intent better.\n- Keep methods small enough to review and test.\n\n### Comments\n\n- Comments should explain why, not what.\n- Public APIs may use XML documentation.\n- Do not leave commented-out code or stale TODOs.\n\n## Unity-Specific Review Focus\n\n### MonoBehaviour Lifecycle\n\n- Use `Awake` for local initialization and component caching.\n- Use `Start` only for initialization that depends on other objects being ready.\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\n\n### Coroutine and Async Patterns\n\n- Store coroutine references when cancellation is needed.\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\n- Stop async work when the owning object is disabled or destroyed.\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\n\n### Unity API Misuse\n\n| Issue | Correct Approach |\n| --- | --- |\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\n| `tag == \"Enemy\"` | use `CompareTag()` |\n| allocating physics queries | use non-alloc APIs where appropriate |\n| frequent `Instantiate` / `Destroy` | use object pooling |\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\n\n### Performance Concerns\n\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\n- Avoid LINQ and string concatenation in hot paths.\n- Cache repeated lookups and temporary collections where appropriate.\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\n\n### Testing\n\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\n- Use Unity Test Framework for engine-dependent behavior.\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\n\n## Review Workflow\n\n1. Run `git diff` or inspect the specified file / PR diff.\n2. Read full changed files and nearby related files for context.\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\n4. Lead with correctness, runtime risk, and missing validation.\n5. Keep findings actionable and cite exact files.\n\n## Review Output Format\n\n```markdown\n## Code Review: [scope]\n\n### Findings\n\n1. **Issue title** (`path/to/file.cs`)\n   - What is wrong.\n   - Why it matters.\n   - Suggested fix.\n\n### Open Questions\n\n- Any assumptions or unclear ownership.\n\n### Test Gaps\n\n- Validation that is missing or could not be run.\n```\n\n## Related Agents\n\n- unity-reviewer\n\n## Related Commands\n\n- unity-review\n\n## Common Code Smells\n\n| Code Smell | Description | Fix |\n| --- | --- | --- |\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\n| Inflexibility | Small change requires many changes | Check SRP violations |\n| Fragility | Minor change breaks everything | Review dependencies |\n| Immobility | Code not reusable elsewhere | Decouple logic |\n| Duplicate code | Copy-pasted logic | Extract core functionality |\n| Excessive commentary | Comments for every line | Use better names, trust the code |\n\n````"}], "stream": true, "store": false, "reasoning": {"effort": "low"}}
