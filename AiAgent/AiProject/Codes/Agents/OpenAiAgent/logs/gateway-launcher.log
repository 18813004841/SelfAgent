\n    private Coordinate _targetLocation;\\n    private TileData _tileData;\\n    private GameObject monster;\\n    private PVEMonsterPreview preview;\\n    private bool _open;\\n\\n    private string _monsterSound = \\"\\";\\n\\n    private bool _showTime;\\n\\n    private SpecialMonsterType _specialMonsterType = SpecialMonsterType.None;\\n    \\n    #region Dialog Interface\\n\\n    public class Parameter : DialogParameter\\n    {\\n        public Coordinate coordinate;\\n        public bool showTime = false;\\n        public SpecialMonsterType SpecialMonsterType = SpecialMonsterType.None;\\n    }\\n\\n    public override void OnOpen(UIParameter orgParam = null)\\n    {\\n        base.OnOpen(orgParam);\\n        \\n        var monthCardData = DBManager.Instance.DB_IapCenter.NewPrivilegeMonthCardData;\\n        if (null != monthCardData)\\n            monthCardData.onDataChanged += UpdateExpeditionBtnStatus;\\n        \\n        if (_expeditionBtn)\\n        {\\n            _expeditionBtn.OnClickAsObservable().Subscribe(_ =>\\n            {\\n                if (UIManager.inst != null && UIManager.inst.publicHUD != null)\\n                    UIManager.inst.publicHUD.OnClickAutoAttackMonster();\\n            }).AddTo(this);\\n        }\\n        if(_monsterRewardRate)\\n            _monsterRewardRate.SetData();\\n    }\\n\\n    public override void OnClose(UIParameter orgParam = null)\\n    {\\n        base.OnClose(orgParam);\\n        \\n        var monthCardData = DBManager.Instance.DB_IapCenter.NewPrivilegeMonthCardData;\\n        if (null != monthCardData)\\n            monthCardData.onDataChanged -= UpdateExpeditionBtnStatus;\\n    }\\n\\n    public override void OnShow(UIParameter orgParam = null)\\n    {\\n        base.OnShow(orgParam);\\n\\n        Parameter param = orgParam as Parameter;\\n        if (orgParam != null)\\n        {\\n            _targetLocation = param.coordinate;\\n            _showTime = param.showTime;\\n            _tileData = PVPMapData.MapData.GetReferenceAt(_targetLocation);\\n            _specialMonsterType = param.SpecialMonsterType;\\n        }\\n\\n        if (_specialMonsterType == SpecialMonsterType.GamblingBoss)\\n        {\\n            CheckGamblingBoss();\\n        }\\n        else\\n        {\\n            CheckDevil();\\n        }\\n        \\n        mustContainer.OnRefreshCell -= OnRefreshCell;\\n        rateContainer.OnRefreshCell -= OnRefreshCell;\\n        \\n        \\n        mustContainer.OnRefreshCell += OnRefreshCell;\\n        rateContainer.OnRefreshCell += OnRefreshCell;\\n\\n        if (_firstKillContainer != null)\\n        {\\n            _firstKillContainer.OnRefreshCell -= OnRefreshFirstKillCell;\\n            _firstKillContainer.OnRefreshCell += OnRefreshFirstKillCell;\\n        }\\n\\n        if (_firstKillReward != null)\\n            Utils.SetActive(_firstKillReward, false);\\n        \\n        zBlockerCommon.SetActive(false);\\n        monster = GameObject.Instantiate(previewPrefab.gameObject) as GameObject;\\n        NGUITools.SetActive(monster, true);\\n        preview = monster.GetComponent<PVEMonsterPreview>();\\n        NGUITools.SetLayer(monster, LayerMask.NameToLayer(\\"UI3D\\"));\\n\\n        SetBgUI();\\n\\n        if (itemPrefab != null)\\n            itemPrefab.gameObject.SetActive(false);\\n        \\n        Utils.SetActive(_myPowerLabel.gameObject,false);\\n        Utils.SetActive(s9RadarLabel.gameObject,false);\\n        foreach (var label in _resultPredicts)\\n        {\\n            Utils.SetActive(label.gameObject,false);\\n        }\\n\\n        RegisterBtnEvent();\\n        SetRewardTitletxtInfo(Utils.XLAT(CAConstContainer.NormalRewardTitle1), Utils.XLAT(CAConstContainer.NormalRewardTitle2));\\n        if (!_showTime)\\n            UpdateUI();\\n        else\\n            UpdateUIBoss();\\n\\n        preview.InitializeCharacter(_tileData, PlayStretch);\\n        \\n        UpdateExpeditionBtnStatus();\\n        UpdateFirstKill();\\n    }\\n\\n    public override void OnHide(UIParameter orgParam = null)\\n    {\\n        base.OnHide(orgParam);\\n        RemoveEventHandler();\\n        UnRegisterBtnEvent();\\n        Clear();\\n        _battleForecast?.Dispose();\\n        _battleForecast = null;\\n    }\\n\\n    #endregion\\n\\n    private MonsterAnimEvent _animEvent;\\n    private Animator _animator; //有的模型没有AnimEvent组件, 用这种方式播动画, 模型规范todo\\n    \\n    private bool HasActiveMonthCard => NewPrivilegeMonthCardManager.Instance.IsActivePrivilege ||\\n                                       DBManager.Instance.DB_IapCenter.NewMonthCardData.CheckHaveBigCardInfo();\\n\\n    private bool IsMonthCardAutoAttackAvailable => NewPrivilegeMonthCardManager.Instance.IsOpenAutoAttackActivity ||\\n                                                   IAPCenterManager.Instance.IsOpenNewMonthCard;\\n\\n    private void OnDestroy()\\n    {\\n        if (null == DBManager.Instance.DB_IapCenter)\\n            return;\\n            \\n        var monthCardData = DBManager.Instance.DB_IapCenter.NewPrivilegeMonthCardData;\\n        if (null != monthCardData)\\n            monthCardData.onDataChanged -= UpdateExpeditionBtnStatus;\\n    }\\n\\n    private void UpdateExpeditionBtnStatus()\\n    {\\n        Utils.SetActive(_expeditionBtn, showExpeditionBtn);\\n        Utils.SetActive(_expeditionLockTips, !HasActiveMonthCard);\\n\\n        if (null == attackBtn)\\n            return;\\n        \\n        if (!showExpeditionBtn)\\n        {\\n            if (attackBtn.gameObject.activeSelf)\\n            {\\n                attackBtn.transform.localPosition = Vector3.right * 490 + Vector3.down * 572;\\n            }\\n        }\\n        else\\n        {\\n            attackBtn.transform.localPosition = Vector3.right * 757 + Vector3.down * 572;\\n        }\\n    }\\n\\n    public void PlayStretch(GameObject go)\\n    {\\n        MonsterAnimEvent animEvent = go.transform.GetComponentInChildren<MonsterAnimEvent>();\\n        if (animEvent != null)\\n        {\\n            _animEvent = animEvent;\\n            StartCoroutine(PlayStretchCoroutine());\\n        }\\n        else\\n        {\\n            _animator = go.transform.GetComponentInChildren<Animator>();\\n            if (_animator != null)\\n            {\\n                StartCoroutine(PlayStretchCoroutine());\\n            }\\n        }\\n    }\\n\\n    IEnumerator PlayStretchCoroutine()\\n    {\\n        yield return 0.2f;\\n        if (_animEvent != null)\\n        {\\n            if (!string.IsNullOrEmpty(_monsterSound))\\n            {\\n                AudioManager.Instance.PlayVoice(_monsterSound, volume: 0.6f);\\n            }\\n\\n            _animEvent.Animator.CrossFadeInFixedTime(\\"Stretch\\", 0.01f);\\n        }\\n        else if (_animator != null)\\n        {\\n            if (!string.IsNullOrEmpty(_monsterSound))\\n            {\\n                AudioManager.Instance.PlayVoice(_monsterSound, volume: 0.6f);\\n            }\\n\\n            _animator.CrossFadeInFixedTime(\\"Stretch\\", 0.01f);\\n        }\\n\\n        StopAllCoroutines();\\n    }\\n    \\n    private long GetWorldEncounterId()\\n    {\\n        long encounterId = _tileData.ResourceId;\\n        if (_tileData.TileType == TileType.TILE_SHADOW_LAND_MONSTER) {\\n            var shadowMonster = ConfigManager2.Instance.DB_ShadowPlaneEntity.GetData(encounterId);\\n            if (shadowMonster != null) {\\n                encounterId = shadowMonster.CommonMosterId;\\n            }\\n        }\\n        else if(_tileData.TileType == TileType.TILE_SHADOW_LAND_BOSS) {\\n            var shadowMonster = ConfigManager2.Instance.DB_ShadowPlaneGroup.GetData(ShadowPlaneManager.Instance.GroupId);\\n            if (shadowMonster != null) {\\n                encounterId = shadowMonster.BossId;\\n            }\\n        }\\n        else if (IsRadarMonster())\\n        {\\n            var fantasyRadarQuestInfo = ConfigManager2.Instance.DB_FantasyRadarQuest.GetData(_tileData.ResourceId);\\n            if (fantasyRadarQuestInfo != null)\\n            {\\n                encounterId = fantasyRadarQuestInfo.MonsterId;\\n            }\\n        }\\n        \\n        return encounterId;\\n    }\\n\\n    private BattleForecast _battleForecast;\\n\\n    private void UpdateRecommendedMarch(WorldEncounterInfo encounterInfo)\\n    {\\n        if (_recommendPower == null)\\n            return;\\n\\n        _recommendPower.text = string.Empty;\\n        if (encounterInfo == null || string.IsNullOrEmpty(encounterInfo.MonsterGroup))\\n            return;\\n\\n        WorldEncounterMonsterInfo monsterInfo =\\n            ConfigManager.inst.DB_WorldEncounterMonster.GetDataByGroupId(encounterInfo.MonsterGroup);\\n        if (monsterInfo == null || string.IsNullOrEmpty(monsterInfo.RecommendedMarch))\\n            return;\\n\\n        string[] recommendedMarchParams = monsterInfo.RecommendedMarch.Split(\',\');\\n        if (recommendedMarchParams.Length < 2)\\n            return;\\n\\n        _recommendPower.text = Utils.XLATParam(\\n            \\"season_optimize_monster_recom_troop\\",\\n            recommendedMarchParams[0].Trim(),\\n            recommendedMarchParams[1].Trim());\\n    }\\n\\n    private void UpdateRecommendedPower()\\n    {\\n        WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        // if(_battleForecast == null)\\n        //     _battleForecast = new BattleForecast(_resultPredicts[2].gameObject,_resultPredicts[0].gameObject,\\n        //         _resultPredicts[1].gameObject,_resultPredicts.Count >=4 ? _resultPredicts[3].gameObject:null);\\n\\n        Hashtable troops = new Hashtable();\\n        Hashtable heros = new Hashtable();\\n        MarchAllocManager.Instance.GetMonsterMarchTroopAndHero(ref troops,ref heros);\\n        // if (info != null)\\n        //     _battleForecast.SetSelectInfo(troops, heros, MarchAllocManager.Instance.IsHasDragon(), info.InternalId,\\n        //         BattleForecast.MonsterType.WorldEncounter);\\n    }\\n    \\n    void CheckDevil()\\n    {\\n        if (timeLeftLabel == null || monsterIcon == null || rallyBtn == null)\\n            return;\\n\\n        rallyBtn.onClick.Clear();\\n        EventDelegate.Add(rallyBtn.onClick, OnRallyBtn);\\n\\n        timeLeftLabel.gameObject.SetActive(_showTime);\\n        if (_showTime)\\n        {\\n            //monsterIcon.width = 1300;\\n            //monsterIcon.height = 1300;\\n            //monsterIcon.transform.localPosition = new Vector3(monsterIcon.transform.localPosition.x, -80, 0);\\n            OnSecondTime(NetServerTime.inst.ServerTimestamp);\\n            Oscillator.Instance.secondEvent += OnSecondTime;\\n        }\\n        else\\n        {\\n            rallyBtn.gameObject.SetActive(false);\\n        }\\n\\n        if (shareBtn)\\n            shareBtn.gameObject.SetActive(_showTime);\\n    }\\n\\n    //魔王集结\\n    private void OnRallyBtn()\\n    {\\n        //GameConfigInfo gameConfigInfo = ConfigManager.inst._DB_GameConfig.GetData(\\"gve_boss_spirit_cost\\");\\n        //if (gameConfigInfo != null && PlayerData.inst.heroData.spirit < gameConfigInfo.ValueInt)\\n        //{\\n        //    Utils.ShowException(1200050);\\n        //    return;\\n        //}\\n\\n            if (PlayerData.inst.CanRally)\\n            {\\n                //\\n                if (_specialMonsterType == SpecialMonsterType.GamblingBoss)\\n                {\\n                    RallyGamblingBoss();\\n                    return;\\n                }\\n                \\n                OnCloseButtonPress();\\n\\n                    var KingInfo = ConfigManager.inst.DB_ActivityDevilKing.GetData(_tileData.KillDevilBossData.ConfigId);\\n                    if (KingInfo == null)\\n                        return;\\n\\n                    ActivityDevilInfo info = ConfigManager.inst.DB_ActivityDevil.GetInfoByBossGroup(KingInfo.monsterGroup);\\n\\n                    if (_specialMonsterType == SpecialMonsterType.DevilBoss)\\n                    {\\n                        var devilInfo =\\n                            ConfigManager.inst.DB_ActivityDevil.GetData(\\n                                ActivityManager.Instance.killDevilActivityData.Round);\\n                        if (devilInfo != null)\\n                        {\\n                            var cost = devilInfo.strengthSpendKing;\\n                            if (PlayerData.inst.heroData.spirit < cost)\\n                            {\\n                                UI.UIManager.inst.toast.Show(Utils.XLAT(\\"monster_attack_not_enough_stamina_description\\"));\\n                                return;\\n                            }\\n                        }\\n                    }\\n\\n                if (info != null)\\n                {\\n                    UI.UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n                    {\\n                    Location = _tileData.Location,\\n                    MarchType = MarchType.StartGveRally,\\n                    //bossIndex = this.curSelected.m_index,\\n                    EnergyCost = 0,\\n                    isKillDevil = true,\\n                    ispositiveMarch = true,\\n                    killDevilCfgID = info.internalId,\\n                });\\n                ;\\n            }\\n\\n            return;\\n        }\\n        else\\n        {\\n            March.MarchSystem.LocalMarchCheckType result = GameEngine.Instance.marchSystem.CanRally(_tileData.Location);\\n            UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.singleButtonPopup, new SingleButtonPopup.Parameter()\\n            {\\n                title = Utils.XLAT(\\"id_uppercase_warning\\"),\\n                description = GameEngine.Instance.marchSystem.GetCheckTypeMsg(result),\\n            });\\n        }\\n\\n        OnCloseButtonPress();\\n    }\\n\\n    private void OnSecondTime(int serverTime)\\n    {\\n        if (_specialMonsterType == SpecialMonsterType.GamblingBoss)\\n        {\\n            TickGamblingBossInfo();\\n            return;\\n        }\\n        \\n        //using (new ScopedProfiler(\\"PVEMonsterDetailNew.OnSecond\\"))\\n        {\\n            //Utils.FormatTime(_monsterData.LeftTime)\\n\\n            if (timeLeftLabel == null || _tileData == null)\\n                return;\\n\\n            var monsterdata = _tileData.KillDevilBossData;\\n            var timeLeft = Utils.FormatTime(monsterdata.LeftTime);\\n            if (monsterdata.LeftTime > 0)\\n            {\\n                timeLeftLabel.text = Utils.XLAT_Extend(\\"id_remaining_time_variable\\", timeLeft);\\n            }\\n            else\\n            {\\n                timeLeftLabel.text = \\"\\";\\n            }\\n        }\\n    }\\n\\n\\n    public void OnRefreshCell(int cellIndex, GameObject cell, object userData)\\n    {\\n        var itemStaticInfoComponent = cell.GetComponent<ItemStaticInfoComponent>();\\n        if (userData is StringStringPair_Row)\\n        {\\n            StringStringPair_Row data = userData is StringStringPair_Row ? (StringStringPair_Row) userData : default;\\n            long itemId, num;\\n            long.TryParse(data.Id,out itemId);\\n            long.TryParse(data.Value, out num);\\n            if (itemStaticInfoComponent)\\n            {\\n                itemStaticInfoComponent.ShowEffect(false);\\n            \\n                ItemlistInfo itemlistInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\\n                if (itemlistInfo.ItemType == ItemBag.ItemType.parliament_hero_card_chip)\\n                    itemStaticInfoComponent.SetData(itemlistInfo, num, null, true);\\n                else\\n                    itemStaticInfoComponent.SetData(itemlistInfo, num, null, false);\\n            }     \\n        }\\n        else if(userData is DisplayDropMainInfo)\\n        {\\n            DisplayDropMainInfo info = userData as DisplayDropMainInfo;\\n            \\n            if (itemStaticInfoComponent)\\n            {\\n                itemStaticInfoComponent.ShowEffect(false);\\n\\n                ItemlistInfo itemlistInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(info.ItemId);\\n\\n                long addMinValue = 0;\\n                long addMaxValue = 0;\\n\\n                // 星盘天赋：攻打赛季野怪（或野蛮人营地）资源获得+n%\\n                if (AstrolabeTalentManager.Instance.IsIncreaseResObtainByHuntMonster())\\n                {\\n                    AstrolabeTalentManager.Instance.GetIncreaseResObtainByHuntMonsterValue(itemlistInfo.Type, info.MinValue, out addMinValue);\\n                    AstrolabeTalentManager.Instance.GetIncreaseResObtainByHuntMonsterValue(itemlistInfo.Type, info.MaxValue, out addMaxValue);\\n                }\\n\\n                long minValue = info.MinValue + addMinValue;\\n                long maxValue = info.MaxValue + addMaxValue;\\n\\n                if (itemlistInfo.ItemType == ItemBag.ItemType.parliament_hero_card_chip)\\n                    itemStaticInfoComponent.SetData(itemlistInfo, minValue, maxValue, true);\\n                else\\n                    itemStaticInfoComponent.SetData(itemlistInfo, minValue, maxValue, false);\\n            }      \\n        }\\n        else if(userData is ItemlistInfo)\\n        {\\n            ItemlistInfo itemlistInfo = userData as ItemlistInfo;\\n            itemStaticInfoComponent.SetData(itemlistInfo, 1, null, false);\\n        }\\n        else if (userData is Reward.RewardsValuePair)\\n        {\\n            Reward.RewardsValuePair itemInfo = userData as Reward.RewardsValuePair;\\n            itemStaticInfoComponent.SetData(itemInfo.internalID, itemInfo.value);\\n        }\\n    }\\n\\n    private void RegisterBtnEvent()\\n    {\\n        attackBtn.onClick.Clear();\\n        EventDelegate.Add(attackBtn.onClick,()=> AttackHandler());\\n        gotoBtn.onClick.Clear();\\n        EventDelegate.Add(gotoBtn.onClick, OnFindMonsterHandler);\\n        if (btnAssemble)\\n            EventDelegate.Add(btnAssemble.onClick,AssembleHandle);\\n    }\\n\\n    private void UnRegisterBtnEvent()\\n    {\\n        attackBtn.onClick.Clear();\\n        gotoBtn.onClick.Clear();\\n        if(btnAssemble)\\n            btnAssemble.onClick.Clear();\\n    }\\n\\n    //没用\\n    private void AddEventHandler()\\n    {\\n        Oscillator.Instance.secondEvent += OnSecond;\\n    }\\n\\n    private void OnSecond(int serverTime)\\n    {\\n        //using (new ScopedProfiler(\\"PVEMonsterDetailNew.OnSecond2\\"))\\n        {\\n            CheckAttack();\\n            if (_tileData != null\\n                && _tileData.OwnerID > 0\\n                && _tileData.Value <= 0)\\n            {\\n                OnCloseHandler();\\n            }\\n        }\\n    }\\n\\n    private bool showExpeditionBtn\\n    {\\n        get\\n        {\\n            if(null == _tileData || _tileData.TileType != TileType.Encounter )\\n                return false;\\n            \\n            var info = ConfigManager2.inst.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n            if (null == info)\\n                return false;\\n\\n            if (null == PlayerData.inst || null == PlayerData.inst.userData)\\n                return false;\\n\\n            if (!IsMonthCardAutoAttackAvailable)\\n                return false;\\n\\n            var level = (int)info.EncounterLevel;\\n            var canAttack = false;\\n            if (PlayerData.inst.IsInFantasyWorld)\\n            {\\n                canAttack = PlayerData.inst.userData.FantasyMonsterLevel > level - 1;\\n            }\\n            else\\n            {\\n                canAttack = PlayerData.inst.userData.monster_level > level - 1;\\n            }\\n\\n            return canAttack;\\n        }\\n    }\\n\\n    private void CheckAttack()\\n    {\\n        if(_tileData!=null && _tileData.TileType == TileType.MorganaMonster )\\n            return;\\n        WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        if (info != null)\\n        {\\n           \\n            int lev = (int)info.EncounterLevel;\\n\\n            if (PlayerData.inst.IsInFantasyWorld)\\n            {\\n                _open = PlayerData.inst.userData.FantasyMonsterLevel >= lev - 1;\\n                if (IsRadarMonster())\\n                {\\n                    _open = true;\\n                }\\n            }\\n            else\\n            {\\n                _open = PlayerData.inst.userData.monster_level >= lev - 1;\\n            }\\n\\n            NGUITools.SetActive(attackBtn.gameObject, _open);\\n\\n            NGUITools.SetActive(this.normalTip.gameObject, !_open);\\n            NGUITools.SetActive(this.powerTrans, _open);\\n            if (this._gamblingBossTipsLabel != null)\\n            {\\n                NGUITools.SetActive(this._gamblingBossTipsLabel.gameObject, false);\\n            }\\n            if(btnAssemble)\\n                NGUITools.SetActive(btnAssemble.gameObject,false);\\n            \\n        }\\n    }\\n\\n    public void OnCloseHandler()\\n    {\\n        UI.UIManager.inst.CloseDlg();\\n    }\\n\\n    public void OnInfoHandler()\\n    {\\n        var index = _specialMonsterType == SpecialMonsterType.GamblingBoss ? 4 : 1;\\n        // UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.InfoKingdom, new InfoKingdom.Parameter()\\n        // {\\n        //     initIndex = index,\\n        // });\\n\\n        InfoKingdomNew.InfoKingdomType openInfoType = _specialMonsterType == SpecialMonsterType.GamblingBoss\\n            ? InfoKingdomNew.InfoKingdomType.Rally\\n            : InfoKingdomNew.InfoKingdomType.Monster;\\n        UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.InfoKingdomNew, new InfoKingdomNew.Parameter()\\n        {\\n            openType = openInfoType,\\n        });\\n    }\\n\\n    public void OnFindMonsterHandler()\\n    {\\n        if (!SeasonNisaMapData.CheckCircleAction(PlayerData.inst.CityData.Location, _tileData.Location))\\n        {\\n            UIManager.inst.CloseDlg();\\n            return;\\n        }\\n        \\n        Hashtable htRequest = new Hashtable();\\n        if (_tileData != null && _tileData.TileType == TileType.DemonSnipe)\\n        {\\n            htRequest.Add(\\"event_type\\", DemonSnipeManager.Instance.DemonSnipeGroupStr);\\n        }\\n\\n        RequestManager.Instance.SendRequest(PortType.MAP_FIND_NEARBY_MAX_LEVEL_MONSTER_USER_CAN_FIGHT,\\n            htRequest, delegate(bool ret, object orgData)\\n            {\\n                if (ret && this)\\n                {\\n                    OnCloseHandler();\\n\\n                    Hashtable data = orgData as Hashtable;\\n                    if (data != null)\\n                    {\\n                        Coordinate location = new Coordinate();\\n                        DB.DatabaseTools.UpdateData(data, \\"world_id\\", ref location.K);\\n                        DB.DatabaseTools.UpdateData(data, \\"map_x\\", ref location.X);\\n                        DB.DatabaseTools.UpdateData(data, \\"map_y\\", ref location.Y);\\n                        PVPSystem.Instance.Map.GotoLocation(location, true);\\n                        Utils.StartCoroutine(PVPSystem.Instance.Map, PVPSystem.Instance.Map.AutoOpenMapMonsterPanel(location, _tileData.TileType));\\n                    }\\n                    else\\n                    {\\n                        long monsterLv = 0;\\n                        if (PlayerData.inst.IsInFantasyWorld)\\n                        {\\n                            monsterLv = PlayerData.inst.userData.FantasyMonsterLevel + 1;\\n                        }\\n                        else\\n                        {\\n                            monsterLv = PlayerData.inst.userData.monster_level + 1;\\n                        }\\n                        \\n                        UI.UIManager.inst.toast.Show(string.Format(Utils.XLAT(\\"toast_no_monster_nearby\\"),\\n                            monsterLv));\\n                    }\\n                }\\n            });\\n    }\\n\\n    private void Clear()\\n    {\\n        StopAllCoroutines();\\n        if (!string.IsNullOrEmpty(_monsterSound))\\n        {\\n            AudioManager.Instance.StopSound(_monsterSound);\\n        }\\n\\n        GameObject.Destroy(monster);\\n        preview = null;\\n    }\\n\\n    private void RemoveEventHandler()\\n    {\\n        if (Oscillator.IsAvailable)\\n        {\\n            Oscillator.Instance.secondEvent -= OnSecond;\\n            Oscillator.Instance.secondEvent -= OnSecondTime;\\n        }\\n    }\\n\\n    private void UpdateUIBoss()\\n    {\\n        //初始化GamblingBoss\\n        if (_specialMonsterType == SpecialMonsterType.GamblingBoss)\\n        {\\n            InitGamblingBossUI();\\n            return;\\n        }\\n        \\n        if (_tileData == null)\\n        {\\n            return;\\n        }\\n\\n        attackBtn.gameObject.SetActive(false);\\n\\n        gotoBtn.gameObject.SetActive(false);\\n        rallyBtn.gameObject.SetActive(true);\\n        Utils.SetActive(btnAssemble.gameObject,false);\\n\\n        labelX.text = _targetLocation.X.ToString();\\n        labelY.text = _targetLocation.Y.ToString();\\n        \\n\\n        DB.KillDevilBossData _monsterData = _tileData.KillDevilBossData;\\n\\n        if (_monsterData == null)\\n            return;\\n\\n        var kingInfo = ConfigManager.inst.DB_ActivityDevilKing.GetData(_monsterData.ConfigId);\\n        if (kingInfo == null)\\n            return;\\n\\n        desc.text = kingInfo.Description;\\n        if (title != null)\\n        {\\n            title.text = Utils.XLAT(\\"id_lv\\") + kingInfo.bossLevel + \\" \\" + kingInfo.Name;\\n        }\\n\\n        power.text = kingInfo.recommended_power.ToString();\\n\\n        if (_rallySpiritIcon != null)\\n        {\\n            _rallySpiritIcon.SetActive(false);\\n        }\\n        \\n        mustContainer.ClearAll();\\n        rateContainer.ClearAll();\\n\\n        List<DisplayDropMainInfo> mustList =\\n            ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(kingInfo.displayInevitableGroup);\\n        List<DisplayDropMainInfo> rateDrop =\\n            ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(kingInfo.displayRandomGroup);\\n\\n        foreach (var item in mustList)\\n        {\\n            mustContainer.AddCell(0, item);\\n        }\\n\\n        if (rateDrop.Count <= 0)\\n        {\\n            mayTrans.gameObject.SetActive(false);\\n        }\\n\\n        foreach (var item in rateDrop)\\n        {\\n            rateContainer.AddCell(0, item);\\n        }\\n\\n        mustContainer.UpdateImmediately();\\n        rateContainer.UpdateImmediately();\\n\\n        NGUITools.SetActive(this.normalTip.gameObject, false);\\n        NGUITools.SetActive(this.powerTrans, true);\\n        if (this._gamblingBossTipsLabel != null)\\n        {\\n            NGUITools.SetActive(this._gamblingBossTipsLabel.gameObject, false);\\n        }\\n    }\\n\\n    public void UpdateUI()\\n    {\\n        SetStaminaMode(true);\\n        \\n        if (_tileData == null)\\n        {\\n            return;\\n        }\\n        \\n        if (_tileData.TileType == TileType.MorganaMonster)\\n        {\\n            SetRewardTitletxtInfo(Utils.XLAT(CAConstContainer.CARewardTitle1), Utils.XLAT(CAConstContainer.CARewardTitle2));\\n            UpdateMorganaMonster();\\n            //CAManager.Instance.ReqCALoadDBData();\\n            return;\\n        }\\n        \\n        if (_tileData.TileType == TileType.Fake_Slg_Monster)\\n        {\\n            SetStaminaMode(false);\\n            UpdateIntelligenceSlgMonster();\\n            UpdateRecommendedPower();\\n            Utils.SetActive(_monsterRewardRate,false);\\n            return;\\n        }\\n        \\n        if (_tileData.TileType == TileType.TILE_SHADOW_LAND_MONSTER || _tileData.TileType == TileType.TILE_SHADOW_LAND_BOSS)\\n        {\\n            SetShadowPlaneMonster();\\n            return;\\n        }\\n\\n        if (IsRadarMonster())\\n        {\\n            SetStaminaMode(false);\\n            Utils.SetActive(btnHelp, false);\\n            Utils.SetActive(_monsterRewardRate,false);\\n            FantasyRadarQuestInfo radarQuestInfo =\\n                ConfigManager2.Instance.DB_FantasyRadarQuest.Get(_tileData.ResourceId);\\n            if (radarQuestInfo != null)\\n            {\\n                if ((FantasyWorldManager.RadarType)radarQuestInfo.Type == FantasyWorldManager.RadarType.Mirror)\\n                {\\n                   \\n                    Utils.SetActive(s9RadarLabel, true);\\n                    if (s9RadarLabel != null)\\n                    {\\n                        s9RadarLabel.text = Utils.XLAT(\\"fantasy_s9_radar_task_1_kill_count_subtitle\\",\\"0\\",Utils.FormatThousands(radarQuestInfo.KillNumber));\\n                    }\\n                }\\n\\n                if (IsMonsterIconShowBy2d() && monsterIcon2 != null)\\n                {\\n                    Utils.SetActive(monsterIcon2, true);\\n                    Utils.SetActive(monsterIcon, false);\\n                    string imagePath = $\\"Texture/FantasyWorld/{radarQuestInfo.ExploreIcon}\\";\\n                    BuilderFactory.Instance.HandyBuild(monsterIcon2, imagePath);\\n                }\\n                else\\n                {\\n                    Utils.SetActive(monsterIcon2, false);\\n                    Utils.SetActive(monsterIcon, true);\\n                }\\n            }\\n        }\\n        \\n        bool isAttack = true;\\n        if (PVPMap.IsForeigner() &&\\n            !PVPMap.InHeitudi(_targetLocation) &&\\n            !MapUtils.IsNisaSeasonWorld(_targetLocation.K) &&\\n            !MapUtils.IsFantasyWorld(_targetLocation.K))\\n        {\\n            isAttack = false;\\n        }\\n        else\\n        {\\n            isAttack = _tileData.Location.K == PlayerData.inst.playerCityData.cityLocation.K;\\n        }\\n        \\n        attackBtn.isEnabled = isAttack;\\n\\n        if (btnAssemble)\\n            btnAssemble.isEnabled = isAttack;\\n        \\n        labelX.text = _targetLocation.X.ToString();\\n        labelY.text = _targetLocation.Y.ToString();\\n        \\n        if (_tileData.TileType == TileType.DemonSnipe)\\n        {\\n            UpdateMonsterDemonSnipe();\\n            return;\\n        }\\n\\n        UpdateMonsterDefault();\\n    }\\n\\n    private void SetShadowPlaneMonster()\\n    {\\n        if (!PlayerData.inst.IsInShadowPlaneWorld)\\n            return; \\n        \\n        SetStaminaMode(false);\\n        UpdateShadowPlaneMonster();\\n    }\\n\\n    private void UpdateMonsterBaseInfo(WorldEncounterInfo info)\\n    {\\n        if (null != info)\\n        {\\n            _monsterSound = info.Music;\\n\\n            int lev = (int) info.EncounterLevel;\\n            if (PlayerData.inst.IsInFantasyWorld)\\n            {\\n                _open = PlayerData.inst.userData.FantasyMonsterLevel >= lev - 1;\\n                if (IsRadarMonster())\\n                {\\n                    _open = true;\\n                }\\n            }\\n            else\\n            {\\n                _open = PlayerData.inst.userData.monster_level >= lev - 1;\\n            }\\n\\n            NGUITools.SetActive(attackBtn.gameObject, _open);\\n            NGUITools.SetActive(this.normalTip.gameObject, !_open);\\n            NGUITools.SetActive(this.powerTrans, _open);\\n\\n            desc.text = info.Desc;\\n            power.text = Utils.FormatBattleNumShortThousandsLong(info.RecommendedPower);\\n            UpdateRecommendedMarch(info);\\n\\n            //体力\\n            int cost = (int) ConfigManager.inst.DB_BenefitCalc.GetFinalData(info.CostEnergy,\\n                \\"calc_monster_spirit_cost\\");\\n            spirit.text = cost.ToString();\\n            NewPrivilegeMonthCardManager.Instance.targetPower = cost;\\n\\n            DB.HeroData hero = DB.DBManager.Instance.DB_hero.Get(PlayerData.inst.cityId);\\n            spirit.text = cost.ToString() + \\"/\\" + hero.spirit;\\n            if (hero.spirit < cost)\\n            {\\n                spirit.color = Color.red;\\n            }\\n            else\\n            {\\n                spirit.color = Color.white;\\n            }\\n\\n            //怪物等级\\n            long monsterLv = 0;\\n            if (PlayerData.inst.IsInFantasyWorld)\\n            {\\n                monsterLv = PlayerData.inst.userData.FantasyMonsterLevel + 1;\\n            }\\n            else\\n            {\\n                monsterLv = PlayerData.inst.userData.monster_level + 1;\\n            }\\n\\n            Dictionary<string, string> param = new Dictionary<string, string>();\\n            param.Add(\\"num\\", monsterLv.ToString());\\n            normalTip.text =\\n                I2.Loc.ScriptLocalization.GetWithPara(\\"monster_attack_recommended_monster_level_description\\", param);\\n\\n            //赛季 - 星盘天赋\\n            if (PlayerData.inst.IsInFantasyWorld && !IsRadarMonster())\\n            {\\n                SetAstrolabeTalentExpUI();\\n            }\\n        }\\n    }\\n    \\n    private void UpdateMonsterDefault()\\n    {\\n        WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        if (null != info)\\n        {\\n            UpdateMonsterBaseInfo(info);\\n            \\n            //名字\\n            int lev = (int) info.EncounterLevel;\\n            if (title != null)\\n            {\\n                string monserName = info.LocName;\\n                title.text = Utils.XLAT(\\"id_lv\\") + lev + \\" \\" + monserName;\\n            }\\n\\n            //掉落\\n            mustContainer.ClearAll();\\n            rateContainer.ClearAll();\\n\\n            List<DisplayDropMainInfo> mustList =\\n                ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(\\n                    info.DisplayInevitableGroup);\\n            List<DisplayDropMainInfo> rateDrop =\\n                ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(info.DisplayRandomGroup);\\n\\n            foreach (var item in mustList)\\n            {\\n                mustContainer.AddCell(0, item);\\n            }\\n\\n            if (rateDrop.Count <= 0)\\n            {\\n                mayTrans.gameObject.SetActive(false);\\n            }\\n\\n            foreach (var item in rateDrop)\\n            {\\n                rateContainer.AddCell(0, item);\\n            }\\n\\n            mustContainer.UpdateImmediately();\\n            rateContainer.UpdateImmediately();\\n        }\\n    }\\n    \\n    private void UpdateMonsterDemonSnipe()\\n    {\\n        WorldEncounterInfo info = null;\\n        EventMonsterInfo monsterInfo = ConfigManager.inst.DB_EventMonster.GetData(_tileData.ResourceId);\\n        if (monsterInfo != null)\\n        {\\n            info = monsterInfo.LinkWorldEncounterInfo;\\n        }\\n        \\n        if (null != info)\\n        {\\n            UpdateMonsterBaseInfo(info);\\n            \\n            int lev = (int)info.EncounterLevel;\\n            //名字\\n            if (title != null)\\n            {\\n                string monserName = monsterInfo != null ? monsterInfo.Name : info.LocName;\\n                title.text = Utils.XLAT(\\"id_lv\\") + lev + \\" \\" + monserName;\\n            }\\n\\n            //掉落\\n            mustContainer.ClearAll();\\n            rateContainer.ClearAll();\\n            //monsterInfo.LinkWorldEncounterInfo\\n            List<DisplayDropMainInfo> mustList =\\n                ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(monsterInfo\\n                    .LinkWorldEncounterInfo.DisplayInevitableGroup);\\n            List<DisplayDropMainInfo> rateDrop =\\n                ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(monsterInfo\\n                    .LinkWorldEncounterInfo.DisplayRandomGroup);\\n\\n            foreach (var item in mustList)\\n            {\\n                mustContainer.AddCell(0, item);\\n            }\\n\\n            foreach (var item in rateDrop)\\n            {\\n                rateContainer.AddCell(0, item);\\n            }\\n                \\n            mustContainer.UpdateImmediately();\\n            rateContainer.UpdateImmediately();\\n        }\\n        if (this._gamblingBossTipsLabel != null)\\n        {\\n            NGUITools.SetActive(this._gamblingBossTipsLabel.gameObject, false);\\n        }\\n    }\\n\\n    private void UpdateMorganaMonster()\\n    {\\n        Utils.SetActive(btnAssemble.gameObject,true);\\n        labelX.text = _targetLocation.X.ToString();\\n        labelY.text = _targetLocation.Y.ToString();\\n        KillCircusActivityBossInfo data = ConfigManager2.Instance.DB_KillCircusActivityBoss.GetData(_tileData.ResourceId);\\n        if(data == null)\\n            return;\\n        desc.text = Utils.XLAT(data.Des);\\n        title.text = Utils.XLAT(data.Name);\\n        mustContainer.ClearAll();\\n        rateContainer.ClearAll();\\n\\n        foreach (var item in data.KillRewards)\\n        {\\n            mustContainer.AddCell(0, item);\\n        }\\n        \\n        //circus_kill_group  新增DropChestDisplay字段进行查表配置\\n        ItemlistInfo itemlistInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(CAManager.Instance.KCGroupInfo.DropChestDisplay);\\n        if (null != itemlistInfo)\\n        {\\n            rateContainer.AddCell(0, itemlistInfo);\\n        }\\n        mustContainer.UpdateImmediately();\\n        rateContainer.UpdateImmediately();\\n        if (btnHelp && shareBtn)\\n        {\\n            Utils.SetActive(btnHelp.gameObject,false);\\n            shareBtn.transform.localPosition = btnHelp.transform.localPosition;\\n        }\\n        ShowMorganaMonster();\\n    }\\n\\n    private void ShowMorganaMonster()\\n    {\\n        _open = false;\\n        NGUITools.SetActive(attackBtn.gameObject, _open);\\n\\n        NGUITools.SetActive(this.normalTip.gameObject, _open);\\n        NGUITools.SetActive(this.powerTrans, _open);\\n        if (this._gamblingBossTipsLabel != null)\\n        {\\n            NGUITools.SetActive(this._gamblingBossTipsLabel.gameObject, false);\\n        }\\n        \\n        if (btnAssemble)\\n        {\\n            NGUITools.SetActive(btnAssemble.gameObject,!_open);   \\n        }\\n        \\n        SetRallyBtnAndTexInfo();\\n        \\n        // if (assembleItemLabel)\\n        // {\\n        //     long haveItem = ItemBag.Instance.GetItemCount(info.Item);\\n        //     long cost = info.TicketSpendNum;\\n        //     assembleItemLabel.text = cost.ToString();\\n        //     assembleItemLabel.color = haveItem < cost ? Color.red : Color.white;   \\n        // }\\n    }\\n\\n    private void SetRallyMorganaBtnTxtState(bool showFree )\\n    {\\n        if (morganaFreeObj)\\n        {\\n            Utils.SetActive(morganaFreeObj, showFree);\\n        }\\n        if (morganaPaidObj)\\n        {\\n            Utils.SetActive(morganaPaidObj, !showFree);\\n        }\\n    }\\n\\n    /// <summary>\\n    /// 击杀戏班集结v12.2版本新的按钮文字显示逻辑\\n    /// </summary>\\n    private void SetRallyBtnAndTexInfo()\\n    {\\n        //return;\\n        if (null == assembleItemLabel)\\n            return;\\n\\n        bool isFreeRally = CAManager.Instance.IsCanFreeMorganaMonsterRally();\\n        SetRallyMorganaBtnTxtState(isFreeRally);\\n        // if (rallyCoinObj)\\n        // {\\n        //     Utils.SetActive(rallyCoinObj, !isFreeRally);\\n        // }\\n        \\n        if (!isFreeRally)\\n        {\\n            long costCoin = CAManager.Instance.GetMorganaMonsterRallyCost();\\n            assembleItemLabel.text = costCoin.ToString();\\n            long haveItem = CAManager.Instance.GetCircusCoinItem_L();\\n            assembleItemLabel.color = haveItem < 0 || haveItem < costCoin ? Color.red : Color.white;\\n        }\\n    }\\n\\n    private void SetRewardTitletxtInfo(string bRewardTitle, string dRewardTitle)\\n    {\\n        if (null != baseRewardTitleLb)\\n        {\\n            baseRewardTitleLb.text = bRewardTitle;\\n        }\\n        if (null != dropRewardTitleLb)\\n        {\\n            dropRewardTitleLb.text = dRewardTitle;\\n        }\\n    }\\n\\n    public void AttackHandler(bool isAutoAttack=false)\\n    {\\n        if (IsRadarMonster())\\n        {\\n            OnAttackFantasyRadarMonster();\\n            return;\\n        }\\n        if (_tileData.TileType == TileType.Fake_Slg_Monster)\\n        {\\n            OnAttackFakeSlgMonster();\\n            return;\\n        }\\n        else if(PlayerData.inst.IsInShadowPlaneWorld)\\n        {\\n            OnAttackShadowPlaneMonster();\\n            return;\\n        }\\n\\n        if (!SeasonNisaMapData.CheckCircleAction(PlayerData.inst.CityData.Location, _tileData.Location))\\n        {\\n            UIManager.inst.CloseDlg();\\n            return;\\n        }\\n\\n        //if (!FantasyMapData.CheckTeleportAction(_tileData.Location, TeleportMode.NONE, out var tipType) &&\\n        //    tipType != TeleportTipType.CityEdgeArea && tipType != TeleportTipType.FantasyMonsterIslandArea)\\n        //{\\n        //    if (TeleportTipType.Birth == tipType)\\n        //        UIManager.inst.toast.Show(Utils.XLAT(FantasyWorldManager.Instance.GetKeyByMapType(\\"fantasy_toast_cant_do_this_in_other_kingdom_safe_area\\")));\\n        //    else\\n        //        UIManager.inst.toast.Show(Utils.XLAT(\\"fantasy_world_cant_do_require_not_met\\"));\\n\\n        //    return;\\n        //}\\n\\n        if (DB.DBManager.Instance.DB_March.GetUsedMarchSlotCount() >= PlayerData.inst.playerCityData.marchSlot)\\n        {\\n            GameEngine.Instance.marchSystem.ShowMaxMarchSlotMessage();\\n            return;\\n        }\\n\\n        DB.HeroData hero = DB.DBManager.Instance.DB_hero.Get(PlayerData.inst.cityId);\\n        WorldEncounterInfo data = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n\\n        if (_tileData.TileType == TileType.DemonSnipe)\\n        {\\n            EventMonsterInfo info = ConfigManager.inst.DB_EventMonster.GetData(_tileData.ResourceId);\\n            if (info != null)\\n            {\\n                data = info.LinkWorldEncounterInfo;\\n            }\\n        }\\n\\n        if (data == null)\\n        {\\n            OnCloseButtonPress();\\n            return;\\n        }\\n        \\n        \\n        int cost = (int)ConfigManager.inst.DB_BenefitCalc.GetFinalData(data.CostEnergy, \\"calc_monster_spirit_cost\\");\\n        if (hero.spirit < cost)\\n        {\\n            PlayerProfileAddPopup.Parameter param = new PlayerProfileAddPopup.Parameter();\\n            param.AddType = PlayerProfileAddPopup.PlayerAddType.LordVital;\\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.PlayerProfileAddPopup, param);\\n            //UIManager.inst.toast.Show(Utils.XLAT(\\"monster_attack_not_enough_stamina_description\\"));\\n            return;\\n        }\\n        \\n        if (FantasyWorldManager.Instance.CheckAndRelocationFantasyS9() && PlayerData.inst.IsInFantasyWorld)\\n        {\\n            var s9Mgr = FantasyWorldManager.Instance.FantasySubManager<FantasyWorldSubManagerS9>();\\n            if (s9Mgr != null)\\n            {\\n                s9Mgr.OpenMarchDlg(_tileData, MarchType.MonsterAttack);\\n            }\\n            return;\\n        }\\n\\n        UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n        {\\n            Location = _targetLocation,\\n            MarchType = MarchType.MonsterAttack,\\n            EnergyCost = cost,\\n            TileType = _tileData.TileType,\\n            ResourceId = _tileData.ResourceId,\\n            isAutoAttack = isAutoAttack,\\n        });\\n    }\\n    \\n    public void CircusAssembleHandle()\\n    {\\n        if(_tileData == null)\\n            return;\\n        \\n        if(false == CAManager.Instance.CanAttackMorgana())\\n            return;\\n\\n        bool isCanFreeRally = CAManager.Instance.IsCanFreeMorganaMonsterRally();\\n        long cost = 0;\\n        if (false == isCanFreeRally)\\n        {\\n            cost = CAManager.Instance.GetMorganaMonsterRallyCost();\\n            long haveItem = CAManager.Instance.GetCircusCoinItem_L();\\n            if (haveItem < 0 || haveItem < cost)\\n            {\\n                CAManager.Instance.ShowGetCircusCoinWayView();\\n                return;\\n            }\\n        }\\n\\n        March.MarchSystem.LocalMarchCheckType result = GameEngine.Instance.marchSystem.CanRally(_tileData.Location,false, TileType.MorganaMonster);\\n        if (result == MarchSystem.LocalMarchCheckType.successed)\\n        {\\n            UI.UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n            {\\n                Location = _tileData.Location,\\n                MarchType = MarchType.MorganaMonsterRally,\\n                EnergyCost = (int)cost,\\n            });\\n        }\\n        else\\n        {\\n            UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.singleButtonPopup, new SingleButtonPopup.Parameter()\\n            {\\n                title = Utils.XLAT(\\"id_uppercase_warning\\"),\\n                description = GameEngine.Instance.marchSystem.GetCheckTypeMsg(result),\\n            });\\n        }\\n    }\\n\\n   public void AssembleHandle()\\n   {\\n       CircusAssembleHandle();\\n       \\n       #region 击杀戏班v12.2之前版本 集结按钮处理逻辑\\n       /*\\n       if(_tileData == null)\\n           return;\\n       if(!AnniversarayGoldActivityManager.Instance.CanAttackMorgana())\\n           return;\\n       \\n       KillCircusGroupInfo info = ConfigManager2.Instance.DB_KillCircusGroup.GetTicketItem();\\n       if(info == null)\\n           return;\\n       long cost = info.TicketSpendNum;\\n       \\n       long haveItem=ItemBag.Instance.GetItemCount(info.Item);\\n       if (haveItem < cost)\\n       {\\n           Dictionary<long, int> needDic = new Dictionary<long, int>();\\n           needDic[info.Item] = 0;\\n           CommonGetMoreManager.Instance.OpenGetMorePopup(needDic);\\n           //UIManager.inst.toast.Show(\\"fifth_anniversary_kill_circus_tips_insufficient_items\\");\\n           return;\\n       }\\n       March.MarchSystem.LocalMarchCheckType result = GameEngine.Instance.marchSystem.CanRally(_tileData.Location,true,TileType.MorganaMonster);\\n       if (result == MarchSystem.LocalMarchCheckType.successed)\\n       {\\n           UI.UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n           {\\n               Location = _tileData.Location,\\n               MarchType = MarchType.MorganaMonsterRally,\\n               //BossIndex = this.curSelected.m_index,\\n\\n               EnergyCost = (int)cost,\\n               \\n           });\\n       }\\n       else\\n       {\\n           UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.singleButtonPopup, new SingleButtonPopup.Parameter()\\n           {\\n               title = Utils.XLAT(\\"id_uppercase_warning\\"),\\n               description = GameEngine.Instance.marchSystem.GetCheckTypeMsg(result),\\n           });\\n       }\\n       */\\n       #endregion\\n   }\\n    \\n    public void OnSharedClick()\\n    {\\n        if (PlayerData.inst.allianceId == DB.AllianceData.INVALID_ID)\\n        {\\n            return;\\n        }\\n\\n        if (NetServerTime.inst.ServerTimestamp - PlayerPrefsEx.GetInt(LocalDataConst.FLAG_TIME_SHARED_BOOKMARK) > 30)\\n        {\\n            \\n            PlayerPrefsEx.SetInt(LocalDataConst.FLAG_TIME_SHARED_BOOKMARK, NetServerTime.inst.ServerTimestamp);\\n            PlayerPrefsEx.Save();\\n\\n            ChatMessageManager.SendBookmark(_targetLocation);\\n            ToastManager.Instance.AddBasicToast(\\"toast_coordinates_shared_success\\");\\n        }\\n        else\\n        {\\n            UI.UIManager.inst.toast.Show(Utils.XLAT(\\"toast_share_coordinates_warning\\"));\\n        }\\n    }\\n\\n    private void SetStaminaMode(bool isShow)\\n    {\\n        if (spriteIcon != null)\\n            spriteIcon.SetActive(isShow);\\n\\n        if (spirit != null)\\n            spirit.gameObject.SetActive(isShow);\\n    }\\n    \\n    #region 阴影位面\\n\\n    private void UpdateShadowPlaneMonster()\\n    {\\n        // 无等级和体力限制\\n        _open = true;\\n        \\n        WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        \\n        //名字\\n        int lev = (int) info.EncounterLevel;\\n        if (title != null)\\n        {\\n            string monserName = info.LocName;\\n            title.text = Utils.XLAT(\\"id_lv\\") + lev + \\" \\" + monserName;\\n        }\\n\\n        //坐标\\n        labelX.text = _targetLocation.X.ToString();\\n        labelY.text = _targetLocation.Y.ToString();\\n        \\n        //掉落\\n        mustContainer.ClearAll();\\n        rateContainer.ClearAll();\\n\\n        if (_tileData._tileType == TileType.TILE_SHADOW_LAND_MONSTER) {\\n            var itemInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(ShadowPlaneManager.Instance.MonsterRewardId);\\n            var entityInfo = ConfigManager2.Instance.DB_ShadowPlaneEntity.GetData(_tileData.ResourceId);\\n\\n            if (itemInfo != null && entityInfo != null) {\\n                Reward.RewardsValuePair pair = new Reward.RewardsValuePair(itemInfo.InternalId, entityInfo.CommonMonsterCoin);\\n                mustContainer.AddCell(0, pair);   \\n            }\\n        }\\n        else if (_tileData._tileType == TileType.TILE_SHADOW_LAND_BOSS) {\\n            var entityGroup = ConfigManager2.Instance.DB_ShadowPlaneGroup.GetData(ShadowPlaneManager.Instance.GroupId);\\n            var worldEncounter = ConfigManager2.Instance.DB_WorldEncounter.GetData(entityGroup.BossId);\\n            if (worldEncounter != null) {\\n                List<DisplayDropMainInfo> mustList =\\n                    ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(\\n                        worldEncounter.DisplayInevitableGroup);\\n\\n                for (int i = 0; i < mustList.Count; i++)\\n                    mustContainer.AddCell(0, mustList[i]);   \\n            }\\n        }\\n        mustContainer.UpdateImmediately();\\n\\n        SetRewardTitletxtInfo(Utils.XLAT(CAConstContainer.NormalRewardTitle1), Utils.XLAT(CAConstContainer.CARewardTitle2));\\n        baseRewardTitleLb.gameObject.SetActive(true);\\n        dropRewardTitleLb.gameObject.SetActive(false);\\n          \\n        mayTrans.gameObject.SetActive(false);\\n        desc.text = info.Desc;\\n        power.text = Utils.FormatBattleNumShortThousandsLong(info.RecommendedPower);\\n        UpdateRecommendedMarch(info);\\n        \\n        // 按钮\\n        if (btnAssemble)\\n            btnAssemble.isEnabled = false;\\n\\n        // 不显示推荐等级\\n        normalTip.text = string.Empty;\\n\\n        attackBtn.isEnabled = true;\\n        \\n        NGUITools.SetActive(attackBtn.gameObject, _open);\\n        NGUITools.SetActive(normalTip.gameObject, !_open);\\n        NGUITools.SetActive(powerTrans, false);\\n    }\\n\\n    private void OnAttackShadowPlaneMonster()\\n    {\\n        if (!SeasonNisaMapData.CheckCircleAction(PlayerData.inst.CityData.Location, _tileData.Location))\\n        {\\n            UIManager.inst.CloseDlg();\\n            return;\\n        }\\n\\n        if (DBManager.Instance.DB_March.GetUsedMarchSlotCount() >= PlayerData.inst.playerCityData.marchSlot)\\n        {\\n            GameEngine.Instance.marchSystem.ShowMaxMarchSlotMessage();\\n            return;\\n        }\\n        \\n        WorldEncounterInfo data = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        if (data == null)\\n        {\\n            Close();\\n            return;\\n        }\\n     \\n        UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n        {\\n            Location = _targetLocation,\\n            MarchType = MarchType.MonsterAttack, \\n            EnergyCost = 0,\\n            TileType = _tileData.TileType,\\n            ResourceId = _tileData.ResourceId,\\n            BattleResult = _battleForecast?.BattleResult ?? -1\\n        });\\n    }\\n    \\n    #endregion\\n    \\n    #region 假怪任务相关\\n\\n    private void UpdateIntelligenceSlgMonster()\\n    {\\n        bool isAttack = true;\\n        if (PVPMap.IsForeigner() && \\n            !PVPMap.InHeitudi(_targetLocation) &&\\n            !MapUtils.IsNisaSeasonWorld(_targetLocation.K) &&\\n            !MapUtils.IsFantasyWorld(_targetLocation.K))\\n        {\\n            isAttack = false;\\n        }\\n        else\\n        {\\n            isAttack = _tileData.Location.K == PlayerData.inst.playerCityData.cityLocation.K;\\n        }\\n        \\n        attackBtn.isEnabled = isAttack;\\n\\n        if (btnAssemble)\\n            btnAssemble.isEnabled = isAttack;\\n\\n        FakeMonsterManager.FakeMonsterInfo monsterInfo = FakeMonsterManager.Instance.GetFakeMonsterInfoByTile(_tileData);\\n        WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        labelX.text = _targetLocation.X.ToString();\\n        labelY.text = _targetLocation.Y.ToString();\\n        \\n        if (null != info && monsterInfo != null)\\n        {\\n            _open = true;\\n            _monsterSound = info.Music;\\n            power.text = Utils.FormatBattleNumShortThousandsLong(info.RecommendedPower);\\n            UpdateRecommendedMarch(info);\\n            desc.text = info.Desc;\\n            if (title != null)\\n                title.text =  info.LocName;\\n            \\n            //奖励\\n            mustContainer.ClearAll();\\n            rateContainer.ClearAll();\\n\\n            var rewardPairs = monsterInfo.GetRewardPair();\\n            if (rewardPairs != null)\\n            {\\n                foreach (var item in rewardPairs)\\n                    mustContainer.AddCell(0, item);   \\n            }\\n            \\n            mustContainer.UpdateImmediately();\\n            \\n            mayTrans.gameObject.SetActive(false);\\n            \\n            //体力\\n            int cost = (int)monsterInfo.GetStaminaNeed();\\n            spirit.text = cost.ToString();\\n            DB.HeroData hero = DB.DBManager.Instance.DB_hero.Get(PlayerData.inst.cityId);\\n            if (hero.spirit < cost)\\n                spirit.color = Color.red;\\n            else\\n                spirit.color = Color.white;\\n\\n            NGUITools.SetActive(attackBtn.gameObject, _open);\\n\\n            NGUITools.SetActive(this.normalTip.gameObject, !_open);\\n            NGUITools.SetActive(this.powerTrans, _open);\\n            if (this._gamblingBossTipsLabel != null)\\n            {\\n                NGUITools.SetActive(this._gamblingBossTipsLabel.gameObject, false);\\n            }\\n        }\\n    }\\n\\n    void OnAttackFantasyRadarMonster()\\n    {\\n        if (DB.DBManager.Instance.DB_March.GetUsedMarchSlotCount() >= PlayerData.inst.playerCityData.marchSlot)\\n        {\\n            GameEngine.Instance.marchSystem.ShowMaxMarchSlotMessage();\\n            return;\\n        }\\n\\n        if (FantasyWorldManager.Instance.IsFantasyS11 || FantasyWorldManager.Instance.IsFantasyS12)\\n        {\\n            UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n\\t\\t\\t{\\n\\t\\t\\t\\tTileType = _tileData.TileType,\\n\\t\\t\\t\\tLocation = _tileData.Location,\\n\\t\\t\\t\\tMarchType = MarchType.FantasyS9Radar,\\n\\t\\t\\t});\\n        }\\n        else\\n        {\\n            MarchAllocDlg.WarShipParam warShipParam = new MarchAllocDlg.WarShipParam();\\n            warShipParam.TileType = _tileData.TileType;\\n            warShipParam.Location = _tileData.Location;\\n            warShipParam.MarchType = MarchType.FantasyS9Radar;\\n            UIManager.inst.OpenDlgAsync(UIManager.DialogType.FantasyworldMarchAllocDlg,warShipParam);\\n        }\\n        \\n    }\\n\\n    private void OnAttackFakeSlgMonster()\\n    {\\n        if (!SeasonNisaMapData.CheckCircleAction(PlayerData.inst.CityData.Location, _tileData.Location))\\n        {\\n            UIManager.inst.CloseDlg();\\n            return;\\n        }\\n\\n        if (DB.DBManager.Instance.DB_March.GetUsedMarchSlotCount() >= PlayerData.inst.playerCityData.marchSlot)\\n        {\\n            GameEngine.Instance.marchSystem.ShowMaxMarchSlotMessage();\\n            return;\\n        }\\n        \\n        DB.HeroData hero = DB.DBManager.Instance.DB_hero.Get(PlayerData.inst.cityId);\\n        WorldEncounterInfo data = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n        \\n        if (data == null)\\n        {\\n            Close();\\n            return;\\n        }\\n        \\n        var monsterInfo = FakeMonsterManager.Instance.GetFakeMonsterInfoByTile(_tileData);\\n        if (hero == null || monsterInfo == null || hero.spirit < monsterInfo.GetStaminaNeed())\\n        {\\n            UIManager.inst.toast.Show(Utils.XLAT(\\"toast_lead_in_2021_kingdom_quest_no_stamina\\"));\\n            return;\\n        }\\n        \\n        System.Action<Hashtable> callBack = FakeMonsterManager.Instance.GetMarchCallBack(_tileData);\\n        UIManager.inst.OpenDlgAsync(UI.UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n        {\\n            Location = _targetLocation,\\n            MarchType = MarchType.Fake_slg_monster, //MonsterAttack\\n            EnergyCost = (int)monsterInfo.GetStaminaNeed(),\\n            TileType = _tileData.TileType,\\n            ResourceId = _tileData.ResourceId,\\n            OnClickOverride = callBack,\\n            BattleResult = _battleForecast?.BattleResult ?? -1\\n        });\\n    }\\n    \\n    #region AutoAttack\\n\\n    public void OnAutoAttackBtnClick()\\n    {\\n        //if (NewPrivilegeMonthCardManager.Instance.IsBuyMonthCard)\\n        {\\n            AttackHandler(true);\\n        }\\n        //else\\n        // {\\n        //     UIManager.inst.toast.Show(\\"请购买月卡(缺Key)\\");\\n        // }\\n\\n\\n    }\\n\\n\\n    #endregion\\n\\n    #endregion\\n\\n    #region 星盘天赋 击杀野怪的星盘天赋经验周上限+n,每次击杀额外获得m%\\n    \\n    private void SetAstrolabeTalentExpUI()\\n    {\\n        AssetManagerEx.Instance.LoadAsObservableWithAutoRelease(AstrolabeTalentKeyContainer.FANTASY_ACHIEVE_EXP).Subscribe(\\n            v =>\\n            {\\n                if(!v.Success())\\n                    return;\\n\\n                LoadFantasyAchieveExpPreCallback(v.asset as GameObject);\\n            }).AddTo(this);\\n    }\\n\\n    void LoadFantasyAchieveExpPreCallback(GameObject go)\\n    {\\n        if (go != null)\\n        {\\n            var fantasyAchieveExpGo = NGUITools.AddChild(this.gameObject, go);\\n            fantasyAchieveExpGo.transform.localPosition = Vector3.zero;\\n            fantasyAchieveExpGo.transform.localScale = Vector3.one;\\n            fantasyAchieveExpGo.transform.localRotation = Quaternion.identity;\\n            fantasyAchieveExpGo.GetComponent<FantasyWorldAchieveExp>().Init(FantasyWorldAchieveExp.OpenFromType.PVEMonsterDetailDialogNew);\\n        }\\n    }\\n    \\n    #endregion\\n\\n    public bool IsRadarMonster()\\n    {\\n        return _tileData != null && (_tileData.TileType == TileType.TILE_FANTASY_RADAR_RADAR_1 ||\\n                                     _tileData.TileType == TileType.TILE_FANTASY_RADAR_RADAR_2);\\n    }\\n    \\n    private bool IsMonsterIconShowBy2d()\\n    {\\n        if (!IsRadarMonster()) return false;\\n        \\n        var fantasyRadarQuestInfo = ConfigManager2.Instance.DB_FantasyRadarQuest.GetData(_tileData.ResourceId);\\n        \\n        if (fantasyRadarQuestInfo == null) return false;\\n\\n        return !string.IsNullOrEmpty(fantasyRadarQuestInfo.ExploreIcon);\\n    }\\n\\n    #region Gambling Boss\\n\\n    private void CheckGamblingBoss()\\n    {\\n        if (timeLeftLabel == null || monsterIcon == null || rallyBtn == null)\\n            return;\\n\\n        rallyBtn.onClick.Clear();\\n        EventDelegate.Add(rallyBtn.onClick, OnRallyBtn);\\n\\n        timeLeftLabel.gameObject.SetActive(_showTime);\\n        if (_showTime)\\n        {\\n            OnSecondTime(NetServerTime.Instance.ServerTimestamp);\\n            Oscillator.Instance.secondEvent += OnSecondTime;\\n        }\\n        else\\n        {\\n            rallyBtn.gameObject.SetActive(false);\\n        }\\n\\n        if (shareBtn)\\n        {\\n            shareBtn.gameObject.SetActive(_showTime && PlayerData.inst.allianceId != AllianceData.INVALID_ID);\\n        }    \\n    }\\n    \\n    private void InitGamblingBossUI()\\n    {\\n        if (_tileData == null)\\n        {\\n            return;\\n        }\\n\\n        _gamblingBossTipsLabel.text = Utils.XLAT_Extend(\\"chestmon_monster_dialogue_4\\");\\n        attackBtn.gameObject.SetActive(false);\\n        gotoBtn.gameObject.SetActive(false);\\n        rallyBtn.gameObject.SetActive(true);\\n        Utils.SetActive(btnAssemble.gameObject,false);\\n\\n        labelX.text = _targetLocation.X.ToString();\\n        labelY.text = _targetLocation.Y.ToString();\\n        \\n\\n        //\\n        var gamblingBossData = DBManager.Instance.DB_GamblingBossDB.GetGamblingBossData(_tileData.Location.K);\\n        if (gamblingBossData == null)\\n        {\\n            return;\\n        }\\n\\n        var gveBossConfigData = ConfigManager.inst.DB_GveBoss.GetData(gamblingBossData.bossId);\\n        if (gveBossConfigData == null)\\n        {\\n            return;\\n        }\\n        if (title != null)\\n        {\\n            title.text = Utils.XLAT(\\"id_lv\\") + gveBossConfigData.boss_level + \\" \\" + Utils.XLAT(gveBossConfigData.name);\\n        }\\n\\n        //\\n        if (_rallySpiritIcon != null)\\n        {\\n            _rallySpiritIcon.SetActive(true);\\n            InitRallySpiritCost();\\n        }\\n        \\n        NGUITools.SetActive(this.normalTip.gameObject, false);\\n        NGUITools.SetActive(this.powerTrans, false);\\n        if (this._gamblingBossTipsLabel != null)\\n        {\\n            NGUITools.SetActive(this._gamblingBossTipsLabel.gameObject, true);\\n        }\\n        //\\n        mustContainer.ClearAll();\\n        rateContainer.ClearAll();\\n\\n        var mustList = ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(gveBossConfigData.DisplayInevitableGroup);\\n        var rateDrop = ConfigManager2.Instance.DB_DisplayDropMain.GetDatasByGroup(gveBossConfigData.DisplayRandomGroup);\\n\\n        foreach (var item in mustList)\\n        {\\n            mustContainer.AddCell(0, item);\\n        }\\n        \\n        if (rateDrop.Count <= 0)\\n        {\\n            mayTrans.gameObject.SetActive(false);\\n        }\\n        \\n        foreach (var item in rateDrop)\\n        {\\n            rateContainer.AddCell(0, item);\\n        }\\n        \\n        mustContainer.UpdateImmediately();\\n        rateContainer.UpdateImmediately();\\n    }\\n\\n    private void InitRallySpiritCost()\\n    {\\n        var gamblingBossData = DBManager.Instance.DB_GamblingBossDB.GetGamblingBossData(_tileData.Location.K);\\n        var curGamblingCompetitionInfo = GamblingBossManager.Instance.GetCurGamblingCompetitionInfo();\\n        if (gamblingBossData == null || curGamblingCompetitionInfo == null)\\n        {\\n            return;\\n        }\\n\\n        var rallyCost = curGamblingCompetitionInfo.StrengthSpendKing;\\n        _rallySpiritLabel.text = rallyCost.ToString();\\n            \\n        var heroDB = DBManager.Instance.DB_hero.Get(PlayerData.inst.cityId);\\n        if (heroDB == null)\\n        {\\n            return;\\n        }\\n        \\n        _rallySpiritLabel.text = rallyCost.ToString()+\\"/\\"+heroDB.spirit;\\n        _rallySpiritLabel.color = heroDB.spirit < rallyCost ? Color.red : Color.white;\\n    }\\n    \\n    private void RallyGamblingBoss()\\n    {\\n        OnCloseButtonPress();\\n\\n        if (_tileData == null)\\n        {\\n            return;\\n        }\\n        \\n        if (!GamblingBossManager.Instance.ActivityCanJoin(_tileData.Location.K) || !GamblingBossManager.Instance.GamblingBossTileIsValid(_tileData))\\n        {\\n            return;\\n        }\\n        \\n        var gamblingBossData = DBManager.Instance.DB_GamblingBossDB.GetGamblingBossData(_tileData.Location.K);\\n        var curGamblingCompetitionInfo = GamblingBossManager.Instance.GetCurGamblingCompetitionInfo();\\n        if (gamblingBossData == null || curGamblingCompetitionInfo == null)\\n        {\\n            return;\\n        }\\n\\n        var rallyCost = (int)curGamblingCompetitionInfo.StrengthSpendKing;\\n\\n        //\\n        if(PlayerData.inst.heroData.spirit < rallyCost)\\n        {\\n            Utils.ShowException(1200050);\\n            return;\\n        }\\n        \\n        UIManager.inst.OpenDlgAsync(UIManager.DialogType.sendMarchDlg, new MarchAllocDlg.Parameter()\\n        {\\n            Location = _tileData.Location,\\n            MarchType = MarchType.StartGveRally,\\n            TileType = _tileData.TileType,\\n            EnergyCost = rallyCost,\\n        });\\n    }\\n    \\n    private void TickGamblingBossInfo()\\n    {\\n        if (timeLeftLabel == null || _tileData == null)\\n            return;\\n\\n        var worldId = _tileData.Location.K;\\n        var gamblingBossData = DBManager.Instance.DB_GamblingBossDB.GetGamblingBossData(worldId);\\n        if (gamblingBossData == null)\\n        {\\n            return;\\n        }\\n\\n        //非到达状态,主动关闭界面\\n        var state = GamblingBossManager.Instance.GetGamblingBossDevilState();\\n        if (state != GamblingBossDevilState.Arrive)\\n        {\\n            UIManager.inst.CloseDlg();\\n            return;\\n        }\\n        \\n        var lastExistTime = GamblingBossManager.Instance.GetDevilArriveExistTime(worldId);\\n        if (lastExistTime > 0)\\n        {\\n            timeLeftLabel.text = Utils.XLAT_Extend(\\"chestmon_survival_time\\", Utils.FormatTime(lastExistTime));\\n        }\\n        else\\n        {\\n            timeLeftLabel.text = \\"\\";\\n        }\\n    }\\n    \\n    #endregion\\n\\n    private void SetBgUI()\\n    {\\n        return;\\n        if (IsRadarMonster())\\n        {\\n            Utils.SetActive(bg, false);\\n            Utils.SetActive(bg_s9, true);\\n        }\\n        else\\n        {\\n            Utils.SetActive(bg, true);\\n            Utils.SetActive(bg_s9, false);\\n        }\\n    }\\n\\n    #region 野怪首杀\\n    \\n    public void UpdateFirstKill()\\n    {\\n        bool isV209 = NewGroupManager.Instance.IsV209RatioServer;\\n        if (isV209 && !PlayerData.inst.IsInFantasyWorld && PlayerData.inst != null && PlayerData.inst.userData != null)\\n        {\\n            WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n            if (null != info)\\n            {\\n                int lev = (int) info.EncounterLevel;\\n                bool isFirstKillCanReward = PlayerData.inst.userData.monster_level < lev;\\n                if (isFirstKillCanReward)\\n                {\\n                    if (_firstKillContainer != null)\\n                    {\\n                        _firstKillContainer.ClearAll();\\n                        var rewards = info.FBReward.GetRewards();\\n                        if (rewards != null && rewards.Count > 0)\\n                        {\\n                            Utils.SetActive(_firstKillReward, true);\\n                            _firstKillContainer.AddCellList(rewards.Count);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n    }\\n    \\n    public void OnRefreshFirstKillCell(int cellIndex, GameObject cell, object userData)\\n    {\\n        var itemStaticInfoComponent = cell.GetComponent<ItemStaticInfoComponent>();\\n        if (itemStaticInfoComponent != null)\\n        {\\n            WorldEncounterInfo info = ConfigManager2.Instance.DB_WorldEncounter.GetData(GetWorldEncounterId());\\n            if (info != null && info.FBReward != null)\\n            {\\n                var rewards = info.FBReward.GetRewards();\\n                if (rewards != null && rewards.Count > cellIndex && cellIndex >= 0)\\n                {\\n                    var item = Config2.ConfigManager2.Instance.DB_Itemlist.Get(rewards[cellIndex].internalID);\\n                    if (item != null)\\n                        itemStaticInfoComponent.SetData(item, rewards[cellIndex].value);\\n                }\\n            }\\n        }\\n    }\\n    \\n        \\n    #endregion\\n}\\n\\n```\\n\\n## 检查 Skill\\n\\n### Game\\\\.agents\\\\skills\\\\unity-code-review\\\\SKILL.md\\n\\n````markdown\\n---\\nname: unity-code-review\\ndescription: Reviews Unity C# code against Unity\'s official style guide. Supports local git diff and GitHub PR review.\\nargument-hint: [file | diff | PR_URL]\\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\\n---\\n\\n# Unity Code Review Skill\\n\\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\\n\\n## Trigger Conditions\\n\\nThis skill activates when:\\n\\n- User invokes `/unity-code-review` with a file or diff.\\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\\n\\n## Review Modes\\n\\n### Local Git Diff Review\\n\\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\\n\\n### GitHub PR Review\\n\\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\\n\\n## Unity C# Style Guide Core Rules\\n\\n### Naming Conventions\\n\\n| Type | Rule | Example |\\n| --- | --- | --- |\\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\\n| Local Variables | camelCase | `playerPosition`, `damage` |\\n\\nAvoid:\\n\\n- Single letter names except loop counters.\\n- Hungarian notation.\\n- Vague names such as `data`, `temp`, or `manager`.\\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\\n\\n### Single Responsibility\\n\\n- Each MonoBehaviour should have one clear engine-facing responsibility.\\n- Keep gameplay logic testable outside Unity where practical.\\n- Avoid boolean flag parameters when separate methods communicate intent better.\\n- Keep methods small enough to review and test.\\n\\n### Comments\\n\\n- Comments should explain why, not what.\\n- Public APIs may use XML documentation.\\n- Do not leave commented-out code or stale TODOs.\\n\\n## Unity-Specific Review Focus\\n\\n### MonoBehaviour Lifecycle\\n\\n- Use `Awake` for local initialization and component caching.\\n- Use `Start` only for initialization that depends on other objects being ready.\\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\\n\\n### Coroutine and Async Patterns\\n\\n- Store coroutine references when cancellation is needed.\\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\\n- Stop async work when the owning object is disabled or destroyed.\\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\\n\\n### Unity API Misuse\\n\\n| Issue | Correct Approach |\\n| --- | --- |\\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\\n| `tag == \\"Enemy\\"` | use `CompareTag()` |\\n| allocating physics queries | use non-alloc APIs where appropriate |\\n| frequent `Instantiate` / `Destroy` | use object pooling |\\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\\n\\n### Performance Concerns\\n\\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\\n- Avoid LINQ and string concatenation in hot paths.\\n- Cache repeated lookups and temporary collections where appropriate.\\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\\n\\n### Testing\\n\\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\\n- Use Unity Test Framework for engine-dependent behavior.\\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\\n\\n## Review Workflow\\n\\n1. Run `git diff` or inspect the specified file / PR diff.\\n2. Read full changed files and nearby related files for context.\\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\\n4. Lead with correctness, runtime risk, and missing validation.\\n5. Keep findings actionable and cite exact files.\\n\\n## Review Output Format\\n\\n```markdown\\n## Code Review: [scope]\\n\\n### Findings\\n\\n1. **Issue title** (`path/to/file.cs`)\\n   - What is wrong.\\n   - Why it matters.\\n   - Suggested fix.\\n\\n### Open Questions\\n\\n- Any assumptions or unclear ownership.\\n\\n### Test Gaps\\n\\n- Validation that is missing or could not be run.\\n```\\n\\n## Related Agents\\n\\n- unity-reviewer\\n\\n## Related Commands\\n\\n- unity-review\\n\\n## Common Code Smells\\n\\n| Code Smell | Description | Fix |\\n| --- | --- | --- |\\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\\n| Inflexibility | Small change requires many changes | Check SRP violations |\\n| Fragility | Minor change breaks everything | Review dependencies |\\n| Immobility | Code not reusable elsewhere | Decouple logic |\\n| Duplicate code | Copy-pasted logic | Extract core functionality |\\n| Excessive commentary | Comments for every line | Use better names, trust the code |\\n\\n````"}]',)
