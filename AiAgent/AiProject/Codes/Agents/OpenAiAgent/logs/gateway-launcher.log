n                        bi[\"task_id\"] = _questData.TaskCor.ToShortString();\n                        bi[\"type\"] = 4;\n                        FunplusBi.Instance.TraceAction(\"intelligence\", Utils.Object2Json(bi));\n                    }\n\n                    string judgeId = _questConfigInfo.Parameter;\n                    if (!string.IsNullOrEmpty(judgeId))\n                    {\n                        var param = new LawPopup.Parameter\n                        {\n                            taskInfo = _questConfigInfo\n                        };\n                        UIManager.inst.OpenPopupAsync(UIManager.PopupType.LawsuitPopup, param);\n                    }\n\n                    break;\n                }\n                case IntelligenceQuestType.Pvp: //PVP\n                {\n                    GoToMapLocation(checkGameMode, () =>\n                    {\n                        PVPMap.PendingGotoRequest = _questData.TaskCor;\n                        FakeMonsterManager.Instance.FakeMonsterTask(_questData, FakeMonsterManager.FakeMonsterTypeEnum.Intelligence, _questConfigInfo);\n                    });\n\n                    break;\n                }\n                case IntelligenceQuestType.Help://帮助盟友\n                {\n                    IntelligenceManager.Instance.RequestGetHelpUidXY(_questData.RadarContent.to_help_uid, _questData.QuestId, (ret, coord) =>\n                    {\n                        if (ret)\n                        {\n                            GoToMapLocation(checkGameMode, () =>\n                            {\n                                _questData.UpdateTaskCor(coord);\n                                FakeMonsterManager.Instance.FakeMonsterTask(_questData, FakeMonsterManager.FakeMonsterTypeEnum.Intelligence, _questConfigInfo);\n                                ServerRelocationManager.Instance.GoToOtherLocation(coord);\n                                PVPMap.PendingGotoRequest = coord;\n                                PVPMap.ShowCircle = true;\n                                PVPMap.CircleLocation = PVPMap.PendingGotoRequest;\n                            });\n                        }\n                        else\n                        {\n                            if (_questConfigInfo != null)\n                            {\n                                Hashtable data = new Hashtable();\n                                data[\"uid\"] = PlayerData.inst.uid;\n                                data[\"quest_id\"] = _questConfigInfo.InternalId;\n                                RequestManager.Instance.SendRequest(PortType.RADAR_TASK_QUEST_DONE, data, (ret, obj) => \n                                {\n                                    MessageBroker.Default.Publish(new IntelligenceCloseQuestDetailEvt());\n                                });\n                            }\n                        }\n                    });\n                }\n                    break;\n                case IntelligenceQuestType.Gve_win: //集结攻击\n                {\n                    SearchGve();\n                    break;\n                }\n                case IntelligenceQuestType.Red_bag: //挖宝\n                {\n                    if (_questData.RadarContent.x == 0 && _questData.RadarContent.y == 0)\n                    {\n                        Hashtable data = new Hashtable();\n                        data[\"questId\"] = _questData.QuestId;\n                        RequestManager.Instance.SendRequest(PortType.RARAR_GET_TREASURE_TILE, data, (ret, obj) => \n                        {\n                            if (!ret) return;\n\n                            checkGameMode = MapUtils.GetGameModeByK(_questData.TaskCor.K);\n                            GoToMapLocation(checkGameMode, () =>\n                            {\n                                var coord = _questData.RadarContent.coordinate;\n                                ServerRelocationManager.Instance.GoToOtherLocation(coord);\n                                PVPMap.PendingGotoRequest = coord;\n                                PVPMap.ShowCircle = true;\n                                PVPMap.CircleLocation = PVPMap.PendingGotoRequest;\n                            });\n                        });\n                    }\n                    else\n                    {\n                        GoToMapLocation(checkGameMode, () =>\n                        {\n                            var coord = _questData.RadarContent.coordinate;\n                            ServerRelocationManager.Instance.GoToOtherLocation(coord);\n                            PVPMap.PendingGotoRequest = coord;\n                            PVPMap.ShowCircle = true;\n                            PVPMap.CircleLocation = PVPMap.PendingGotoRequest;\n                        });\n                    }\n                    \n                    break;\n                }\n                case IntelligenceQuestType.Resource_Collect://资源采集\n                {\n                    if (_questData.RadarContent.x == 0 && _questData.RadarContent.y == 0)\n                    {\n                        Hashtable data = new Hashtable();\n                        data[\"questId\"] = _questData.QuestId;\n                        RequestManager.Instance.SendRequest(PortType.RARAR_GET_TREASURE_TILE, data, (ret, obj) => \n                        {\n                            if (!ret) return;\n                            checkGameMode = MapUtils.GetGameModeByK(_questData.TaskCor.K);\n                            GoToMapLocation(checkGameMode, () =>\n                            {\n                                var coord = _questData.RadarContent.coordinate;\n                                ServerRelocationManager.Instance.GoToOtherLocation(coord);\n                                PVPMap.PendingGotoRequest = coord;\n                                PVPMap.ShowCircle = true;\n                                PVPMap.CircleLocation = PVPMap.PendingGotoRequest;\n                            });\n                        });\n                    }\n                    else\n                    {\n                        GoToMapLocation(checkGameMode, () =>\n                        {\n                            var coord = _questData.RadarContent.coordinate;\n                            ServerRelocationManager.Instance.GoToOtherLocation(coord);\n                            PVPMap.PendingGotoRequest = coord;\n                            PVPMap.ShowCircle = true;\n                            PVPMap.CircleLocation = PVPMap.PendingGotoRequest;\n                        });\n                    }\n                    \n                    break;\n                }\n            }\n        }\n\n        private void OnPrivilegeUnlockTouched()\n        {\n            if (NewGroupManager.Instance.IsOnlyInV209ServerRange\n                && _questConfigInfo.BaseType == (int)IntelligenceQuestBaseType.RatioMonthCard\n                && !RatioMonthCardManager.Instance.HaveCard)\n            {\n                UIManager.inst.CloseAllDlgAndPopup();\n                UIManager.inst.OpenDlgAsync(UIManager.DialogType.IapCenterDialog, new IapCenterDlg.Parameter\n                {\n                    TagType = IapCenterView.TagType.RatioMonthCard,\n                    OpenTrace = OperationTrace.OpenTrace.PublicHUD\n                });\n            }\n        }\n\n        #endregion\n\n        private void StartRequsetData()\n        {\n            FakeMonsterManager.Instance.FakeMonsterTask(_questData, FakeMonsterManager.FakeMonsterTypeEnum.Intelligence,\n                _questConfigInfo);\n            \n            if (_questConfigInfo != null)\n            {\n                TileType targetType = TileType.Fake_Level_Monster;\n                switch ((IntelligenceQuestType)_questConfigInfo.Type)\n                {\n                    case IntelligenceQuestType.Pve_win:\n                        targetType = TileType.Fake_Slg_Monster;\n                        break;\n                    case IntelligenceQuestType.Rescue:\n                        targetType = TileType.Fake_Rescue_Monster;\n                        break;\n                    case IntelligenceQuestType.Tower:\n                        targetType = TileType.Fake_Level_Monster;\n                        break;\n                }\n                \n                var map = PVPSystem.Instance != null ? PVPSystem.Instance.Map : null;\n                if (map != null)\n                    Utils.StartCoroutine(map, map.AutoOpenMapMonsterPanel(_questData.TaskCor, targetType));\n            }\n        }\n\n        void StopCoroutine()\n        {\n            if (m_Coroutine != null)\n            {\n                Utils.StopCoroutine(m_Coroutine);\n                m_Coroutine = null;\n            }\n        }\n\n        private void SearchGve()\n        {\n            UIManager.inst.CloseAllDlgAndPopup();\n            if (PlayerData.inst.IsInFantasyWorld)\n            {\n                if (GameEngine.Instance.CurrentGameMode != GameEngine.GameMode.FantasyMode)\n                {\n                    UIManager.inst.Cloud.CoverCloud(delegate\n                    {\n                        GameEngine.Instance.CurrentGameMode = GameEngine.GameMode.FantasyMode;\n                        PVPMap.PendingGotoRequest = PlayerData.inst.playerCityData.cityLocation;\n                        Utils.StartCoroutine(SearchRangeLevelGve(1));\n                    });\n                }\n                else\n                {\n                    Utils.StartCoroutine(SearchRangeLevelGve(0));\n                }\n            }\n            else\n            {\n                if (GameEngine.Instance.CurrentGameMode != GameEngine.GameMode.PVPMode)\n                {\n                    UIManager.inst.Cloud.CoverCloud(delegate\n                    {\n                        GameEngine.Instance.CurrentGameMode = GameEngine.GameMode.PVPMode;\n                        PVPMap.PendingGotoRequest = PlayerData.inst.playerCityData.cityLocation;\n                        Utils.StartCoroutine(SearchRangeLevelGve(1));\n                    });\n                }\n                else\n                {\n                    Utils.StartCoroutine(SearchRangeLevelGve(0));\n                }\n            }\n        }\n\n        private IEnumerator SearchRangeLevelGve(int s)\n        {\n            IntelligenceManager.Instance.SearchSuccess = false;\n            SearchItemManger.Instance.SetTileData();\n           \n            yield return new WaitForSeconds(s);\n\n            var mode = PlayerData.inst.IsInFantasyWorld ? GameEngine.GameMode.FantasyMode : GameEngine.GameMode.PVPMode;\n            var type = (int)TileType.GveCamp;\n            var max = SearchItemManger.Instance.GetSearchResourceMaxLevel(type, mode);\n            var v = PlayerData.inst.playerCityData.level;\n            var fantasyUser = DBManager.Instance.DB_FantasyUser.Get(PlayerData.inst.uid);\n\n            if (PlayerData.inst.IsInFantasyWorld)\n            {\n                v = fantasyUser?.AntiMagic ?? 0;\n                if (AstrolabeTalentManager.Instance.IsIncreaseAntiMagicAttackPVEMonsterOrGVEMonster())\n                {\n                    if (AstrolabeTalentManager.Instance.GetIncreaseAntiMagicAttackPVEMonsterOrGVEMonsterValue(out long n))\n                    {\n                        v += n;\n                    }\n                }\n            }\n\n            var minLevel = (int)Mathf.Clamp(v - 5,0, max);\n            var maxLevel = (int)Mathf.Clamp(v + 5,0, max);\n            \n            for (long i = minLevel; i <= maxLevel; i++)\n            {\n                var level = i;\n                bool success = false;\n                \n                SearchMainData mainData =\n                    ConfigManager.inst.DB_ConfigWorldSearchMain.GetSearchData(type, level);\n\n                if (mainData == null) continue;\n                \n                SearchItemManger.Instance.PrepareTileData(PlayerData.inst.CityData.Location, type,\n                    level, mainData.SearchTileNum, mainData.CanCreate, state =>\n                    {\n                        if (state == SearchState.SearchSuccess)\n                        {\n                            success = true;\n                            Goto();\n                        }\n                    });\n                if (success)\n                {\n                    yield break;\n                }\n            }\n            \n            minLevel = (int)Mathf.Clamp(v - 10,0, max);\n            maxLevel = (int)Mathf.Clamp(v + 10,0, max);\n            \n            for (long i = minLevel; i <= maxLevel; i++)\n            {\n                var level = i;\n                bool success = false;\n                \n                SearchMainData mainData =\n                    ConfigManager.inst.DB_ConfigWorldSearchMain.GetSearchData(type, level);\n\n                if (mainData == null) continue;\n                \n                SearchItemManger.Instance.PrepareTileData(PlayerData.inst.CityData.Location, type,\n                    level, mainData.SearchTileNum, mainData.CanCreate, state =>\n                    {\n                        if (state == SearchState.SearchSuccess)\n                        {\n                            success = true;\n                            Goto();\n                        }\n                    });\n                if (success)\n                {\n                    yield break;\n                }\n            }\n\n            GoToMapLocation(mode, () =>\n            {\n                PVPMap.PendingGotoRequest = PlayerData.inst.playerCityData.cityLocation;\n            });\n            UIManager.inst.toast.Show(Utils.XLAT(\"map_search_no_monster\"));\n        }\n\n        void Goto()\n        {\n            var mode = PlayerData.inst.IsInFantasyWorld ? GameEngine.GameMode.FantasyMode : GameEngine.GameMode.PVPMode;\n            SearchTileData result = SearchItemManger.Instance.GetJumpCoordinate();\n\n            if (result == null) return;\n            \n            GoToMapLocation(mode, () =>\n                    {\n                        var coord = result.Location;\n                        ServerRelocationManager.Instance.GoToOtherLocation(coord);\n                        PVPMap.PendingGotoRequest = coord;\n                        PVPMap.ShowCircle = true;\n                        PVPMap.CircleLocation = PVPMap.PendingGotoRequest;\n                        // Utils.StartCoroutine(PVPSystem.Instance.Map.AutoOpenMapMonsterPanel(result.Location, (TileType)result.Type));\n                    });\n            // PVPSystem.Instance.Map.GotoLocation(result.Location, false); //  镜头跳转\n            // Utils.StartCoroutine(PVPSystem.Instance.Map.AutoOpenMapMonsterPanel(result.Location, (TileType)result.Type));\n        }\n        private Coordinate GetMyLocation()\n        {\n            Coordinate gotoLocation = PVPMap.PendingGotoRequest.K != 0\n                ? PVPMap.PendingGotoRequest\n                : PlayerData.inst.playerCityData.cityLocation;\n\n            return gotoLocation;\n        }\n        void GoToMapLocation(GameEngine.GameMode checkGameMode, System.Action callback)\n        {\n            if (GameEngine.Instance.CurrentGameMode != checkGameMode)\n            {\n                UIManager.inst.Cloud.CoverCloud(delegate\n                {\n                    GameEngine.Instance.CurrentGameMode = checkGameMode;\n                    if (null != _questData)\n                    {\n                        PVPMap.PendingGotoRequest = _questData.TaskCor;\n                    }\n                    // if (PVPSystem.Instance.IsAvailable && PVPSystem.Instance.Map != null)\n                    // {\n                    //     PVPSystem.Instance.Map.GotoLocation(GetMyLocation(), false);\n                    // }\n                    StopCoroutine();\n                    m_Coroutine = Utils.StartCoroutine(StartGoToMapLocationCoroution(callback));\n                });\n            }\n            else\n            {   \n                callback?.Invoke();\n            }\n        }\n\n        private IEnumerator StartGoToMapLocationCoroution(System.Action callback)\n        {\n            var checkGameMode = MapUtils.GetGameModeByK(_questData.TaskCor.K);\n\n            yield return new WaitUntil(() =>\n            {\n                return GameEngine.Instance.CurrentGameMode == checkGameMode;\n            });\n\n            callback?.Invoke();\n\n            StopCoroutine();\n        }\n    }\n}\n```\n\n## 检查 Skill\n\n### Game\\.agents\\skills\\unity-code-review\\SKILL.md\n\n````markdown\n---\nname: unity-code-review\ndescription: Reviews Unity C# code against Unity's official style guide. Supports local git diff and GitHub PR review.\nargument-hint: [file | diff | PR_URL]\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\n---\n\n# Unity Code Review Skill\n\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\n\n## Trigger Conditions\n\nThis skill activates when:\n\n- User invokes `/unity-code-review` with a file or diff.\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\n\n## Review Modes\n\n### Local Git Diff Review\n\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\n\n### GitHub PR Review\n\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\n\n## Unity C# Style Guide Core Rules\n\n### Naming Conventions\n\n| Type | Rule | Example |\n| --- | --- | --- |\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\n| Local Variables | camelCase | `playerPosition`, `damage` |\n\nAvoid:\n\n- Single letter names except loop counters.\n- Hungarian notation.\n- Vague names such as `data`, `temp`, or `manager`.\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\n\n### Single Responsibility\n\n- Each MonoBehaviour should have one clear engine-facing responsibility.\n- Keep gameplay logic testable outside Unity where practical.\n- Avoid boolean flag parameters when separate methods communicate intent better.\n- Keep methods small enough to review and test.\n\n### Comments\n\n- Comments should explain why, not what.\n- Public APIs may use XML documentation.\n- Do not leave commented-out code or stale TODOs.\n\n## Unity-Specific Review Focus\n\n### MonoBehaviour Lifecycle\n\n- Use `Awake` for local initialization and component caching.\n- Use `Start` only for initialization that depends on other objects being ready.\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\n\n### Coroutine and Async Patterns\n\n- Store coroutine references when cancellation is needed.\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\n- Stop async work when the owning object is disabled or destroyed.\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\n\n### Unity API Misuse\n\n| Issue | Correct Approach |\n| --- | --- |\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\n| `tag == \"Enemy\"` | use `CompareTag()` |\n| allocating physics queries | use non-alloc APIs where appropriate |\n| frequent `Instantiate` / `Destroy` | use object pooling |\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\n\n### Performance Concerns\n\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\n- Avoid LINQ and string concatenation in hot paths.\n- Cache repeated lookups and temporary collections where appropriate.\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\n\n### Testing\n\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\n- Use Unity Test Framework for engine-dependent behavior.\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\n\n## Review Workflow\n\n1. Run `git diff` or inspect the specified file / PR diff.\n2. Read full changed files and nearby related files for context.\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\n4. Lead with correctness, runtime risk, and missing validation.\n5. Keep findings actionable and cite exact files.\n\n## Review Output Format\n\n```markdown\n## Code Review: [scope]\n\n### Findings\n\n1. **Issue title** (`path/to/file.cs`)\n   - What is wrong.\n   - Why it matters.\n   - Suggested fix.\n\n### Open Questions\n\n- Any assumptions or unclear ownership.\n\n### Test Gaps\n\n- Validation that is missing or could not be run.\n```\n\n## Related Agents\n\n- unity-reviewer\n\n## Related Commands\n\n- unity-review\n\n## Common Code Smells\n\n| Code Smell | Description | Fix |\n| --- | --- | --- |\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\n| Inflexibility | Small change requires many changes | Check SRP violations |\n| Fragility | Minor change breaks everything | Review dependencies |\n| Immobility | Code not reusable elsewhere | Decouple logic |\n| Duplicate code | Copy-pasted logic | Extract core functionality |\n| Excessive commentary | Comments for every line | Use better names, trust the code |\n\n````"}], "stream": true, "store": false, "reasoning": {"effort": "low"}}
