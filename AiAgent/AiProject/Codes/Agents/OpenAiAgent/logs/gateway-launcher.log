 GemData _curGemData;\n    \n    private List<AvalonArtifactBenefitTipComponent> _componentList = new List<AvalonArtifactBenefitTipComponent>();\n\n    private bool _refreshRequireSVLatout;\n    private bool _upgradeGemSuccess = false;\n    private long _upgrageGemId = 0;\n    private long _enhanceSourceConfigId = 0;\n    private bool _init = false;\n    \n    private Action<GemData> _completeEnhanceGemCb;\n    private Action<long, long> _onClickEnhanceBtn;\n    private Action<GemData> _triggerCloseView;\n\n    private void Awake()\n    {\n        if (null != _needMaterialsContainer)\n        {\n            _needMaterialsContainer.OnRefreshCell -= OnRefreshNeedMaterialCell;\n            _needMaterialsContainer.OnRefreshCell += OnRefreshNeedMaterialCell;\n        }\n        \n        if (null != GemManager.Instance.OnResponseUpgradeGem)\n        {\n            GemManager.Instance.OnResponseUpgradeGem -= OnResponseUpgradeGem;\n            GemManager.Instance.OnResponseUpgradeGem += OnResponseUpgradeGem;\n        }\n        \n        UIEventListener.Get(_enhanceBtn).onClick = OnConfirmClick;\n        InitTargetGemButtons();\n    }\n    public void Show(GemData curGemData,\n        Action exitViewCb,\n        Action<GemData> completeEnhanceGemCb,\n        Action<long, long> onClickEnhanceBtn,\n        Action<GemData> triggerCloseView)\n    {\n        base.Show(exitViewCb);\n\n        _curGemData = curGemData;\n        _completeEnhanceGemCb = completeEnhanceGemCb;\n        _onClickEnhanceBtn = onClickEnhanceBtn;\n        _triggerCloseView = triggerCloseView;\n        // 每次进入强化时按当前宝石重置目标，避免沿用上次的选择。\n        _targetGemInfos = null;\n        _targetGemIndex = 0;\n        Init();\n    }\n\n    private void Init()\n    {\n        // if (_needMaterialsContainer != null)\n        // {\n        //     _needMaterialsContainer.OnRefreshCell -= OnRefreshNeedMaterialCell;\n        //     _needMaterialsContainer.OnRefreshCell += OnRefreshNeedMaterialCell;\n        // }\n        // UIEventListener.Get(_enhanceBtn).onClick = OnConfirmClick;\n        // GemManager.Instance.OnResponseUpgradeGem += OnResponseUpgradeGem;\n\n        _avalonArtifactManager = AvalonArtifactManager.GetInstance(AvalonType.Gem);\n        _poolBenefit.Initialize(_prefabBenefitComponent.gameObject, _gridBenefit.gameObject);\n        UpdateUi();\n        SetObjActived(true);\n    }\n\n    private void RequirementsCreateCb()\n    {\n        if (_requireSV)\n        {\n            _requireSV.ResetPosition();\n        }\n    }\n    \n    public void RefreshPage(EquipmentGemSlotItemDataVO.GemSlotItemDataVO targetGem)\n    {\n        UpdateUi();\n    }\n\n    private void UpdateUi()\n    {\n        _avalonInfo = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n        if (_avalonInfo == null)\n        {\n            return;\n        }\n\n        _itemInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(_avalonInfo.ItemID);\n        if (_itemInfo == null)\n        {\n            return;\n        }\n\n        RefreshTargetGemInfos();\n        _nextArtifactInfo = GetTargetGemInfo();\n        // 未开放下一级时仍刷新当前宝石预览，提交按钮由开放目标决定。\n        if (_nextArtifactInfo == null && _avalonInfo is EquipmentGemInfo currentGemInfo)\n            _nextArtifactInfo = currentGemInfo.NextLevelInfo;\n        if (_nextArtifactInfo == null)\n        {\n            return;\n        }\n\n        _nextItemInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(_nextArtifactInfo.ItemID);\n        if (_nextItemInfo == null)\n        {\n            return;\n        }\n\n        UpdateIcons();\n        UpdateBenefits();\n        UpdateRequirements();\n        UpdateBtnStatus();\n    }\n\n    private void UpdateIcons()\n    {\n        SetGemIconInfo(_iconFrom, _itemInfo.ImagePath, _avalonInfo, _itemInfo.LocName);\n        SetGemIconInfo(_iconTo, _itemInfo.ImagePath, _nextArtifactInfo, _nextItemInfo.LocName);\n    }\n\n    private void UpdateGemScore()\n    {\n        if (!GemManager.Instance.IsShowGemScore())\n            return;\n        \n        if (_avalonInfo != null && _nextArtifactInfo != null)\n        {\n            var component = _poolBenefit.AddChild(_gridBenefit.gameObject)\n                .GetComponent<AvalonArtifactBenefitTipComponent>();\n\n            long score1 = GemManager.Instance.GetGemScore(_avalonInfo.InternalID);\n            long score2 = GemManager.Instance.GetGemScore(_nextArtifactInfo.InternalID);\n            \n            string title = Utils.XLAT(GemConst.GemScoreTitle);\n            string score1Str = Utils.FormatThousands(score1);         \n            string score2Str = Utils.FormatThousands(score2);\n\n            component.ShowContent(title, score1Str, score2Str);\n            _componentList.Add(component);\n            Utils.SetActive(component.gameObject, true);\n        }\n    }\n    \n    //???宝石修改\n    private void UpdateBenefits()\n    {\n        if (null == _componentList)\n        {\n            _componentList = new List<AvalonArtifactBenefitTipComponent>();\n        }\n        else\n        {\n            foreach (var component in _componentList)\n            {\n                if (null != component)\n                {\n                    _poolBenefit.Release(component.gameObject);\n                }\n            }\n            _componentList.Clear();\n        }\n\n        UpdateGemScore();\n\n        if (_avalonInfo != null && _nextArtifactInfo != null)\n        {\n            var list = _avalonInfo.GetBenefits();\n            var nextList = _nextArtifactInfo.GetBenefits();\n            for (var i = 0; i < list.Count; ++i)\n            {\n                var pair = list[i];\n                var nextPair = nextList.Find(p =>p.internalID == pair.internalID);\n\n                if (nextPair != null && (pair.value != 0 || nextPair.value != 0))\n                {\n                    var component = _poolBenefit.AddChild(_gridBenefit.gameObject)\n                        .GetComponent<AvalonArtifactBenefitTipComponent>();\n                \n                    component.SetData(_avalonInfo, i, pair, nextPair);\n                    _componentList.Add(component);\n                    Utils.SetActive(component.gameObject, true);\n                }\n            }\n        }\n\n        if (_gridBenefit)\n        {\n            _gridBenefit.enabled = true;\n            _gridBenefit.Reposition();\n        }\n    }\n\n    private void UpdateRequirements()\n    {\n        if (_needMaterialsContainer == null)\n            return;\n\n        EquipmentGemInfo current = _avalonInfo as EquipmentGemInfo;\n        if (current == null)\n            return;\n\n        _needMaterialsContainer.ClearAll();\n        List<Materials.MaterialElement> needMaterials =\n            GetTargetGemUpgradeMaterialElements(current, GetTargetGemInfo());\n        foreach (var item in needMaterials)\n        {\n            if (item.amount > 0)\n            {\n                _needMaterialsContainer.AddCell(0, item);\n            }\n        }\n        _needMaterialsContainer.OnAllLoadCallBack = RequirementsCreateCb;\n    }\n\n    private void UpdateBtnStatus()\n    {\n        if (_curGemData == null)\n            return;\n\n        var isMaxLv = GemIsMaxLv(_curGemData);\n        _enhanceBtnContext.text = Utils.XLAT(isMaxLv ? \"gem_update_gem_replace_max_level_button\" : \"forge_equipment_enhance_button\");\n        bool canEnhance = !isMaxLv && GetTargetGemInfo() != null;\n        GreyUtility.SetGrey(_enhanceBtn, !canEnhance);\n        Utils.EnableNGUIControlInteraction(_enhanceBtn, canEnhance);\n    }\n\n    public void SetEnhanceBtnRpActive(bool active)\n    {\n        Utils.SetActive(_enhanceRedPoint, active);\n    }\n\n    private void SetGemIconInfo(AvalonArtifactCraftIconComponent iconCmpt, string path, IHandbookInfo avalonInfo,\n        string gemName)\n    {\n        if (iconCmpt == null || avalonInfo == null)\n            return;\n        \n        BuilderFactory.Instance.HandyBuild(iconCmpt.TexIcon, path, useWidgetSetting: true);\n        \n        iconCmpt.LabelName.text = gemName;\n        \n        iconCmpt.LabelName.color = EquipmentManager.Instance.GetColorWithQuality(avalonInfo.ItemInfo.Quality);\n        \n        BuilderFactory.Instance.HandyBuild(iconCmpt.TexFrame, avalonInfo.ItemInfo.QualityImagePath,\n            useWidgetSetting: true);\n        \n        Utils.SetActive(iconCmpt.SpriteScroll.gameObject, false);\n        Utils.SetActive(iconCmpt.SpriteMask.gameObject, false);\n    }\n\n    private void OnRefreshNeedMaterialCell(int cellIndex, GameObject cell, object userData)\n    {\n        Materials.MaterialElement data = userData as Materials.MaterialElement;\n        if (null == data)\n            return;\n\n        ItemStaticInfoComponent com = cell.GetComponent<ItemStaticInfoComponent>();\n        if (null == com)\n            return;\n\n        long curAmount = ItemBag.Instance.GetItemCount(data.internalID);\n        \n        // Materials.MaterialElement elementData = userData as Materials.MaterialElement;\n        // if (elementData != null)\n        // {\n        //     curAmount = ItemBag.Instance.GetItemCount(data.internalID);\n        // }\n\n        Action<long, int> clickCb = null;\n        if (curAmount < data.amount)\n        {\n            clickCb = GetMoreItemCb;\n        }\n\n        com.useFormatShort = true;\n        com.SetRequireInfo(data.internalID, curAmount, data.amount, clickCb);\n    }\n\n    private void SetObjActive(bool active)\n    {\n       gameObject.SetActive(active);\n    }\n\n    public override void Hide()\n    {\n        base.Hide();\n        SetObjActive(false);\n    }\n\n    private void Dispose()\n    {\n        _poolBenefit.Clear();\n        \n        if (_needMaterialsContainer != null)\n        {\n            _needMaterialsContainer.OnRefreshCell -= OnRefreshNeedMaterialCell;\n        }\n        \n        UIEventListener.Get(_enhanceBtn).onClick = null;\n        \n                DisposeTargetGemButtons();\nGemManager.Instance.OnResponseUpgradeGem -= OnResponseUpgradeGem;\n    }\n\n    private void GetMoreItemCb(long itemInternalId, int requireAmount)\n    {\n        if (itemInternalId <= 0)\n            return;\n        \n        _triggerCloseView?.Invoke(_curGemData);\n\n        Dictionary<long, int> require = new Dictionary<long, int> {{itemInternalId, requireAmount}};\n        \n        CommonGetMoreManager.Instance.OpenGetMorePopup(require);\n    }\n\n    private void OnResponseUpgradeGem(long gemId)\n    {\n        if (!gameObject.activeInHierarchy)\n        {\n            return;\n        }\n        \n        _upgrageGemId = gemId;\n        PlayEffect();\n\n        UIManager.inst.ShowEmptyManualBlocker();\n        \n        Observable.Timer(TimeSpan.FromSeconds(1.3)).Subscribe(_ =>\n        {\n            UIManager.inst.HideManualBlocker();\n\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.GemEnhanceSuccessPopup,\n                new GemEnhanceSuccessPopup.Parameter()\n                {\n                    gemID = _upgrageGemId,\n                    sourceConfigId = _enhanceSourceConfigId,\n                });\n\n            if (_completeEnhanceGemCb != null)\n            {\n                GemData gemData = DBManager.Instance.DB_Gems.Get(_upgrageGemId);\n\n                if (gemData != null)\n                {\n                    _completeEnhanceGemCb.Invoke(gemData);\n                }\n            }\n        }).AddTo(this);\n    }\n\n    private void Update()\n    {\n        // if (_upgradeGemSuccess)\n        // {\n        //     _upgradeGemSuccess = false;\n        //\n        //     PlayEffect();\n        //\n        //     UIManager.inst.ShowEmptyManualBlocker();\n        //\n        //     Observable.Timer(TimeSpan.FromSeconds(1.3)).Subscribe(_ =>\n        //     {\n        //         UIManager.inst.HideManualBlocker();\n        //\n        //         UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.GemEnhanceSuccessPopup,\n        //             new GemEnhanceSuccessPopup.Parameter()\n        //             {\n        //                 gemID = _upgrageGemId,\n        //             });\n        //\n        //         if (_completeEnhanceGemCb != null)\n        //         {\n        //             GemData gemData = DBManager.Instance.DB_Gems.Get(_upgrageGemId);\n        //             if (gemData != null)\n        //                 _completeEnhanceGemCb.Invoke(gemData);\n        //         }\n        //     }).AddTo(this);\n        // }\n    }\n\n    private void PlayEffect()\n    {\n        AudioManager.Instance.StopAndPlayVoice(AudioNameConfig.EQUIP_SFX_LIGHT);\n        long count = _needMaterialsContainer.CellCount;\n        \n        for (int i = 0; i < count; i++)\n        {\n            var data = _needMaterialsContainer.GetCellDataByIndex(i);\n            \n            if (data != null && data.CellInstance != null)\n            {\n                var item = data.CellInstance.GetComponent<GemEnhanceEffectCom>();\n                \n                if (item != null && _iconFrom != null)\n                {\n                    item.AddMoveFinishEvent(item.HideFlyEffect);\n                    item.MoveEffectToTarget(_iconFrom.gameObject);\n                }\n            }\n        }\n    }\n\n    private void OnConfirmClick(GameObject go)\n    {\n        if (_avalonArtifactManager == null)\n            return;\n\n        EquipmentGemInfo currentGemInfo = _avalonInfo as EquipmentGemInfo;\n        EquipmentGemInfo targetGemInfo = GetTargetGemInfo();\n        if (currentGemInfo == null || targetGemInfo == null)\n            return;\n\n        // 按预览目标的累计消耗检查库存，不能只判断下一等级材料是否充足。\n        Dictionary<long, int> require = new Dictionary<long, int>();\n        List<Materials.MaterialElement> requires =\n            GetTargetGemUpgradeMaterialElements(currentGemInfo, targetGemInfo);\n        foreach (var t in requires)\n        {\n            var curAmount = ItemBag.Instance.GetItemCount(t.internalID);\n            if (curAmount < t.amount)\n                require.Add(t.internalID, (int)t.amount);\n        }\n\n        if (require.Count < 1)\n        {\n            bool isOpenEnhanceLv5 =\n                ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.ITERATION_ENHANCE_5);\n            if (!isOpenEnhanceLv5 && _avalonArtifactManager.gemData.GemConfig.EnhanceLevel >= 4)\n            {\n                UIManager.inst.toast.Show(Utils.XLAT(\"toast_equip_gem_enhance_5_not_open\"));\n                return;\n            }\n\n            _enhanceSourceConfigId = currentGemInfo != null ? currentGemInfo.InternalID : 0;\n            if (currentGemInfo != null && targetGemInfo != null && _targetGemIndex > 0)\n            {\n                OpenTargetGemConfirm();\n            }\n            else\n            {\n                SubmitTargetGemUpgrade();\n            }\n            return;\n        }\n\n        _triggerCloseView?.Invoke(_curGemData);\n        CommonGetMoreManager.Instance.OpenGetMorePopup(require);\n    }\n    \n    public override void OnClickHideBtn()\n    {\n        Hide();\n    }\n\n    private bool LackRequireMaterials()\n    {\n        IHandbookInfo info = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n        \n        if (null == info)\n            return false;\n\n        EquipmentGemInfo configGemInfo = info as EquipmentGemInfo;\n        \n        if (null == configGemInfo)\n            return false;\n\n        bool lackMaterial = false;\n        foreach (var item in configGemInfo.LevelUpMaterialsNew.GetMaterials())\n        {\n            long curAmount = item != null ? ItemBag.Instance.GetItemCount(item.internalID) : 0;\n            lackMaterial |= curAmount < item.amount;\n        }\n\n        return lackMaterial;\n    }\n\n    private void OnDestroy()\n    {\n        Dispose();\n        UIManager.inst.HideManualBlocker();\n    }\n}\n\n#region Before V12.3\n\n/*\npublic class GemEnhanceDetailPart : GemMainDlgRightPart\n{\n\n    [SerializeField] private AvalonArtifactCraftIconComponent _iconFrom;\n    [SerializeField] private AvalonArtifactCraftIconComponent _iconTo;\n\n    [SerializeField] private AvalonArtifactBenefitTipComponent _prefabBenefitComponent;\n\n    [SerializeField] private UIGrid _gridBenefit;\n\n    private GameObjectPool _poolBenefit = new GameObjectPool();\n    private List<AvalonArtifactBenefitTipComponent> _componentList = new List<AvalonArtifactBenefitTipComponent>();\n\n    [SerializeField] private GameObject _enhanceBtn;\n    [SerializeField] private GameObject _enhanceGemLock;\n    [SerializeField] private UILabel _enhanceBtnContext;\n    [SerializeField] private GameObject _enhanceRedPoint;\n\n    [SerializeField] private UICustomContainer _needMaterialsContainer;\n    [SerializeField] private UIScrollView _requireSV;\n\n    private IHandbookInfo _avalonInfo;\n    private ItemlistInfo _itemInfo;\n    private IHandbookInfo _nextArtifactInfo;\n    private ItemlistInfo _nextItemInfo;\n    private AvalonArtifactManager _avalonArtifactManager;\n    private bool _refreshRequireSVLatout;\n\n    private Action<GemData> _completeEnhanceGemCb;\n    private Action<long, long> _onClickEnhanceBtn;\n    private Action<GemData> _triggerCloseView;\n    \n    private bool _upgradeGemSuccess = false;\n    private long _upgrageGemId = 0;\n    private GemData _curGemData;\n    \n    public void Show(GemData curGemData,\n        Action exitViewCb, \n        Action<GemData> completeEnhanceGemCb,\n        Action<long, long> onClickEnhanceBtn,\n        Action<GemData> triggerCloseView)\n    {\n        base.Show(exitViewCb);\n        _completeEnhanceGemCb = completeEnhanceGemCb;\n        _onClickEnhanceBtn = onClickEnhanceBtn;\n        _curGemData = curGemData;\n        _triggerCloseView = triggerCloseView;\n        \n        Init();\n        UpdateUI();\n    }\n    \n    public override void Hide()\n    {\n        base.Hide();\n        \n        Dispose();\n    }\n    \n    public void Init()\n    {\n        _avalonArtifactManager = AvalonArtifactManager.GetInstance(AvalonType.Gem);\n\n        _poolBenefit.Initialize(_prefabBenefitComponent.gameObject, _gridBenefit.gameObject);           \n\n        if (_needMaterialsContainer != null)\n        {\n            _needMaterialsContainer.OnRefreshCell -= OnRefreshNeedMaterialCell;\n            _needMaterialsContainer.OnRefreshCell += OnRefreshNeedMaterialCell;\n        }\n        \n        UIEventListener.Get(_enhanceBtn).onClick = OnConfirmClick;\n        GemManager.Instance.OnResponseUpgradeGem += OnResponseUpgradeGem;\n    }\n\n    public void Dispose()\n    {\n        _poolBenefit.Clear();\n\n        if (_needMaterialsContainer != null)\n            _needMaterialsContainer.OnRefreshCell -= OnRefreshNeedMaterialCell;\n        \n        UIEventListener.Get(_enhanceBtn).onClick = null;\n        \n                DisposeTargetGemButtons();\nGemManager.Instance.OnResponseUpgradeGem -= OnResponseUpgradeGem;\n\n    }\n\n    public void RefreshPage(EquipmentGemSlotItemDataVO.GemSlotItemDataVO targetGem)\n    {\n        if (!_isShow)\n            return;\n        \n        UpdateUI();\n    }\n\n    public void UpdateUI()\n    {\n        _avalonInfo = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n        if (_avalonInfo == null)\n        {\n            Hide();\n            return;\n        }\n        \n        _itemInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(_avalonInfo.ItemID);\n        if (_itemInfo == null)\n        {\n            Hide();\n            return;\n        }\n        \n        RefreshTargetGemInfos();\n        _nextArtifactInfo = GetTargetGemInfo();\n        if (_nextArtifactInfo == null)\n        {\n            Hide();\n            return;\n        }\n        \n        _nextItemInfo = ConfigManager2.Instance.DB_Itemlist.GetItem(_nextArtifactInfo.ItemID);\n        if (_nextItemInfo == null)\n        {\n            Hide();\n            return;\n        }\n\n        UpdateIcons();\n        UpdateBenefits();\n        UpdateRequirements();\n        UpdateBtnStatus();\n        UpdateLockState();\n    }\n\n    private void UpdateLockState()\n    {\n        if (_curGemData == null)\n        {\n            Utils.SetActive(_enhanceGemLock, false);\n            return;\n        }\n\n        bool isOpenEnhanceLv5 =\n            ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.ITERATION_ENHANCE_5);\n        bool isMaxEnhanceLv = GemIsMaxLv(_curGemData);\n        EquipmentGemInfo tmpInfo = _avalonInfo as EquipmentGemInfo;\n\n        if (tmpInfo?.EnhanceLevel >= ConfigFunctionOpenLv.ITERATION_ENHANCE_LV_5 - 1 &&\n            !isOpenEnhanceLv5 && !isMaxEnhanceLv)\n        {\n            Utils.SetActive(_enhanceGemLock, true);\n        }\n        else\n        {\n            Utils.SetActive(_enhanceGemLock, false);\n        }\n    }\n\n    private void UpdateBtnStatus()\n    {\n        if (_curGemData == null)\n            return;\n\n        bool isMaxLv = GemIsMaxLv(_curGemData);\n        if (isMaxLv)\n        {\n            Utils.SetActive(_enhanceRedPoint, false);\n            GreyUtility.SetGrey(_enhanceBtn, true);\n            Utils.EnableNGUIControlInteraction(_enhanceBtn, false);\n            _enhanceBtnContext.text = Utils.XLAT(\"gem_update_gem_replace_max_level_button\");\n        }\n        else\n        {\n            GreyUtility.SetGrey(_enhanceBtn, false);\n            Utils.EnableNGUIControlInteraction(_enhanceBtn, true);\n            _enhanceBtnContext.text = Utils.XLAT(\"forge_equipment_enhance_button\");\n\n            bool lackRequireMetarial = LackRequireMaterials();\n            Utils.SetActive(_enhanceRedPoint, !lackRequireMetarial);\n        }\n    }\n\n    private void UpdateBenefits()\n    {\n        for (int i = 0; i < _componentList.Count; ++i)\n        {\n            var component = _componentList[i];\n            _poolBenefit.Release(component.gameObject);\n        }\n\n        _componentList.Clear();\n        var list = _avalonInfo.GetBenefits();\n        var nextList = _nextArtifactInfo.GetBenefits();\n        for (int i = 0; i < list.Count; ++i)\n        {\n            var pair = list[i];\n            var nextPair = nextList[i];\n            var component = _poolBenefit.AddChild(_gridBenefit.gameObject).GetComponent<AvalonArtifactBenefitTipComponent>();\n            component.SetData(_avalonInfo, i, pair, nextPair);\n            Utils.SetActive(component.gameObject, true);\n            _componentList.Add(component);\n        }\n\n        _gridBenefit.Reposition();\n    }\n\n    private void UpdateIcons()\n    {\n        BuilderFactory.Instance.HandyBuild(_iconFrom.TexIcon, _itemInfo.ImagePath, useWidgetSetting: true);\n        BuilderFactory.Instance.HandyBuild(_iconTo.TexIcon, _itemInfo.ImagePath, useWidgetSetting: true);\n        \n        _iconFrom.LabelName.text = _itemInfo.LocName;\n        _iconFrom.LabelName.color = EquipmentManager.Instance.GetColorWithQuality(_avalonInfo.ItemInfo.Quality);\n        _iconTo.LabelName.text = _nextItemInfo.LocName;\n        _iconTo.LabelName.color = EquipmentManager.Instance.GetColorWithQuality(_nextArtifactInfo.ItemInfo.Quality);\n\n        BuilderFactory.Instance.HandyBuild(_iconFrom.TexFrame, _avalonInfo.ItemInfo.QualityImagePath,\n            useWidgetSetting: true);\n        BuilderFactory.Instance.HandyBuild(_iconTo.TexFrame, _nextArtifactInfo.ItemInfo.QualityImagePath,\n            useWidgetSetting: true);\n\n        Utils.SetActive(_iconFrom.SpriteScroll.gameObject, false);\n        Utils.SetActive(_iconTo.SpriteScroll.gameObject, false);\n\n        Utils.SetActive(_iconFrom.SpriteMask.gameObject, false);\n        Utils.SetActive(_iconTo.SpriteMask.gameObject, false);\n    }\n\n    private void UpdateRequirements()\n    {\n        IHandbookInfo info = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n\n        if (info != null)\n        {\n            EquipmentGemInfo configGemInfo = info as EquipmentGemInfo;\n            if (configGemInfo != null)\n            {\n                _needMaterialsContainer.ClearAll();\n                List<Materials.MaterialElement> needMaterials = configGemInfo.LevelUpMaterialsNew.GetMaterials(); \n                foreach (var item in needMaterials)\n                {\n                    if (item != null && item.amount > 0)\n                        _needMaterialsContainer.AddCell(0, item);\n                }\n                _needMaterialsContainer.OnAllLoadCallBack = RequirementsCreateCb;\n            }\n        }\n    }\n    \n    private void RequirementsCreateCb()\n    {\n        _requireSV.ResetPosition();\n    }\n\n    private void OnRefreshNeedMaterialCell(int cellIndex, GameObject cell, object userData)\n    {\n        Materials.MaterialElement data = userData as Materials.MaterialElement;\n        \n        if (data != null)\n        {\n            ItemStaticInfoComponent com = cell.GetComponent<ItemStaticInfoComponent>();\n            if (com != null)\n            {\n                long curAmount = 0;\n                if (userData != null)\n                {\n                    Materials.MaterialElement elementData = userData as Materials.MaterialElement;\n                    if (elementData != null)\n                    {\n                        curAmount = ItemBag.Instance.GetItemCount(elementData.internalID);\n                    }\n                }\n\n                Action<long, int> clickCb = null;\n                if (curAmount < data.amount)\n                    clickCb = GetMoreItemCb;\n                com.SetRequireInfo(data.internalID, curAmount, data.amount, clickCb);\n            }\n        }\n    }\n\n    private void GetMoreItemCb(long itemInternalId, int requireAmount)\n    {\n        if (itemInternalId <= 0)\n            return;\n\n        if (_triggerCloseView != null)\n        {\n            _triggerCloseView.Invoke(_curGemData);\n        }\n        \n        Dictionary<long,int> reqiuire = new Dictionary<long, int>();\n        reqiuire.Add(itemInternalId, requireAmount);\n        CommonGetMoreManager.Instance.OpenGetMorePopup(reqiuire);\n    }\n\n    private void OnConfirmClick(GameObject go)\n    {\n        if (CheckLockState())\n        {\n            return;\n        }\n\n        if (_avalonArtifactManager.CanUpgrade())\n        {\n            else if (_onClickEnhanceBtn != null)\n                _onClickEnhanceBtn.Invoke(_avalonArtifactManager.gemData.ID);\n        }\n        else\n        {\n            Dictionary<long,int> reqiuire = new Dictionary<long, int>();\n            \n            IHandbookInfo info = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n\n            if (info != null)\n            {\n                EquipmentGemInfo configGemInfo = info as EquipmentGemInfo;\n                if (configGemInfo != null)\n                {\n                    List<Materials.MaterialElement> requires = configGemInfo.LevelUpMaterialsNew.GetMaterials();\n                    if (requires == null && requires.Count == 0)\n                        return;\n\n                    for (int i = 0; i < requires.Count; i++)\n                    {\n                        long curAmount = ItemBag.Instance.GetItemCount(requires[i].internalID);\n                        if (curAmount < requires[i].amount)\n                        {\n                            reqiuire.Add(requires[i].internalID, (int)requires[i].amount);\n                        }\n                    }\n                }\n            }\n            \n            if (_triggerCloseView != null)\n            {\n                _triggerCloseView.Invoke(_curGemData);\n            }\n            CommonGetMoreManager.Instance.OpenGetMorePopup(reqiuire);\n        }\n    }\n\n    private bool CheckLockState()\n    {\n        AvalonArtifactComponentData comData =\n            GemManager.Instance.AvalonArtifactManager.GetGemSimpleAvalonArtifactData(_avalonArtifactManager.gemData);\n\n        bool isOpenEnhanceLv5 =\n            ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.ITERATION_ENHANCE_5);\n        bool isMaxEnhanceLv = !GemManager.Instance.AvalonArtifactManager.IsUpgradeable(comData.ArtifactInfo.InternalID);\n\n        EquipmentGemInfo tmpInfo = comData.ArtifactInfo as EquipmentGemInfo;\n        if (tmpInfo?.EnhanceLevel >= ConfigFunctionOpenLv.ITERATION_ENHANCE_LV_5 - 1 &&\n            !isOpenEnhanceLv5 && !isMaxEnhanceLv)\n        {\n            UIManager.inst.toast.Show(Utils.XLAT(\"toast_equip_gem_enhance_5_not_open\"));\n            return true;\n        }\n\n        return false;\n    }\n\n    private void OnResponseUpgradeGem(long gemID)\n    {\n        _upgradeGemSuccess = true;\n        _upgrageGemId = gemID;\n    }\n\n    private void Update()\n    {\n        if (_upgradeGemSuccess)\n        {\n            _upgradeGemSuccess = false;\n            \n            PlayEffect();\n        \n            UIManager.inst.ShowEmptyManualBlocker();\n            \n            Observable.Timer(TimeSpan.FromSeconds(1.3)).Subscribe(_ =>\n            {\n                UIManager.inst.HideManualBlocker();\n                \n                UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.GemEnhanceSuccessPopup,\n                    new GemEnhanceSuccessPopup.Parameter()\n                    {\n                        gemID = _upgrageGemId,\n                    });\n\n                if (_completeEnhanceGemCb != null)\n                {\n                    GemData gemData = DBManager.Instance.DB_Gems.Get(_upgrageGemId);\n                    if (gemData != null)\n                        _completeEnhanceGemCb.Invoke(gemData);\n                }\n            \n            }).AddTo(this);\n        }\n    }\n\n    public void PlayEffect()\n    {\n        AudioManager.Instance.StopAndPlayVoice(AudioNameConfig.EQUIP_SFX_LIGHT);\n        long count = _needMaterialsContainer.CellCount;\n        for (int i = 0; i < count; i++)\n        {\n            var data = _needMaterialsContainer.GetCellDataByIndex(i);\n            if (data != null && data.CellInstance != null)\n            {\n                var item = data.CellInstance.GetComponent<GemEnhanceEffectCom>();\n                if (item != null && _iconFrom != null)\n                {\n                    item.AddMoveFinishEvent(item.HideFlyEffect);\n                    item.MoveEffectToTarget(_iconFrom.gameObject);\n                }\n            }\n        }\n    }\n    \n    public override void OnClickHideBtn()\n    {\n        Hide();\n    }\n    \n    private bool LackRequireMaterials()\n    {\n        bool lackMaterial = false;\n        IHandbookInfo info = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n        if (info != null)\n        {\n            EquipmentGemInfo configGemInfo = info as EquipmentGemInfo;\n            if (configGemInfo != null)\n            {\n                foreach (var item in configGemInfo.LevelUpMaterialsNew.GetMaterials())\n                {\n                    long curAmount = item != null ? ItemBag.Instance.GetItemCount(item.internalID) : 0;\n                    lackMaterial |= curAmount < item.amount;\n                }\n            }\n        }\n\n        return lackMaterial;\n    }\n\n    private void OnDestroy()\n    {\n        UIManager.inst.HideManualBlocker();\n    }\n}\n*/\n\n#endregion\n\n\n\n\n\n\n\n\n```\n\n## 检查 Skill\n\n### Game\\.agents\\skills\\unity-code-review\\SKILL.md\n\n````markdown\n---\nname: unity-code-review\ndescription: Reviews Unity C# code against Unity's official style guide. Supports local git diff and GitHub PR review.\nargument-hint: [file | diff | PR_URL]\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\n---\n\n# Unity Code Review Skill\n\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\n\n## Trigger Conditions\n\nThis skill activates when:\n\n- User invokes `/unity-code-review` with a file or diff.\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\n\n## Review Modes\n\n### Local Git Diff Review\n\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\n\n### GitHub PR Review\n\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\n\n## Unity C# Style Guide Core Rules\n\n### Naming Conventions\n\n| Type | Rule | Example |\n| --- | --- | --- |\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\n| Local Variables | camelCase | `playerPosition`, `damage` |\n\nAvoid:\n\n- Single letter names except loop counters.\n- Hungarian notation.\n- Vague names such as `data`, `temp`, or `manager`.\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\n\n### Single Responsibility\n\n- Each MonoBehaviour should have one clear engine-facing responsibility.\n- Keep gameplay logic testable outside Unity where practical.\n- Avoid boolean flag parameters when separate methods communicate intent better.\n- Keep methods small enough to review and test.\n\n### Comments\n\n- Comments should explain why, not what.\n- Public APIs may use XML documentation.\n- Do not leave commented-out code or stale TODOs.\n\n## Unity-Specific Review Focus\n\n### MonoBehaviour Lifecycle\n\n- Use `Awake` for local initialization and component caching.\n- Use `Start` only for initialization that depends on other objects being ready.\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\n\n### Coroutine and Async Patterns\n\n- Store coroutine references when cancellation is needed.\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\n- Stop async work when the owning object is disabled or destroyed.\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\n\n### Unity API Misuse\n\n| Issue | Correct Approach |\n| --- | --- |\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\n| `tag == \"Enemy\"` | use `CompareTag()` |\n| allocating physics queries | use non-alloc APIs where appropriate |\n| frequent `Instantiate` / `Destroy` | use object pooling |\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\n\n### Performance Concerns\n\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\n- Avoid LINQ and string concatenation in hot paths.\n- Cache repeated lookups and temporary collections where appropriate.\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\n\n### Testing\n\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\n- Use Unity Test Framework for engine-dependent behavior.\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\n\n## Review Workflow\n\n1. Run `git diff` or inspect the specified file / PR diff.\n2. Read full changed files and nearby related files for context.\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\n4. Lead with correctness, runtime risk, and missing validation.\n5. Keep findings actionable and cite exact files.\n\n## Review Output Format\n\n```markdown\n## Code Review: [scope]\n\n### Findings\n\n1. **Issue title** (`path/to/file.cs`)\n   - What is wrong.\n   - Why it matters.\n   - Suggested fix.\n\n### Open Questions\n\n- Any assumptions or unclear ownership.\n\n### Test Gaps\n\n- Validation that is missing or could not be run.\n```\n\n## Related Agents\n\n- unity-reviewer\n\n## Related Commands\n\n- unity-review\n\n## Common Code Smells\n\n| Code Smell | Description | Fix |\n| --- | --- | --- |\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\n| Inflexibility | Small change requires many changes | Check SRP violations |\n| Fragility | Minor change breaks everything | Review dependencies |\n| Immobility | Code not reusable elsewhere | Decouple logic |\n| Duplicate code | Copy-pasted logic | Extract core functionality |\n| Excessive commentary | Comments for every line | Use better names, trust the code |\n\n````"}], "stream": true, "store": false, "reasoning": {"effort": "low"}}
