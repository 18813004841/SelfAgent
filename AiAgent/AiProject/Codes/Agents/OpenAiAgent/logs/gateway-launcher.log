arameter : DialogParameter\n        {\n        }\n\n        public override void OnOpen(UIParameter orgParam = null)\n        {\n            base.OnOpen(orgParam);\n            Init();\n        }\n\n        public override void OnShow(UIParameter orgParam = null)\n        {\n            base.OnShow(orgParam);\n            _dirty = true;\n        }\n\n        public override void OnClose(UIParameter orgParam = null)\n        {\n            base.OnClose(orgParam);\n            Clear();\n        }\n\n        public override void OnHide(UIParameter orgParam = null)\n        {\n            base.OnHide(orgParam);\n        }\n\n        void Init()\n        {\n            Utils.SetActive(btnRp, false);\n            custom_UICustomContainer.OnRefreshCell = RefreshCell;\n            InitEvent();\n            SendBossActivityMsg();\n        }\n\n        void InitEvent()\n        {\n            ClearEvent();\n            Oscillator.Instance.secondEvent += OnTick;\n            DBManager.Instance.DB_UserNewWorldBossDB.onDataChanged += OnUserNewWorldBossDataChanged;\n            DBManager.Instance.DB_NewWorldBossDB.onDataChanged += OnNewWorldBossChanged;\n            MessageHub.inst.GetPortByAction(PortType.PUSH_NEW_WORLD_BOSS_DAILY_UPDATE).AddEvent(OnDailyUpdate);\n        }\n\n        void Clear()\n        {\n            ClearEvent();\n            custom_UICustomContainer.OnRefreshCell = null;\n        }\n\n        void ClearEvent()\n        {\n            Oscillator.Instance.secondEvent -= OnTick;\n            DBManager.Instance.DB_UserNewWorldBossDB.onDataChanged -= OnUserNewWorldBossDataChanged;\n            DBManager.Instance.DB_NewWorldBossDB.onDataChanged -= OnNewWorldBossChanged;\n            MessageHub.inst.GetPortByAction(PortType.PUSH_NEW_WORLD_BOSS_DAILY_UPDATE).RemoveEvent(OnDailyUpdate);\n        }\n\n        private void Update()\n        {\n            if (_dirty)\n            {\n                _dirty = false;\n                UpdateView();\n            }\n        }\n\n        #endregion\n\n        void BossActivityDataCallback(bool ret, object data)\n        {\n            if (ret)\n            {\n                _dirty = true;\n            }\n        }\n\n        void SendBossActivityMsg()\n        {\n            if (PlayerData.inst.userData == null)\n            {\n                return;\n            }\n\n            Hashtable ht = new Hashtable\n            {\n                [\"uid\"] = PlayerData.inst.userData.uid,\n                [\"world_id\"] = PlayerData.inst.userData.world_id,\n            };\n            LunarWorldBossManager.Instance.SendNewBossActivityDataMsg(this.gameObject, ht,\n                BossActivityDataCallback);\n        }\n\n        void UpdateData()\n        {\n            _curBossCommonRewardInfo = null;\n            var activityData = LunarWorldBossManager.Instance.ActivityData;\n            var challengeRewardInfos = ConfigManager2.Instance.DB_NewPuppetsReward.GetNewPuppetsRewardInfoList(\n                activityData?.CurrentMainInfo?.ChallengeRewardGroup, activityData?.Order ?? 1, true);\n\n            _blankStage = activityData == null || activityData.IsEmptyBlankStage;\n            int rewardInfoCnt = challengeRewardInfos?.Count ?? 0;\n            if (rewardInfoCnt > 0)\n            {\n                long attackTimes = LunarWorldBossManager.Instance.UserData?.attackTimes ?? 0;\n                _maxChallengeNum = challengeRewardInfos[rewardInfoCnt - 1].OrderMin;\n                for (int i = 0; i < rewardInfoCnt; i++)\n                {\n                    if (attackTimes < challengeRewardInfos[i].OrderMin)\n                    {\n                        _curBossCommonRewardInfo = challengeRewardInfos[i];\n                        break;\n                    }\n                }\n\n                if (_curBossCommonRewardInfo == null)\n                {\n                    _curBossCommonRewardInfo = challengeRewardInfos[rewardInfoCnt - 1];\n                }\n            }\n\n            if (activityData != null)\n            {\n                _stageStartTime = activityData.OrderStartTime;\n                _stageEndTime = _stageStartTime + 86400;\n            }\n            else\n            {\n                _stageStartTime = _stageEndTime = 0;\n            }\n        }\n\n        void UpdateView()\n        {\n            if (!IsValid)\n            {\n                return;\n            }\n\n            UpdateData();\n            UpdateBossInfo();\n\n            bool isEmptyBoss = _blankStage;\n            Utils.SetActive(empty, isEmptyBoss);\n            Utils.SetActive(dailyBonus, !isEmptyBoss);\n            if (!isEmptyBoss)\n            {\n                title_UILabel.text = BossInfo?.LocName;\n                UpdateBossThemeBenefit();\n                UpdateChallengeProgress();\n                UpdateBossAttackReward();\n                UpdateBtnState();\n            }\n\n            OnTick(0);\n        }\n\n        private void UpdateBossInfo()\n        {\n            title_UILabel.text = BossInfo?.LocName;\n            string bossBgPath = LunarWorldBossManager.Instance.GetLunarWorldBossBgPath();\n            if (!string.IsNullOrEmpty(bossBgPath))\n            {\n                BuilderFactory.Instance.HandyBuild(bg_UITexture, bossBgPath);\n            }\n            else\n            {\n                BuilderFactory.Instance.Release(bg_UITexture);\n            }\n        }\n\n        private void UpdateBossThemeBenefit()\n        {\n            if (BossInfo != null)\n            {\n                benefitDesc_UILabel.text = Utils.XLAT_Extend(\"new_puppet_invasion_attack_up_daily\",BossInfo.LocDesc,\n                    BossInfo.LocName,\n                    BossInfo.TotalBenefit);\n\n                if (!string.IsNullOrEmpty(BossInfo.IconPath))\n                {\n                    BuilderFactory.Instance.HandyBuild(benefitTexture_UITexture, BossInfo.IconPath,\n                        useWidgetSetting: true);\n                }\n                else\n                {\n                    BuilderFactory.Instance.Release(benefitTexture_UITexture);\n                }\n            }\n            else\n            {\n                benefitDesc_UILabel.text = null;\n                BuilderFactory.Instance.Release(benefitTexture_UITexture);\n            }\n        }\n\n        private void UpdateChallengeProgress()\n        {\n            if (_maxChallengeNum <= 0)\n            {\n                challengeNum_UILabel.text = null;\n            }\n            else\n            {\n                long attackTimes = LunarWorldBossManager.Instance.UserData?.attackTimes ?? 0;\n                if (attackTimes >= _maxChallengeNum)\n                {\n                    challengeNum_UILabel.text = Utils.XLAT(\n                        \"new_puppet_invasion_today_task_complete\");\n                }\n                else\n                {\n                    challengeNum_UILabel.text = Utils.XLAT_Extend(\n                        \"new_puppet_invasion_challenge_time\",\n                        _curBossCommonRewardInfo.OrderMin, attackTimes);\n                }\n            }\n        }\n\n        void UpdateBossAttackReward()\n        {\n            custom_UICustomContainer.ClearAll();\n            var rewards = _curBossCommonRewardInfo?.Rewards;\n            bool valid = rewards != null && rewards.Count > 0;\n            if (valid)\n            {\n                foreach (var reward in rewards)\n                {\n                    custom_UICustomContainer.AddCell(0, reward);\n                }\n\n                custom_UICustomContainer.UpdateImmediately();\n                scrollView_UIScrollView.ResetPosition();\n            }\n        }\n\n        void UpdateBtnState()\n        {\n            bool valid = LunarWorldBossManager.Instance.IsExistValidRp();\n           Utils.SetActive(btnRp, valid);\n        }\n\n        void OnTick(int time)\n        {\n            if (!IsValid)\n            {\n                return;\n            }\n\n            if (_stageEndTime <= 0)\n            {\n                return;\n            }\n\n            long leftTime = _stageEndTime - NetServerTime.Instance.ServerTimestamp;\n            if (leftTime < 0)\n            {\n                leftTime = 0;\n            }\n\n            if (_blankStage)\n            {\n                emptyCountdown_UILabel.text = Utils.XLAT_Extend(\"new_puppet_invasion_next_countdown\",\n                    Utils.FormatTime(leftTime, hadDay: true));\n            }\n            else\n            {\n                bossTime_UILabel.text = Utils.XLAT_Extend(\"new_puppet_invasion_disappear\",\n                    Utils.FormatTime(leftTime, hadDay: true));\n            }\n        }\n\n        void RefreshCell(int index, GameObject obj, object data)\n        {\n            var cpt = obj.GetComponent<ItemStaticInfoComponent_V2>();\n            if (cpt)\n            {\n                var reward = data is StringStringPair_Row\n                    ? (StringStringPair_Row)data\n                    : default(StringStringPair_Row);\n                if (!string.IsNullOrEmpty(reward.Id) && long.TryParse(reward.Id, out long rewardId))\n                {\n                    long count = 0;\n                    if (!string.IsNullOrEmpty(reward.Value))\n                    {\n                        long.TryParse(reward.Value, out count);\n                    }\n\n                    cpt.SetData(rewardId, count);\n                }\n            }\n        }\n\n        void OnUserNewWorldBossDataChanged(object data)\n        {\n            if (IsValid)\n            {\n                _dirty = true;\n            }\n        }\n\n        void OnNewWorldBossChanged(object data = null)\n        {\n            if (IsValid)\n            {\n                _dirty = true;\n            }\n        }\n\n        void OnDailyUpdate(object data)\n        {\n            if (IsValid)\n            {\n                _dirty = true;\n            }\n        }\n\n        bool IsCanOperatorBtnEvent(bool showToast = true)\n        {\n            var activityData = LunarWorldBossManager.Instance.ActivityData;\n            if (activityData == null || activityData.IsEmptyBlankStage)\n            {\n                if (showToast)\n                {\n                    UIManager.inst.toast.Show(Utils.XLAT(\"new_puppet_invasion_no_tast\"));\n                }\n                return false;\n            }\n\n            return true;\n        }\n\n        #region Event\n\n        public void RewardBtnEvent()\n        {\n            if (IsCanOperatorBtnEvent())\n            {\n                UIManager.inst.OpenPopupAsync(UIManager.PopupType.LunarWorldBossRankPopup);\n            }\n        }\n\n        public void AccomplishmentBtnEvent()\n        {\n            if (IsCanOperatorBtnEvent())\n            {\n                UIManager.inst.OpenPopupAsync(UIManager.PopupType.LunarWorldBossAccomplishmentPopup);\n            }\n        }\n\n        public void RankBtnEvent()\n        {\n            if (IsCanOperatorBtnEvent())\n            {\n                UIManager.inst.OpenPopupAsync(UIManager.PopupType.LunarWorldBossHardRankPopup);\n            }\n        }\n\n        public void HistoryBtnEvent()\n        {\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.LunarWorldBossHistoryPopup);\n        }\n\n        public void ChallengeBtnEvent()\n        {\n            long worldId = PlayerData.inst.userData.world_id;\n            long currentWorldId = PlayerData.inst.userData?.current_world_id ?? 0;\n            long bossId = LunarWorldBossManager.Instance.ActivityData?.BossId ?? 0;\n            var bossData = DBManager.Instance.DB_NewWorldBossDB.GetNewWorldBossData(\n                worldId, bossId);\n            if (bossData == null || currentWorldId <= 0 ||\n                bossData.mapX <= 0 || bossData.mapY <= 0)\n            {\n                return;\n            }\n\n            var bossCoordinate = new Coordinate(currentWorldId, bossData.mapX, bossData.mapY);\n            if (!MapUtils.CanGotoTarget(currentWorldId))\n            {\n                UIManager.inst.toast.Show(\n                    Utils.XLAT(\"toast_kingdom_target_different_kingdom\"), clear: true);\n                return;\n            }\n\n            var targetGameMode = MapUtils.GetGameModeByK(currentWorldId);\n            void GotoBoss()\n            {\n                GameEngine.Instance.CurrentGameMode = targetGameMode;\n                if (PVPSystem.Instance.Map != null)\n                {\n                    PVPSystem.Instance.Map.GotoLocation(bossCoordinate, false);\n                    Utils.StartCoroutine(PVPSystem.Instance.Map,PVPSystem.Instance.Map.AutoOpenMapMonsterPanel(\n                        bossCoordinate, TileType.TILE_NEW_WORLD_BOSS));\n                }\n            }\n\n            UIManager.inst.CloseAllDlgAndPopup();\n            if (GameEngine.Instance.CurrentGameMode != targetGameMode)\n            {\n                UIManager.inst.Cloud.CoverCloud(GotoBoss);\n            }\n            else\n            {\n                GotoBoss();\n            }\n        }\n\n        public void ClickBackBtnEvent()\n        {\n            OnBackButtonPress();\n        }\n\n        public void ClickCloseBtnEvent()\n        {\n            OnCloseButtonPress();\n        }\n\n        #endregion\n    }\n}\n```\n\n## 检查 Skill\n\n### Game\\.agents\\skills\\unity-code-review\\SKILL.md\n\n````markdown\n---\nname: unity-code-review\ndescription: Reviews Unity C# code against Unity's official style guide. Supports local git diff and GitHub PR review.\nargument-hint: [file | diff | PR_URL]\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\n---\n\n# Unity Code Review Skill\n\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\n\n## Trigger Conditions\n\nThis skill activates when:\n\n- User invokes `/unity-code-review` with a file or diff.\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\n\n## Review Modes\n\n### Local Git Diff Review\n\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\n\n### GitHub PR Review\n\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\n\n## Unity C# Style Guide Core Rules\n\n### Naming Conventions\n\n| Type | Rule | Example |\n| --- | --- | --- |\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\n| Local Variables | camelCase | `playerPosition`, `damage` |\n\nAvoid:\n\n- Single letter names except loop counters.\n- Hungarian notation.\n- Vague names such as `data`, `temp`, or `manager`.\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\n\n### Single Responsibility\n\n- Each MonoBehaviour should have one clear engine-facing responsibility.\n- Keep gameplay logic testable outside Unity where practical.\n- Avoid boolean flag parameters when separate methods communicate intent better.\n- Keep methods small enough to review and test.\n\n### Comments\n\n- Comments should explain why, not what.\n- Public APIs may use XML documentation.\n- Do not leave commented-out code or stale TODOs.\n\n## Unity-Specific Review Focus\n\n### MonoBehaviour Lifecycle\n\n- Use `Awake` for local initialization and component caching.\n- Use `Start` only for initialization that depends on other objects being ready.\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\n\n### Coroutine and Async Patterns\n\n- Store coroutine references when cancellation is needed.\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\n- Stop async work when the owning object is disabled or destroyed.\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\n\n### Unity API Misuse\n\n| Issue | Correct Approach |\n| --- | --- |\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\n| `tag == \"Enemy\"` | use `CompareTag()` |\n| allocating physics queries | use non-alloc APIs where appropriate |\n| frequent `Instantiate` / `Destroy` | use object pooling |\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\n\n### Performance Concerns\n\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\n- Avoid LINQ and string concatenation in hot paths.\n- Cache repeated lookups and temporary collections where appropriate.\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\n\n### Testing\n\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\n- Use Unity Test Framework for engine-dependent behavior.\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\n\n## Review Workflow\n\n1. Run `git diff` or inspect the specified file / PR diff.\n2. Read full changed files and nearby related files for context.\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\n4. Lead with correctness, runtime risk, and missing validation.\n5. Keep findings actionable and cite exact files.\n\n## Review Output Format\n\n```markdown\n## Code Review: [scope]\n\n### Findings\n\n1. **Issue title** (`path/to/file.cs`)\n   - What is wrong.\n   - Why it matters.\n   - Suggested fix.\n\n### Open Questions\n\n- Any assumptions or unclear ownership.\n\n### Test Gaps\n\n- Validation that is missing or could not be run.\n```\n\n## Related Agents\n\n- unity-reviewer\n\n## Related Commands\n\n- unity-review\n\n## Common Code Smells\n\n| Code Smell | Description | Fix |\n| --- | --- | --- |\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\n| Inflexibility | Small change requires many changes | Check SRP violations |\n| Fragility | Minor change breaks everything | Review dependencies |\n| Immobility | Code not reusable elsewhere | Decouple logic |\n| Duplicate code | Copy-pasted logic | Extract core functionality |\n| Excessive commentary | Comments for every line | Use better names, trust the code |\n\n````"}]
