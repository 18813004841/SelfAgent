          bi[\"quality\"] = _questConfigInfo.Quality;\n                        bi[\"id\"] = _questConfigInfo.Id;\n                        bi[\"uid\"] = PlayerData.inst.uid;\n                        bi[\"world_id\"] = PlayerData.inst.userData.world_id;\n                        bi[\"rank_lv\"] = hero.LordRankLevel;\n                        bi[\"quest_lv\"] = hero.LordQuestLevel;\n                        bi[\"area_id\"] = \"start\";\n                        bi[\"task_id\"] = _questData.TaskCor.ToShortString();\n                        bi[\"type\"] = 3;\n                        FunplusBi.Instance.TraceAction(\"intelligence\", Utils.Object2Json(bi));\n                    }\n\n                    if (_questConfigInfo.Coords <= 0)\n                    {\n                        IntelligenceManager.Instance.StartTowerDefenceLevel(_questConfigInfo, _questData);\n                    }\n                    else\n                    {\n                        GoToMapLocation(checkGameMode, () =>\n                        {\n                            PVPMap.PendingGotoRequest = _questData.TaskCor;\n                            StartRequsetData();\n                        });\n                    }\n\n                    break;\n                }\n                case IntelligenceQuestType.Judge: //断案\n                {\n                    {\n                        var bi = new Hashtable();\n                        bi[\"timestamp\"] = NetServerTime.inst.ServerTimestamp;\n                        bi[\"type\"] = (int)_questConfigInfo.Type;\n                        bi[\"quality\"] = _questConfigInfo.Quality;\n                        bi[\"id\"] = _questConfigInfo.Id;\n                        bi[\"uid\"] = PlayerData.inst.uid;\n                        bi[\"world_id\"] = PlayerData.inst.userData.world_id;\n                        bi[\"rank_lv\"] = hero.LordRankLevel;\n                        bi[\"quest_lv\"] = hero.LordQuestLevel;\n                        bi[\"area_id\"] = \"start\";\