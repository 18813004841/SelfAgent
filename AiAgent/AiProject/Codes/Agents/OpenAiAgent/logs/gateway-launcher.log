ger.Type.Intelligence);\n                return;\n            }\n\n            /*if (!IsTutorialFinish(TutorialType.Goto, _questConfigInfo.ToGuide))\n            {\n                return;\n            }*/\n\n            //执行任务前先检查体力是否满足该任务的要求\n            DB.HeroData hero = DBManager.Instance.DB_hero.Get(PlayerData.inst.cityId);\n            if (hero == null || hero.spirit < _questConfigInfo.Stamina)\n            {\n                UIManager.inst.toast.Show(Utils.XLAT(\"toast_lead_in_2021_kingdom_quest_no_stamina\"));\n                return;\n            }\n\n            if (_questConfigInfo.BaseType == (int)IntelligenceQuestBaseType.MonsterLevel)\n            {\n                IntelligenceManager.Instance.FinishChallengeQuest(_questData);\n                return;\n            }\n            if (_questConfigInfo.BaseType == (int)IntelligenceQuestBaseType.Scout_FamousCity)\n            {\n                if (PlayerData.inst.userData.allianceId<=0)\n                {\n                    UIManager.inst.toast.Show(Utils.XLAT(\"urban_competition_go_alliance_toast\"));\n                    return;\n                }\n                //首先获得名城DB信息\n                RequestManager.Instance.SendRequest(PortType.ALLIANCE_GET_ALL_FAMOUS_CITIES, null,\n                    (result, o) =>\n                    {\n                        if (result)\n                        {\n                            UrbanCompetitionManager.Instance.GotoScoutFamousCity();\n                        }\n                    }).AutoCancel(gameObject);\n                return;\n            }\n\n            bool keepCurDlg = false;\n            switch ((IntelligenceQuestType)_questConfigInfo.Type)\n            {\n                case IntelligenceQuestType.Judge:\n                    keepCurDlg = true;\n                    break;\n                case IntelligenceQuestType.Tower:\n                    if (_questConfigInfo.IsInnerCityTask)\n                        keepCurDlg = true;\n                   