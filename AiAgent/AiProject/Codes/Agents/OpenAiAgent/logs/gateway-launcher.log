mScore())\n            return;\n        \n        if (_avalonInfo != null && _nextArtifactInfo != null)\n        {\n            var component = _poolBenefit.AddChild(_gridBenefit.gameObject)\n                .GetComponent<AvalonArtifactBenefitTipComponent>();\n\n            long score1 = GemManager.Instance.GetGemScore(_avalonInfo.InternalID);\n            long score2 = GemManager.Instance.GetGemScore(_nextArtifactInfo.InternalID);\n            \n            string title = Utils.XLAT(GemConst.GemScoreTitle);\n            string score1Str = Utils.FormatThousands(score1);         \n            string score2Str = Utils.FormatThousands(score2);\n\n            component.ShowContent(title, score1Str, score2Str);\n            _componentList.Add(component);\n            Utils.SetActive(component.gameObject, true);\n        }\n    }\n    \n    //???宝石修改\n    private void UpdateBenefits()\n    {\n        if (null == _componentList)\n        {\n            _componentList = new List<AvalonArtifactBenefitTipComponent>();\n        }\n        else\n        {\n            foreach (var component in _componentList)\n            {\n                if (null != component)\n                {\n                    _poolBenefit.Release(component.gameObject);\n                }\n            }\n            _componentList.Clear();\n        }\n\n        UpdateGemScore();\n\n        if (_avalonInfo != null && _nextArtifactInfo != null)\n        {\n            var list = _avalonInfo.GetBenefits();\n            var nextList = _nextArtifactInfo.GetBenefits();\n            for (var i = 0; i < list.Count; ++i)\n            {\n                var pair = list[i];\n                var nextPair = nextList.Find(p =>p.internalID == pair.internalID);\n\n                if (nextPair != null && (pair.value != 0 || nextPair.value != 0))\n                {\n                    var component = _poolBenefit.AddChild(_gridBenefit.gameObject)\n                        .GetComponent<AvalonArtifactBenefitTipComponent>();\n                \n                    component.SetData(_avalonInfo, i, pair, nextPair);\n                    _componentList.Add(component);\n                    Utils.SetActive(component.gameObject, true);\n                }\n            }\n        }\n\n        if (_gridBenefit)\n        {\n            _gridBenefit.enabled = true;\n            _gridBenefit.Reposition();\n        }\n    }\n\n    private void UpdateRequirements()\n    {\n        if (_needMaterialsContainer == null)\n            return;\n\n        EquipmentGemInfo current = _avalonInfo as EquipmentGemInfo;\n        if (current == null)\n            return;\n\n        _needMaterialsContainer.ClearAll();\n        List<Materials.MaterialElement> needMaterials =\n            GetTargetGemUpgradeMaterialElements(current, GetTargetGemInfo());\n        foreach (var item in needMaterials)\n        {\n            if (item.amount > 0)\n            {\n                _needMaterialsContainer.AddCell(0, item);\n            }\n        }\n        _needMaterialsContainer.OnAllLoadCallBack = RequirementsCreateCb;\n    }\n\n    private void UpdateBtnStatus()\n    {\n        if (_curGemData == null)\n            return;\n\n        var isMaxLv = GemIsMaxLv(_curGemData);\n        _enhanceBtnContext.text = Utils.XLAT(isMaxLv ? \"gem_update_gem_replace_max_level_button\" : \"forge_equipment_enhance_button\");\n        bool canEnhance = !isMaxLv && GetTargetGemInfo() != null;\n        GreyUtility.SetGrey(_enhanceBtn, !canEnhance);\n        Utils.EnableNGUIControlInteraction(_enhanceBtn, canEnhance);\n    }\n\n    public void SetEnhanceBtnRpActive(bool active)\n    {\n        Utils.SetActive(_enhanceRedPoint, active);\n    }\n\n    private void SetGemIconInfo(AvalonArtifactCraftIconComponent iconCmpt, string path, IHandbookInfo avalonInfo,\n        string gemName)\n    {\n        if (iconCmpt == null || avalonInfo == null)\n            return;\n        \n        BuilderFactory.Instance.HandyBuild(iconCmpt.TexIcon, path, useWidgetSetting: true);\n        \n        iconCmpt.LabelName.text = gemName;\n        \n        iconCmpt.LabelName.color = EquipmentManager.Instance.GetColorWithQuality(avalonInfo.ItemInfo.Quality);\n        \n        BuilderFactory.Instance.HandyBuild(iconCmpt.TexFrame, avalonInfo.ItemInfo.QualityImagePath,\n            useWidgetSetting: true);\n        \n        Utils.SetActive(iconCmpt.SpriteScroll.gameObject, false);\n        Utils.SetActive(iconCmpt.SpriteMask.gameObject, false);\n    }\n\n    private void OnRefreshNeedMaterialCell(int cellIndex, GameObject cell, object userData)\n    {\n        Materials.MaterialElement data = userData as Materials.MaterialElement;\n        if (null == data)\n            return;\n\n        ItemStaticInfoComponent com = cell.GetComponent<ItemStaticInfoComponent>();\n        if (null == com)\n            return;\n\n        long curAmount = ItemBag.Instance.GetItemCount(data.internalID);\n        \n        // Materials.MaterialElement elementData = userData as Materials.MaterialElement;\n        // if (elementData != null)\n        // {\n        //     curAmount = ItemBag.Instance.GetItemCount(data.internalID);\n        // }\n\n        Action<long, int> clickCb = null;\n        if (curAmount < data.amount)\n        {\n            clickCb = GetMoreItemCb;\n        }\n\n        com.useFormatShort = true;\n        com.SetRequireInfo(data.internalID, curAmount, data.amount, clickCb);\n    }\n\n    private void SetObjActive(bool active)\n    {\n       gameObject.SetActive(active);\n    }\n\n    public override void Hide()\n    {\n        base.Hide();\n        SetObjActive(false);\n    }\n\n    private void Dispose()\n    {\n        _poolBenefit.Clear();\n        \n        if (_needMaterialsContainer != null)\n        {\n            _needMaterialsContainer.OnRefreshCell -= OnRefreshNeedMaterialCell;\n        }\n        \n        UIEventListener.Get(_enhanceBtn).onClick = null;\n        \n                DisposeTargetGemButtons();\nGemManager.Instance.OnResponseUpgradeGem -= OnResponseUpgradeGem;\n    }\n\n    private void GetMoreItemCb(long itemInternalId, int requireAmount)\n    {\n        if (itemInternalId <= 0)\n            return;\n        \n        _triggerCloseView?.Invoke(_curGemData);\n\n        Dictionary<long, int> require = new Dictionary<long, int> {{itemInternalId, requireAmount}};\n        \n        CommonGetMoreManager.Instance.OpenGetMorePopup(require);\n    }\n\n    private void OnResponseUpgradeGem(long gemId)\n    {\n        if (!gameObject.activeInHierarchy)\n        {\n            return;\n        }\n        \n        _upgrageGemId = gemId;\n        PlayEffect();\n\n        UIManager.inst.ShowEmptyManualBlocker();\n        \n        Observable.Timer(TimeSpan.FromSeconds(1.3)).Subscribe(_ =>\n        {\n            UIManager.inst.HideManualBlocker();\n\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.GemEnhanceSuccessPopup,\n                new GemEnhanceSuccessPopup.Parameter()\n                {\n                    gemID = _upgrageGemId,\n                    sourceConfigId = _enhanceSourceConfigId,\n                });\n\n            if (_completeEnhanceGemCb != null)\n            {\n                GemData gemData = DBManager.Instance.DB_Gems.Get(_upgrageGemId);\n\n                if (gemData != null)\n                {\n                    _completeEnhanceGemCb.Invoke(gemData);\n                }\n            }\n        }).AddTo(this);\n    }\n\n    private void Update()\n    {\n        // if (_upgradeGemSuccess)\n        // {\n        //     _upgradeGemSuccess = false;\n        //\n        //     PlayEffect();\n        //\n        //     UIManager.inst.ShowEmptyManualBlocker();\n        //\n        //     Observable.Timer(TimeSpan.FromSeconds(1.3)).Subscribe(_ =>\n        //     {\n        //         UIManager.inst.HideManualBlocker();\n        //\n        //         UI.UIManager.inst.OpenPopupAsync(UI.UIManager.PopupType.GemEnhanceSuccessPopup,\n        //             new GemEnhanceSuccessPopup.Parameter()\n        //             {\n        //                 gemID = _upgrageGemId,\n        //             });\n        //\n        //         if (_completeEnhanceGemCb != null)\n        //         {\n        //             GemData gemData = DBManager.Instance.DB_Gems.Get(_upgrageGemId);\n        //             if (gemData != null)\n        //                 _completeEnhanceGemCb.Invoke(gemData);\n        //         }\n        //     }).AddTo(this);\n        // }\n    }\n\n    private void PlayEffect()\n    {\n        AudioManager.Instance.StopAndPlayVoice(AudioNameConfig.EQUIP_SFX_LIGHT);\n        long count = _needMaterialsContainer.CellCount;\n        \n        for (int i = 0; i < count; i++)\n        {\n            var data = _needMaterialsContainer.GetCellDataByIndex(i);\n            \n            if (data != null && data.CellInstance != null)\n            {\n                var item = data.CellInstance.GetComponent<GemEnhanceEffectCom>();\n                \n                if (item != null && _iconFrom != null)\n                {\n                    item.AddMoveFinishEvent(item.HideFlyEffect);\n                    item.MoveEffectToTarget(_iconFrom.gameObject);\n                }\n            }\n        }\n    }\n\n    private void OnConfirmClick(GameObject go)\n    {\n        if (_avalonArtifactManager == null)\n            return;\n\n        EquipmentGemInfo currentGemInfo = _avalonInfo as EquipmentGemInfo;\n        EquipmentGemInfo targetGemInfo = GetTargetGemInfo();\n        if (currentGemInfo == null || targetGemInfo == null)\n            return;\n\n        // 按预览目标的累计消耗检查库存，不能只判断下一等级材料是否充足。\n        Dictionary<long, int> require = new Dictionary<long, int>();\n        List<Materials.MaterialElement> requires =\n            GetTargetGemUpgradeMaterialElements(currentGemInfo, targetGemInfo);\n        foreach (var t in requires)\n        {\n            var curAmount = ItemBag.Instance.GetItemCount(t.internalID);\n            if (curAmount < t.amount)\n                require.Add(t.internalID, (int)t.amount);\n        }\n\n        if (require.Count < 1)\n        {\n            bool isOpenEnhanceLv5 =\n                ConfigManager.inst.DB_FunctionOpenLv.IsFunctionOpen(ConfigFunctionOpenLv.ITERATION_ENHANCE_5);\n            if (!isOpenEnhanceLv5 && _avalonArtifactManager.gemData.GemConfig.EnhanceLevel >= 4)\n            {\n                UIManager.inst.toast.Show(Utils.XLAT(\"toast_equip_gem_enhance_5_not_open\"));\n                return;\n            }\n\n            _enhanceSourceConfigId = currentGemInfo != null ? currentGemInfo.InternalID : 0;\n            if (currentGemInfo != null && targetGemInfo != null && _targetGemIndex > 0)\n            {\n                OpenTargetGemConfirm();\n            }\n            else\n            {\n                SubmitTargetGemUpgrade();\n            }\n            return;\n        }\n\n        _triggerCloseView?.Invoke(_curGemData);\n        CommonGetMoreManager.Instance.OpenGetMorePopup(require);\n    }\n    \n    public override void OnClickHideBtn()\n    {\n        Hide();\n    }\n\n    private bool LackRequireMaterials()\n    {\n        IHandbookInfo info = _avalonArtifactManager.GetInfo(_avalonArtifactManager.CurrentInternalID);\n        \n        if (null == info)\n            return false;\n\n        EquipmentGemInfo configGemInfo = info as EquipmentGemInfo;\n        \n        if (null == configGemInfo)\n            return false;\n\n        bool lackMaterial = false;\n        foreach (var item in configGemInfo.LevelUpMaterialsNew.GetMaterials())\n        {\n            long curAmount = item != null ? ItemBag.Instance.GetItemCount(item.internalID) : 0;\n            lackMaterial |= curAmount < item.amount;\n        }\n\n        return lackMaterial;\n    }\n\n    private void OnDestroy()\n    {\n        Dispose();\n        UIManager.inst.HideManualBlocker();\n    }\n}\n\n#region Before V12.3\n\n/*\npublic class GemEnhanceDetailPart : GemMainDlgRightPart\n{\n\n    [SerializeField] private AvalonArtifactCraftIconComponent _iconFrom;\n    [SerializeField] private AvalonArtifactCraftIconComponent _iconTo;\n\n    [SerializeField] private AvalonArtifactBenefitTipComponent _prefabBenefitComponent;\n\n    [SerializeField] private UIGrid _gridBenefit;\n\n    private GameObjectPool _poolBenefit = new GameObjectPool();\n    private List<AvalonArtifactBenefitTipComponent> _componentList = new List<AvalonArtifactBenefitTipComponent>();\n\n    [SerializeField] private GameObject _enhanceBtn;\n    [SerializeField] private GameObject _enhanceGemLock;\n    [SerializeField] private UILabel _enhanceBtnContext;\n    [SerializeField] private GameObject _enhanceRedPoint;\n\n    [SerializeField] private UICustomContainer _needMaterialsContainer;\n    [SerializeField] private UIScrollView _requireSV;\n\n    private IHandbookInfo _avalonInfo;\n    private ItemlistInfo _itemInfo;\n    private IHandbookInfo _nextArtifactInfo;\n    private ItemlistInfo _nextItemInfo;\n    private AvalonArtifactManager _avalonArtifactManager;\n    private bool _refreshRequireSVLatout;\n\n    private Action<GemData> _completeEnhanceGemCb;\n    private Action<long, long> _onClickEnhanceBtn;\n    private Action<GemData> _triggerCloseView;\n    \n    private bool _upgradeGemSuccess = false;\n    private long _upgrageGemId = 0;\n    private GemData _curGemData;\n    \n    public void Show(GemData curGemData,\n        Action exitViewCb, \n        Action<GemData> completeEnhanceGemCb,\n        Action<long, long> onClickEnhanceBtn,\n        Action<GemData> triggerCloseView)\n    {\n        base.Show(exitViewCb);\n        _completeEnhanceGemCb = completeEnhanceGemCb;\n        _onClickEnhanceBtn = onClickEnhanceBtn;\n        _curGemData = curGemData;\n        _triggerCloseView = triggerCloseView;\n        \n        Init();\n        UpdateUI();\n    }\n    \n    public override void Hide()\n    {\n        base.Hide();\n        \n        Dis