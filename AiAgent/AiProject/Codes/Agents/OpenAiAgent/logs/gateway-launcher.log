p, false);\n            custom_UICustomContainer.OnRefreshCell = RefreshCell;\n            InitEvent();\n            SendBossActivityMsg();\n        }\n\n        void InitEvent()\n        {\n            ClearEvent();\n            Oscillator.Instance.secondEvent += OnTick;\n            DBManager.Instance.DB_UserNewWorldBossDB.onDataChanged += OnUserNewWorldBossDataChanged;\n            DBManager.Instance.DB_NewWorldBossDB.onDataChanged += OnNewWorldBossChanged;\n            MessageHub.inst.GetPortByAction(PortType.PUSH_NEW_WORLD_BOSS_DAILY_UPDATE).AddEvent(OnDailyUpdate);\n        }\n\n        void Clear()\n        {\n            ClearEvent();\n            custom_UICustomContainer.OnRefreshCell = null;\n        }\n\n        void ClearEvent()\n        {\n            Oscillator.Instance.secondEvent -= OnTick;\n            DBManager.Instance.DB_UserNewWorldBossDB.onDataChanged -= OnUserNewWorldBossDataChanged;\n            DBManager.Instance.DB_NewWorldBossDB.onDataChanged -= OnNewWorldBossChanged;\n            MessageHub.inst.GetPortByAction(PortType.PUSH_NEW_WORLD_BOSS_DAILY_UPDATE).RemoveEvent(OnDailyUpdate);\n        }\n\n        private void Update()\n        {\n            if (_dirty)\n            {\n                _dirty = false;\n                UpdateView();\n            }\n        }\n\n        #endregion\n\n        void BossActivityDataCallback(bool ret, object data)\n        {\n            if (ret)\n            {\n                _dirty = true;\n            }\n        }\n\n        void SendBossActivityMsg()\n        {\n            if (PlayerData.inst.userData == null)\n            {\n                return;\n            }\n\n            Hashtable ht = new Hashtable\n            {\n                [\"uid\"] = PlayerData.inst.userData.uid,\n                [\"world_id\"] = PlayerData.inst.userData.world_id,\n            };\n            LunarWorldBossManager.Instance.SendNewBossActivityDataMsg(this.gameObject, ht,\n                BossActivityDataCallback);\n  