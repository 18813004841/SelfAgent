        return FormatThousands(FormatBigIntegerWithOneDecimal(src, 1000000, round)) + \"M\";\n \n         return FormatThousands(src.ToString());\n     }\n \n     // Keep the first fractional digit without converting large values to double.\n     private static string FormatBigIntegerWithOneDecimal(BigInteger value, long divisor, bool round)\n     {\n         BigInteger quotient = BigInteger.DivRem(value, divisor, out BigInteger remainder);\n         BigInteger decimalBase = divisor / 10;\n         BigInteger decimalDigit = remainder / decimalBase;\n \n\n```\n\n## 完整变更文件\n\n### Game/Assets/_Script/Utils.cs\n```csharp\nusing System;\nusing System.Collections;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.Globalization;\nusing System.IO;\nusing System.Linq;\nusing System.Linq.Expressions;\nusing System.Reflection;\nusing System.Runtime.Serialization.Formatters.Binary;\nusing System.Security.Cryptography;\nusing System.Text;\nusing System.Text.RegularExpressions;\nusing _Script.CommonQuickUpgrade;\nusing ClientCore.Performance;\nusing ClientCore.ReloadModeSupport;\nusing Config2;\nusing DB;\nusing GW.Table;\nusing Gw.Terrain;\nusing I2.Loc;\nusing ICSharpCode.SharpZipLib.GZip;\nusing Pathfinding.Serialization.JsonFx;\nusing UI;\nusing UIOptimize.NewDragonLanguageChipTips.NewDragonLanguageChipTips;\nusing UIOptimize.NewDragonLanguageItemTips.NewDragonLanguageItemTips;\nusing UIOptimize.PetTips.PetTips;\nusing UniRx;\nusing UnityEngine;\nusing XTutorial;\nusing BigInteger = System.Numerics.BigInteger;\n// BigInteger is aliased to avoid colliding with UnityEngine vector types.\nusing Object = UnityEngine.Object;\nusing Random = UnityEngine.Random;\n\npublic class AAPoints\n{\n    public float x1, x2, x3, x4, y1, y2, y3, y4;\n}\n\npublic static partial class Utils\n{\n    public const int DRAGON_LEVELUP_PRIORITY = 0;\n    public const int LORD_LEVELUP_PRIORITY = DRAGON_LEVELUP_PRIORITY + 1;\n    public const int GROUPQUEST_PRIORITY = LORD_LEVELUP_PRIORITY + 1;\n    public const int SIGN_IN_PRIORITY = GROUPQUEST_PRIORITY + 1;\n    public const int EVENT_IN_PRIORITY = SIGN_IN_PRIORITY + 1;\n    public const int REBUILD_CITY_PRIORITY = EVENT_IN_PRIORITY + 1;\n    public const int BACK_FLOW_PRIORITY = REBUILD_CITY_PRIORITY + 1;\n\n\n    public const int IAPONEDOLLAR_PRIORITY = BACK_FLOW_PRIORITY + 1;\n    public const int STRONGHOLD_LVLUP_PRIORITY = IAPONEDOLLAR_PRIORITY + 1;\n\n\n    public const int RECOMMEND_PRIORITY = -1;\n    public const int CONNECTION_PRIORITY = 100;\n    public const long NPC_UID = 6000000000;\n\n    public enum SHOW_PRIORITY\n    {\n        TROOP_UNLOCK = 70,\n        UrbanBlockMonsterBattle\n    }\n    \n    static public GameObject AddChild(Transform parent, GameObject prefab, bool worldPositionStay = false)\n    {\n        if(!prefab)\n        {\n            return null;\n        }\n        \n        GameObject go = GameObject.Instantiate(prefab);\n\n        if (parent)\n        {\n            go.transform.SetParent(parent, worldPositionStay);            \n        }\n   \n        return go;\n    }\n    \n   \tstatic public GameObject AddChild(GameObject parent, GameObject prefab, bool worldPositionStay = false)\n    {\n        return AddChild(parent?.transform, prefab, worldPositionStay);\n    }\n   \t\n    public static void LogWithTime(string message)\n    {\n        D.Log(\"{0} : {1}\", DateTime.Now, message);\n    }\n\n    public static bool HasEmoji(string content)\n    {\n        var p = \"\\\\uD83C[\\\\uDF00-\\\\uDFFF]|\\\\uD83D[\\\\uDC00-\\\\uDE4F]\";\n        Regex regex = new Regex(p);\n        Match match = regex.Match(content);\n\n        if (match.Success)\n        {\n            return true;\n        }\n\n        return false;\n    }\n\n    public static string ClearEmoji(string content, string replaceItem = \"\")\n    {\n        var pat = \"\\\\uD83C[\\\\uDF00-\\\\uDFFF]|\\\\uD83D[\\\\uDC00-\\\\uDE4F]\";\n        Regex regex =\n            new Regex(pat, RegexOptions.IgnoreCase);\n        MatchCollection matchs = regex.Matches(content);\n\n        if (matchs.Count > 0)\n        {\n            List<string> tmp = new List<string>();\n            int index = 0;\n            foreach (Match match in matchs)\n            {\n                if (match.Success)\n                {\n                    GroupCollection groups = match.Groups;\n                    if (groups.Count > 0)\n                    {\n                        string url = groups[0].Value;\n                        // url = \"[url=\" + url + \"][u]\" + url + \"[/u][/url]\";\n                        tmp.Add(replaceItem);\n                        content = regex.Replace(content, \"{\" + index + \"}\", 1);\n                        index++;\n                    }\n                }\n            }\n\n            content = string.Format(content, tmp.ToArray());\n        }\n\n        return content;\n    }\n    \n    [DevSetting(cat: \"General\")] public static string sysLanguage = \"en-US\"; //\"de-DE\"\n\n    [DevSetting(cat: \"General\")] static public bool isDebugTest = false;\n\n    public static bool IsDebugTest\n    {\n        get\n        {\n            if (Application.isEditor)\n            {\n                return isDebugTest;\n            }\n#if !UNITY_DEBUG\n                return false;\n#endif\n            return false;\n        }\n    }\n\n    public static void ForceUnloadAssets()\n    {\n        //using (new ScopedProfiler(\"ForceUnloadAssets\"))\n        {\n#if UNITY_DEBUG\n            var watch = new Stopwatch();\n            watch.Start();\n#endif\n            //GameEngine.Instance.RequestUnloadUnusedAssets();\n            Resources.UnloadUnusedAssets();\n            //\t\tSystem.GC.Collect();\n\n#if UNITY_DEBUG\n            long elapsed = watch.ElapsedMilliseconds;\n            D.Log(\"[Utils]ForceUnloadAssets: {0} ms\", elapsed);\n            watch.Stop();\n#endif\n        }\n    }\n\n    public static string GetFlagIconPath(long flag)\n    {\n        flag = WonderFlagManager.Instance.GetMappedFlag(flag);\n        return \"icon_flag_\" + flag;\n    }\n\n    public static void RemoveAllChildren(GameObject parent, bool immediate = false)\n    {\n        if (parent == null)\n        {\n            return;\n        }\n\n        int childCount = parent.transform.childCount;\n        for (int i = childCount - 1; i >= 0; i--)\n        {\n            var child = parent.transform.GetChild(i);\n            child.gameObject.SetActive(false);\n            child.parent = null;\n            if (immediate)\n            {\n                Object.DestroyImmediate(child.gameObject);\n            }\n            else\n            {\n                Object.Destroy(child.gameObject);\n            }\n        }\n    }\n\n    public static bool IsDragonHatchingJob(JobHandle job)\n    {\n        if (job != null)\n        {\n            Hashtable data = job.Data as Hashtable;\n            if (job.GetJobEvent() == JobEvent.JOB_TRAIN_TROOP && data != null && data.ContainsKey(\"troop_class\"))\n            {\n                string troop_class = data[\"troop_class\"].ToString();\n                return (troop_class == \"dragon\");\n            }\n        }\n\n        return false;\n    }\n\n    [Obsolete(\"Don't support parse Int in payload any more, only support parse Long\", true)]\n    public static int TryParseInt(Hashtable data, object key)\n    {\n        int result = 0;\n        if (data != null &&\n            data.ContainsKey(key) && data[key] != null)\n        {\n            string tmp = data[key].ToString();\n            int.TryParse(tmp, out result);\n        }\n\n        return result;\n    }\n\n    public static long TryParseLong(Hashtable data, object key, long defaultValue = 0)\n    {\n        long result = defaultValue;\n        if (data != null &&\n            data.ContainsKey(key) && data[key] != null)\n        {\n            string tmp = data[key].ToString();\n            long.TryParse(tmp, out result);\n        }\n\n        return result;\n    }\n\n    public static double TryParseDouble(Hashtable data, object key, long defaultValue = 0)\n    {\n        double result = defaultValue;\n        if (data != null &&\n            data.ContainsKey(key) && data[key] != null)\n        {\n            string tmp = data[key].ToString();\n            double.TryParse(tmp, out result);\n        }\n\n        return result;\n    }\n\n    /// <summary>\n    /// 我的大使馆里是否有增援\n    /// </summary>\n    /// <returns></returns>\n    public static bool IsHelpedMarchInEmbassy()\n    {\n        List<long> reinforceList = DBManager.Instance.DB_March.GetTargetListByType(MarchData.MarchType.reinforce);\n\n        if (reinforceList != null)\n        {\n            for (int i = 0; i < reinforceList.Count; i++)\n            {\n                MarchData tmpMarchData = DBManager.Instance.DB_March.Get(reinforceList[i]);\n                if (tmpMarchData != null\n                    && tmpMarchData.troopsInfo.troops != null\n                    && tmpMarchData.state == MarchData.MarchState.reinforcing)\n                {\n                    return true;\n                }\n            }\n        }\n\n        return false;\n    }\n\n    public static bool IsMarchInCurrentKingdom()\n    {\n        List<MarchData> marches = DBManager.Instance.DB_March.Marches;\n        for (int i = 0; i < marches.Count; i++)\n        {\n            if (marches[i].ownerUid == PlayerData.inst.uid)\n            {\n                return true;\n            }\n        }\n\n        List<RallyData> rallyes =\n            DBManager.Instance.DB_Rally.GetRallyesByAllianceIdInCurrentKingdom(PlayerData.inst.allianceId);\n        for (int i = 0; i < rallyes.Count; ++i)\n        {\n            if (rallyes[i].ownerAllianceId != PlayerData.inst.allianceId &&\n                rallyes[i].targetAllianceId == PlayerData.inst.allianceId)\n            {\n                if (rallyes[i].ownerUid == PlayerData.inst.uid)\n                {\n                    return true;\n                }\n            }\n        }\n\n        return false;\n    }\n\n    public static bool IsSomeoneAttackMe()\n    {\n        List<MarchData> marches = DBManager.Instance.DB_March.Marches;\n        for (int i = 0; i < marches.Count; i++)\n        {\n            if (marches[i].IsAttackMe)\n            {\n                return true;\n            }\n        }\n\n        return false;\n    }\n\n    public static bool IsSomeoneAttackingMyFortress(long fortressId)\n    {\n        if (fortressId == AllianceBuildingData.INVALID_ID)\n        {\n            return false;\n        }\n\n        AllianceBuildingData fortressData = DBManager.Instance.DB_AllianceBuilding.Get(fortressId);\n        if (fortressData == null)\n        {\n            return false;\n        }\n\n        if (fortressData.State == AllianceBuildingData.BuildingState.DEMOLISHING)\n        {\n            return true;\n        }\n\n        List<MarchData> marches = DBManager.Instance.DB_March.Marches;\n        for (int i = 0; i < marches.Count; i++)\n        {\n            if (marches[i].ownerAllianceId != PlayerData.inst.allianceId)\n            {\n                if (marches[i].IsAttackingFortress(fortressId) || marches[i].IsScoutingFortress(fortressId))\n                {\n                    return true;\n                }\n            }\n        }\n\n        List<RallyData> rallyes =\n            DBManager.Instance.DB_Rally.GetRallyesByAllianceIdInCurrentKingdom(PlayerData.inst.allianceId);\n        for (int i = 0; i < rallyes.Count; ++i)\n        {\n            if (rallyes[i].ownerAllianceId != PlayerData.inst.allianceId &&\n                rallyes[i].targetAllianceId == PlayerData.inst.allianceId)\n            {\n                if (rallyes[i].fortressId == fortressId)\n                {\n                    return true;\n                }\n            }\n        }\n\n        return false;\n    }\n\n\n    public static bool IsNpc(long uid)\n    {\n        return uid >= ConfigNPC.NPC_UID;\n    }\n\n    public static long GetNpcId(long uid)\n    {\n        if (IsNpc(uid))\n        {\n            return uid - ConfigNPC.NPC_UID;\n        }\n\n        return uid;\n    }\n\n    public static void ShowException(int errno)\n    {\n        UIManager.inst.ShowSystemBlocker(UIManager.SystemBlockerType.commonSystemBlocker,\n            new CommonBlocker.Parameter\n            {\n                type = CommonBlocker.CommonBlockerType.confirmation,\n                displayType = CommonBlocker.PanelChangeType.confirmationDescription |\n                              CommonBlocker.PanelChangeType.confirmationButtonText |\n                              CommonBlocker.PanelChangeType.title |\n                              CommonBlocker.PanelChangeType.iconConfirmationButton,\n                title = XLAT(\"exception_title\"),\n                buttonEventText = XLAT(\"exception_button\"),\n                descriptionText = ScriptLocalization.Get(string.Format(\"exception_{0}\", errno)),\n                buttonEvent = null\n            });\n    }\n\n    public static char AllianceNameValidator(string allianceName, int charIndex, char addedChar)\n    {\n        allianceName = allianceName.Trim();\n        byte[] allianceNameBuffer = Encoding.UTF8.GetBytes(allianceName);\n\n        if (allianceNameBuffer.Length >= 20)\n        {\n            return (char)0;\n        }\n\n        return addedChar;\n\n//\t\tif(char.IsWhiteSpace (addedChar) || char.IsLetterOrDigit (addedChar))\n//\t\t{\n//\t\t\treturn addedChar;\n//\t\t}\n\n//\t\treturn (char)0;\n    }\n\n    [ReloadWithValue(false)] private static bool stop;\n    [ReloadWithValue(null)] private static Coroutine _coroutinue;\n    [ReloadWithValue(null)] private static CompositeDisposable _disposable4ShowTips = null;\n    [ReloadWithValue(null)] private static UIManager.AsyncHandler<Popup> _lastItemTipHandler;\n\n    public static void StopShowItemTip()\n    {\n        stop = true;\n//        if (_coroutinue != null)\n//        {\n//            StopCoroutine(_coroutinue);\n//            _coroutinue = null;\n//        }\n\n        if (null != _disposable4ShowTips)\n        {\n            _disposable4ShowTips.Clear();\n        }\n\n        if (_lastItemTipHandler != null)\n        {\n            _lastItemTipHandler.Dispose();\n            _lastItemTipHandler = null;\n        }\n    }\n\n    public static void SetItemNormalName(UILabel label, long quailty)\n    {\n        if (label != null)\n        {\n            EquipmentManager.Instance.ConfigQualityLabelWithColor(label, quailty);\n        }\n    }\n\n    public static void SetItemIcon(UITexture tex, long itemItId)\n    {\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemItId);\n\n        if (tex != null && info != null)\n        {\n            BuilderFactory.Instance.HandyBuild(tex, info.ImagePath);\n        }\n    }\n\n    public static void SetItemNormalBackground(UITexture background, long quailty)\n    {\n        if (background != null)\n        {\n            BuilderFactory.Instance.HandyBuild(background, GetQualityImagePath(quailty));\n        }\n    }\n\n    public static void SetItemBackground(UITexture background, long itemId)\n    {\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        if (background != null\n            && info != null)\n        {\n            BuilderFactory.Instance.HandyBuild(background, info.QualityImagePath);\n        }\n    }\n\n    public static void SetItemName(UILabel label, long itemId)\n    {\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        if (label != null\n            && info != null)\n        {\n            label.text = info.LocName;\n            //EquipmentManager.Instance.ConfigQualityLabelWithColor(label, info.Quality);\n        }\n    }\n\n    public static void SetItemNameWithoutQualityColor(UILabel label, long itemId)\n    {\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        if (label != null && info != null)\n        {\n            label.text = info.LocName;\n        }\n    }\n\n    public static void DelayShowTip(long itemId, Transform focous, long equipmentid = 0L,\n        long userId = 0L, int enhanced = 0, float delay = 1.0f)\n    {\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        if (info == null)\n        {\n            return;\n        }\n\n        if (!focous)\n            return;\n\n        stop = false;\n        UIScrollView trigger = focous.GetComponentInParent<UIScrollView>();\n        if (trigger)\n        {\n            trigger.onDragStarted -= OnItemTipStartDragging;\n            trigger.onDragStarted += OnItemTipStartDragging;\n        }\n\n        DelayShowItemTipAsObserverable(itemId, focous, equipmentid, userId, enhanced, delay);\n    }\n\n    static void DelayShowItemTipAsObserverable(long itemId, Transform focous, long equipmentid = 0L,\n        long userId = 0L, int enhanced = 0, float delay = 1.0f)\n    {\n        if (null == _disposable4ShowTips)\n        {\n            _disposable4ShowTips = new CompositeDisposable();\n        }\n\n        _disposable4ShowTips.Add(DoSthDelaySeconds(delay, delegate\n        {\n            if (!stop)\n            {\n                ShowItemTip(itemId, focous, equipmentid, userId, enhanced);\n            }\n        }, focous.gameObject));\n    }\n\n\n    static void OnItemTipStartDragging()\n    {\n        StopShowItemTip();\n    }\n\n    public static void ShowItemTip(long itemId, Transform focous, long equipmentid = 0L,\n        long userId = 0L, int enhanced = 0,bool disableTipsGetMore = false)\n    {\n        StopShowItemTip();\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        if (info != null && focous != null)\n        {\n            if (CheckSpecialItemTips(info, focous, equipmentid)) return;\n\n            if (!UIManager.inst.IsPopupExist\n                    (UIManager.PopupType.ItemTipPopup))\n            {\n                ItemTipPopup.Parameter param = new ItemTipPopup.Parameter();\n                param.itemId = itemId;\n                param.focus = focous;\n                param.equipmentId = equipmentid;\n                param.userId = userId;\n                param.enhanced = enhanced;\n\n                param.disableTipsGetMore = disableTipsGetMore;\n                // _lastItemTipPopup = UIManager.inst.OpenPopup(UIManager.PopupType.ItemTipPopup, param);\n\n                _lastItemTipHandler = UIManager.inst.OpenPopupAsync(UIManager.PopupType.ItemTipPopup, param);\n            }\n        }\n    }\n\n    public static void ShowItemTipWithAmount(long itemId, Transform focous, long amount = 0L)\n    {\n        StopShowItemTip();\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        if (info != null && focous != null)\n        {\n            if (CheckSpecialItemTips(info, focous, 0)) return;\n\n            if (!UIManager.inst.IsPopupExist\n                    (UIManager.PopupType.ItemTipPopup))\n            {\n                ItemTipPopup.Parameter param = new ItemTipPopup.Parameter();\n                param.itemId = itemId;\n                param.itemAmount = amount;\n                param.focus = focous;\n                _lastItemTipHandler = UIManager.inst.OpenPopupAsync(UIManager.PopupType.ItemTipPopup, param);\n            }\n        }\n    }\n\n    public static void ShowItemTip(InventoryItemData itemData, Transform focous)\n    {\n        StopShowItemTip();\n\n        if (itemData == null)\n        {\n            return;\n        }\n\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(itemData.equipment.itemID);\n        if (info != null && focous != null)\n        {\n            if (CheckSpecialItemTips(info, focous)) return;\n\n            if (!UIManager.inst.IsPopupExist\n                    (UIManager.PopupType.ItemTipPopup))\n            {\n                ItemTipPopup.Parameter param = new ItemTipPopup.Parameter();\n                param.itemId = itemData.equipment.itemID;\n                param.focus = focous;\n                param.equipmentId = itemData.itemId;\n                param.userId = itemData.uid;\n                param.inventoryItemData = itemData;\n                _lastItemTipHandler = UIManager.inst.OpenPopupAsync(UIManager.PopupType.ItemTipPopup, param);\n            }\n        }\n    }\n\n    public static bool CheckSpecialItemTips(ItemlistInfo itemInfo, Transform focus, long stoneBagId = 0)\n    {\n        if (itemInfo != null)\n        {\n            if (itemInfo.ItemType == ItemBag.ItemType.dragon_stone)\n            {\n                DragonStoneGroupInfo info =\n                    ConfigManager2.Instance.DB_DragonStoneGroup.GetStoneGroupInfoByItemId(itemInfo.InternalId);\n                if (info != null)\n                {\n                    ShowDragonStoneTips(info.InternalId, focus, stoneBagId);\n                }\n\n                return true;\n            }\n\n            if (itemInfo.ItemType == ItemBag.ItemType.dragon_stone_chip)\n            {\n                ShowDragonStoneChipTips(itemInfo.InternalId, focus);\n                return true;\n            }\n\n            if (itemInfo.ItemType == ItemBag.ItemType.pet)\n            {\n                ShowPetTips(itemInfo, focus);\n                return true;\n            }\n        }\n\n        return false;\n    }\n\n\n    /// <summary>\n    /// 龙语石碎片Tips\n    /// </summary>\n    /// <param name=\"chipConfigId\"></param>\n    /// <param name=\"focus\"></param>\n    public static void ShowDragonStoneChipTips(long chipInternalId, Transform focus, bool isShowComposeBtn = true)\n    {\n        if (!UIManager.inst.IsPopupExist(UIManager.PopupType.NewDragonLanguageChipTips))\n        {\n            var param = new NewDragonLanguageChipTips.Parameter();\n            param.chipInternalId = chipInternalId;\n            param.focus = focus;\n            param.isShowOpenCompose = isShowComposeBtn;\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.NewDragonLanguageChipTips, param);\n        }\n    }\n\n    public static void ShowDragonStoneTips(long stoneInternalId, Transform focus, long stoneId = 0)\n    {\n        if (!UIManager.inst.IsPopupExist\n                (UIManager.PopupType.NewDragonLanguageTips))\n        {\n            var param = new NewDragonLanguageItemTips.Parameter();\n            param.ParentBag = null;\n            param.focus = focus;\n            param.mode = NewDragonLanguageItemTips.DragonTipsEnum.DragonStoneLotteryPreview;\n            param.stoneConfigId = stoneInternalId;\n\n            if (stoneId > 0)\n            {\n                DragonStoneData stoneData = DBManager.Instance.DB_DragonStoneDB.Get(stoneId);\n                param.data1 = stoneData;\n                param.mode = NewDragonLanguageItemTips.DragonTipsEnum.DragonStoneLottery;\n            }\n\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.NewDragonLanguageTips, param);\n        }\n    }\n\n    public static void ShowItemTip(ParliamentHeroArtifactInfo parliamentHeroArtifactInfo, Transform focous)\n    {\n        StopShowItemTip();\n\n        if (parliamentHeroArtifactInfo == null)\n        {\n            return;\n        }\n\n        ItemlistInfo info = ConfigManager2.Instance.DB_Itemlist.GetItem(parliamentHeroArtifactInfo.ItemId);\n        if (info != null && focous != null)\n        {\n            if (CheckSpecialItemTips(info, focous)) return;\n\n            if (!UIManager.inst.IsPopupExist\n                    (UIManager.PopupType.ItemTipPopup))\n            {\n                ItemTipPopup.Parameter param = new ItemTipPopup.Parameter();\n                param.itemId = parliamentHeroArtifactInfo.ItemId;\n                param.focus = focous;\n                param.artifactId = parliamentHeroArtifactInfo.InternalId;\n                //param.equipmentId = itemData.itemId;\n                //param.userId = itemData.uid;\n                //param.inventoryItemData = itemData;\n                _lastItemTipHandler = UIManager.inst.OpenPopupAsync(UIManager.PopupType.ItemTipPopup, param);\n            }\n        }\n    }\n\n    public static void DelayShowCustomTip(ItemTipCustomInfo.ItemTipData itemTipData, Transform focus)\n    {\n        stop = false;\n\n        DelayShowCustomTipAsObserverable(itemTipData, focus);\n\n//        _coroutinue = ExecuteInSecs(\n//            1.0f,\n//            delegate\n//            {\n//                if (!stop)\n//                {\n//                    ShowCustomItemTip(itemTipData, focus);\n//                }\n//            });\n    }\n\n    static void DelayShowCustomTipAsObserverable(ItemTipCustomInfo.ItemTipData itemTipData, Transform focus)\n    {\n        if (null == _disposable4ShowTips)\n        {\n            _disposable4ShowTips = new CompositeDisposable();\n        }\n\n        _disposable4ShowTips.Add(DoSthDelaySeconds(1.0f, delegate\n        {\n            if (!stop)\n            {\n                ShowCustomItemTip(itemTipData, focus);\n            }\n        }, focus.gameObject));\n    }\n\n    public static void ShowCustomItemTip(ItemTipCustomInfo.ItemTipData itemTipData, Transform focus)\n    {\n        StopShowItemTip();\n\n        if (!UIManager.inst.IsPopupExist(UIManager.PopupType.ItemTipPopup))\n        {\n            ItemTipPopup.Parameter param = new ItemTipPopup.Parameter();\n            param.customTip = true;\n            param.customItemTipData = itemTipData;\n            param.focus = focus;\n\n            _lastItemTipHandler = UIManager.inst.OpenPopupAsync(UIManager.PopupType.ItemTipPopup, param);\n        }\n    }\n\n    public static void ShowPetTips(ItemlistInfo itemInfo, Transform focus)\n    {\n        if (!UIManager.inst.IsPopupExist(UIManager.PopupType.PetTips))\n        {\n            PetTips.Parameter param = new PetTips.Parameter();\n            param.itemlistInfo = itemInfo;\n            param.focus = focus;\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.PetTips, param);\n        }\n    }\n\n    public static string GetQualityImagePath(long quality)\n    {\n        string FRAME_PATH_PREFIX = \"Texture/Equipment/frame_equipment_\";\n\n        return FRAME_PATH_PREFIX + quality;\n    }\n\n    public static string Join<T>(List<T> sources, string separator = \",\")\n    {\n        if (sources == null || sources.Count == 0)\n        {\n            return \"\";\n        }\n\n        string result = \"\";\n        int count = sources.Count;\n        for (int i = 0; i < sources.Count; i++)\n        {\n            result += sources[i].ToString();\n            if (i != count - 1)\n            {\n                result += \",\";\n            }\n        }\n\n        return result;\n    }\n\n    public static void RefreshAllVisibleBlock(Coordinate location, Action<bool, object> callback = null)\n    {\n#if UNITY_EDITOR\n        D.Error($\"#RB# location = {location}\");\n#endif\n\n        DynamicMapData mapData = MapUtils.GetMapData(GameEngine.Instance.CurrentGameMode);\n\n\n        BlockData blockData = mapData.GetBlockAt(location);\n        if (blockData != null)\n        {\n            long k = location.K;\n            long id = blockData.BlockId;\n            Hashtable htRequest = new Hashtable();\n            htRequest[\"leave\"] = new ArrayList();\n            htRequest[\"enter\"] = new ArrayList\n            {\n                new ArrayList\n                {\n                    k,\n                    id\n                }\n            };\n            htRequest[\"city_id\"] = PlayerData.inst.cityId;\n\n            var blocks = mapData.AllVisibleBlockData;\n            if (null != blocks)\n            {\n                for (int i = 0, len = blocks.Count; i < len; i++)\n                {\n                    blocks[i].ResetToTerrain();\n                }\n            }\n\n            RequestManager.Instance.SendLoader(PortType.MAP_ENTER_KINGDOMBLOCK, htRequest, callback, true, true);\n        }\n    }\n\n    public static void RefreshBlock(Coordinate location, Action<bool, object> callback = null)\n    {\n        DynamicMapData mapData = MapUtils.GetMapData(GameEngine.Instance.CurrentGameMode);\n        BlockData blockData = mapData.GetBlockAt(location);\n        if (blockData != null)\n        {\n            blockData.ResetToTerrain();\n\n            long k = location.K;\n            long id = blockData.BlockId;\n            Hashtable htRequest = new Hashtable();\n            htRequest[\"leave\"] = new ArrayList();\n            htRequest[\"enter\"] = new ArrayList\n            {\n                new ArrayList\n                {\n                    k,\n                    id\n                }\n            };\n            htRequest[\"city_id\"] = PlayerData.inst.cityId;\n\n            RequestManager.Instance.SendLoader(PortType.MAP_ENTER_KINGDOMBLOCK, htRequest, callback, true, true);\n        }\n    }\n\n    public static void RefreshAllVisibleBlock(Action<bool, object> callback = null)\n    {\n        DynamicMapData mapData = MapUtils.GetMapData(GameEngine.Instance.CurrentGameMode);\n\n        if (null == mapData || GameEngine.Instance.CurrentGameMode != GameEngine.GameMode.PVPMode)\n            return;\n\n        var allBlocks = mapData.AllVisibleBlockData;\n        int lenBlocks = allBlocks.Count;\n\n        if (!TileCamera.IsAvailable())\n            return;\n\n        long k = mapData.KingdomViewKid;\n        ArrayList postData = new ArrayList(lenBlocks + 1);\n        for (int i = 0; i < lenBlocks; i++)\n        {\n            var block = allBlocks[i];\n            postData.Add(new ArrayList\n            {\n                k,\n                block.BlockId\n            });\n            block.ResetToTerrain();\n        }\n\n        Hashtable htRequest = new Hashtable();\n        htRequest[\"leave\"] = new ArrayList();\n        htRequest[\"enter\"] = postData;\n        htRequest[\"city_id\"] = PlayerData.inst.cityId;\n\n        RequestManager.Instance.SendLoader(PortType.MAP_ENTER_KINGDOMBLOCK, htRequest, callback, true, true);\n    }\n\n    public static bool IsR4Member()\n    {\n        long title = AllianceTitle.VASSAL;\n        if (PlayerData.inst.allianceData == null)\n        {\n            return false;\n        }\n\n        AllianceMemberData member = PlayerData.inst.allianceData.members.Get(PlayerData.inst.userData.uid);\n        if (member != null)\n        {\n            title = member.title;\n        }\n\n        if (IsAllianceOfficial)\n        {\n            return true;\n        }\n\n        return title >= AllianceTitle.DUKE;\n    }\n    \n    public static bool IsR4Member(AllianceMemberData member)\n    {\n        if (member == null)\n            return false;\n        \n        long title = AllianceTitle.VASSAL;\n        if (member != null)\n        {\n            title = member.title;\n        }\n\n        if (member.Official > 0)\n        {\n            return true;\n        }\n\n        return title >= AllianceTitle.DUKE;\n    }\n    \n    /// <summary>\n    /// 是否满足成员权限\n    /// rightLevel == 1 R1\n    /// rightLevel == 2 R2\n    /// ...\n    /// </summary>\n    /// <returns></returns>\n    public static bool IsAllianceMemberRight(int rightLevel)\n    {\n        long title = AllianceTitle.VASSAL;\n        if (PlayerData.inst.allianceData == null)\n        {\n            return false;\n        }\n\n        AllianceMemberData member = PlayerData.inst.allianceData.members.Get(PlayerData.inst.userData.uid);\n        if (member != null)\n        {\n            title = member.title;\n        }\n\n        if (IsAllianceOfficial)\n        {\n            return true;\n        }\n\n        return title >= rightLevel;\n    }\n\n    public static IAPStorePackage GetIapPackageByGroupId(long groupID)\n    {\n        List<IAPStorePackage> packageList = IAPStorePackagePayload.Instance.GetAllPackages();\n        IAPStorePackage package = null;\n\n        if (null != packageList && packageList.Count > 0)\n        {\n            for (int i = 0; i < packageList.Count; i++)\n            {\n                if (packageList[i].group.InternalId == groupID)\n                {\n                    package = packageList[i];\n                    break;\n                }\n            }\n        }\n\n        return package;\n    }\n\n    public static IAPStorePackage GetIapPackageByGroupList(List<IapPackageGroupInfo> list,\n        out IapPackageGroupInfo groupInfo)\n    {\n        groupInfo = null;\n        if (list == null || list.Count == 0)\n            return null;\n\n        List<IAPStorePackage> packageList = IAPStorePackagePayload.Instance.GetAllPackages();\n        if (null == packageList || packageList.Count == 0)\n            return null;\n\n        IAPStorePackage package = null;\n        for (int i = 0; i < packageList.Count; i++)\n        {\n            foreach (var info in list)\n            {\n                if (info.InternalId == packageList[i].group.InternalId)\n                {\n                    package = packageList[i];\n                    groupInfo = info;\n                    break;\n                }\n            }\n\n            if (package != null)\n            {\n                break;\n            }\n        }\n\n        return package;\n    }\n\n\n    public static IAPStorePackage GetIapPackageByGroupId(string groupID)\n    {\n        List<IAPStorePackage> packageList = IAPStorePackagePayload.Instance.GetAllPackages();\n        IAPStorePackage package = null;\n\n        if (null != packageList && packageList.Count > 0)\n        {\n            for (int i = 0; i < packageList.Count; i++)\n            {\n                if (packageList[i].group.Id == groupID)\n                {\n                    package = packageList[i];\n                    break;\n                }\n            }\n        }\n\n        return package;\n    }\n\n    public static void ShowWarning(string content, ChooseConfirmationBox.ButtonState state, Action callBack,\n        string title = null)\n    {\n        if (string.IsNullOrEmpty(title))\n        {\n            title = ScriptLocalization.Get(\"account_warning_title\");\n        }\n\n\n        string left = ScriptLocalization.Get(\"id_uppercase_cancel\");\n        string rigth = ScriptLocalization.Get(\"id_uppercase_confirm\");\n\n\n        ChooseConfirmationBox.Parameter parameter = new ChooseConfirmationBox.Parameter();\n        parameter.title = title;\n        parameter.message = content;\n        parameter.yesOrOklabel_left = left;\n        parameter.nolabel_right = rigth;\n        parameter.buttonState = state;\n        parameter.yesOrOkHandler_right = null;\n        parameter.noHandler_left = callBack;\n        parameter.closeHandler = null;\n\n        try\n        {\n            UIManager.inst.OpenPopupAsync(UIManager.PopupType.ChooseConfirmationBox, parameter);\n        }\n        catch (Exception e)\n        {\n            D.Error(\"Can not found ChooseConfirmationBox!\");\n            throw;\n        }\n    }\n\n    public static void ShowConfirm(string content, Action callback = null, string title = null,\n        string leftBtnString = null, string rightBtnString = null,\n        NGUIText.Alignment contentAlignment = NGUIText.Alignment.Automatic)\n    {\n        MessageBoxWith2ButtonsPopup.Parameter parameter =\n            new MessageBoxWith2ButtonsPopup.Parameter();\n        parameter.titleString = null == title ? XLAT(\"id_uppercase_confirm\") : title;\n        parameter.contentString = content;\n        parameter.leftLabelString = null == leftBtnString ? XLAT(\"id_uppercase_cancel\") : leftBtnString;\n        parameter.rightLabelString = null == rightBtnString ? XLAT(\"id_uppercase_confirm\") : rightBtnString;\n        parameter.onRightBtnClick = () => { callback?.Invoke(); };\n        parameter.contentAlignment = contentAlignment;\n\n        UIManager.inst.OpenPopupAsync(UIManager.PopupType.MessageBoxWith2ButtonsPopup, parameter);\n    }\n\n    public static bool IsR5Member()\n    {\n        long title = AllianceTitle.VASSAL;\n        if (PlayerData.inst.allianceData == null)\n        {\n            return false;\n        }\n\n        AllianceMemberData member = PlayerData.inst.allianceData.members.Get(PlayerData.inst.userData.uid);\n        if (member != null)\n        {\n            title = member.title;\n        }\n\n        return title == AllianceTitle.LORD;\n    }\n\n    /// <summary>\n    /// 判断是不是官员\n    /// </summary>\n    public static bool IsAllianceOfficial\n    {\n        get\n        {\n            if (!PlayerData.inst.CheckAllianceDataValid)\n            {\n                return false;\n            }\n\n            var members = PlayerData.inst.allianceData.members;\n            if (members != null)\n            {\n                var member = members.Get(PlayerData.inst.userData.uid);\n                return member?.Official > 0;\n            }\n\n            return false;\n        }\n    }\n\n    /// <summary>\n    /// 判断是不是盟主或者官员身分\n    /// </summary>\n    public static bool IsR5OrOfficial\n    {\n        get\n        {\n            if (IsAllianceOfficial)\n                return true;\n            if (IsR5Member())\n            {\n                return true;\n            }\n\n            return false;\n        }\n    }\npublic static bool IsR4OrR5OrAllianceOfficial\n    {\n        get\n        {\n            if (IsR4Member())\n            {\n                return true;\n            }\n\n            if (IsR5Member())\n            {\n                return true;\n            }\n\n            if (IsAllianceOfficial)\n            {\n                return true;\n            }\n\n            return false;\n        }\n    }\n    public static bool IsAllianceLeader()\n    {\n        return PlayerData.inst.allianceData != null && PlayerData.inst.allianceData.creatorId == PlayerData.inst.uid;\n    }\n\n    public static CityData GetR5PlayerData()\n    {\n        if (PlayerData.inst.allianceId <= 0)\n        {\n            return null;\n        }\n\n        if (PlayerData.inst.allianceData == null)\n        {\n            return null;\n        }\n\n        long r5Uid = 0;\n        var members = PlayerData.inst.allianceData.members.datas;\n        foreach (var it in members)\n        {\n            if (it.Value.title == AllianceTitle.VASSAL)\n            {\n                r5Uid = it.Value.uid;\n                break;\n            }\n        }\n\n        if (r5Uid == 0)\n        {\n            return null;\n        }\n\n        return DBManager.Instance.DB_City.GetByUid(r5Uid);\n    }\n\n    public static int GetPlayerAllianceTempleLevel()\n    {\n        string DRAGON_ALTAR_TECH_TYPE = \"alliance_temple_level_1\";\n\n        AllianceTechData allianceTechData =\n            DBManager.Instance.DB_AllianceTech.GetCurAllicenTechByType(DRAGON_ALTAR_TECH_TYPE);\n        if (allianceTechData != null)\n        {\n            var techInfo =\n                ConfigManager2.Instance.DB_AllianceResearchMainNew.GetAllianceTechInfoById(allianceTechData.researchId);\n            // AllianceNewResearchMainInfo techInfo =\n            //     ConfigManager.inst.DB_ConfigAllianceNewResearchMain\n            //         .GetAllianceTechInfoById(allianceTechData.researchId);\n            if (techInfo != null)\n            {\n                return (int)techInfo.Level;\n            }\n        }\n\n        return 0;\n    }\n\n    public static string GetUserTitleIconPath(long title)\n    {\n        WonderTitleInfo wonderTitleInfo = ConfigManager.inst.DB_WonderTitle.Get(title.ToString());\n\n        if (wonderTitleInfo != null)\n        {\n            return \"Texture/Kingdom/\" + wonderTitleInfo.icon;\n        }\n\n        return \"\";\n    }\n\n    public static string GetUserTitleBgPath(long title)\n    {\n        WonderTitleInfo wonderTitleInfo = ConfigManager.inst.DB_WonderTitle.Get(title.ToString());\n\n        if (wonderTitleInfo != null)\n        {\n            if (wonderTitleInfo.titleType == 0)\n            {\n                return \"Texture/Kingdom/kingdom_map_title_base_positive\";\n            }\n\n            return \"Texture/Kingdom/kingdom_map_title_base_negative\";\n        }\n\n        return \"\";\n    }\n\n    public static double GetWallDefenceLimit()\n    {\n        float baseValue = 0; //DB.DBManager.Instance.DB_Local_Benefit.Get(\"prop_city_defense_value\").total;\n        double defenseLimit = ConfigManager.inst.DB_BenefitCalc.GetFinalData(baseValue,\n            ConfigBenefitCalc.ConfigBenefitCalcConst.CALC_CITY_DEFENSE);\n        return defenseLimit;\n    }\n\n    public static bool CheckGoldEnough(string gold_config, bool needToast = true)\n    {\n        GameConfigsInfo info = ConfigManager2.Instance.DB_GameConfigs.GetData(gold_config);\n        int price = 0;\n        if (info != null)\n        {\n            price = info.ValueInt;\n        }\n\n        if (price > PlayerData.inst.userData.currency.gold)\n        {\n            if (needToast)\n            {\n                UIManager.inst.toast.Show(XLAT(\"toast_not_enough_gold\"));\n            }\n\n            return false;\n        }\n\n        return true;\n    }\n\n    public static bool ShowNotEnoughGoldTip()\n    {\n        if (!ShowIAPStore())\n        {\n            UIManager.inst.toast.Show(ScriptLocalization.Get(\"toast_insufficient_gold_tip\"));\n            return true;\n        }\n\n        return false;\n    }\n\n    public static void ShowNotEnoughGoldTipOrGoToIapCenter(IapCenterView.TagType tagType = IapCenterView.TagType.None)\n    {\n        if (!ShowIAPCenter(tagType))\n        {\n            UIManager.inst.toast.Show(ScriptLocalization.Get(\"toast_insufficient_gold_tip\"));\n        }\n    }\n\n    public static void SetPriceToLabel(UILabel label, int gold)\n    {\n        Color normalColor = new Color(247f / 255f, 204f / 255f, 1f / 255f, 1f);\n        label.text = FormatThousands(gold.ToString());\n        if (gold > PlayerData.inst.hostPlayer.Currency)\n        {\n            label.color = Color.red;\n        }\n        else\n        {\n            label.color = normalColor;\n        }\n    }\n\n    public static void SetPriceToLabel(UILabel label, long gold)\n    {\n        if (null == label)\n            return;\n        Color normalColor = new Color(246f / 255f, 243f / 255f, 231f / 255f, 1f);\n        label.text = FormatThousands(gold.ToString());\n        if (gold > PlayerData.inst.hostPlayer.Currency)\n        {\n            label.color = new Color(204 / 255f, 71 / 255f, 71 / 255f, 1f);\n        }\n        else\n        {\n            label.color = normalColor;\n        }\n    }\n\n    public static string FormatTimeAgo(long _sendTime)\n    {\n        int leftTime = (NetServerTime.Instance.ServerTimestamp - (int)_sendTime) / 60;\n        int month, day, hour, min;\n        int monthInMin = 30 * 24 * 60;\n        int dayInMin = 24 * 60;\n        int hourInMin = 60;\n\n        bool monthExist;\n        bool monthDayExist;\n        bool monthDayHourExist;\n        bool monthDayHourMinExist;\n        monthExist = monthDayExist = monthDayHourExist = monthDayHourMinExist = false;\n\n        month = leftTime / monthInMin;\n        leftTime -= month * monthInMin;\n        monthExist |= monthDayExist |= monthDayHourExist |= monthDayHourMinExist |= month > 0;\n\n\n        day = leftTime / dayInMin;\n        leftTime -= day * dayInMin;\n        monthDayExist |= monthDayHourExist |= monthDayHourMinExist |= day > 0;\n\n        hour = leftTime / hourInMin;\n        leftTime -= hour * hourInMin;\n        monthDayHourExist |= monthDayHourMinExist |= hour > 0;\n\n        min = leftTime;\n        monthDayHourMinExist |= min > 0;\n\n        if (!monthDayHourMinExist)\n        {\n            return \"less than 1 min\";\n        }\n\n        return string.Format(\"{0}{1}{2}{3} ago\",\n            (monthExist ? string.Format(\"{0} Month\", month) : string.Empty),\n            (monthDayExist ? string.Format(\"{0} Day\", day) : string.Empty),\n            (monthDayHourExist ? string.Format(\"{0} Hour\", hour) : string.Empty),\n            (monthDayHourMinExist ? string.Format(\"{0} Min\", min) : string.Empty));\n    }\n\n    public static string FormatOfflineTime(long duration)\n    {\n        long leftTime = duration / 60;\n\n        const long hour = 60;\n        const long day = 24 * hour;\n        const long month = 30 * day;\n        const long year = 365 * day;\n\n        long Y = leftTime / year;\n        if (Y >= 1)\n        {\n            return string.Format(ScriptLocalization.Get(\"alliance_members_online_time_years\"), Y);\n        }\n\n//\t\tlong M = leftTime / month;\n//\t\tif(M >= 1)\n//\t\t{\n//\t\t\treturn string.Format(\"{0} month ago\", M);\n//\t\t}\n\n        long D = leftTime / day;\n        if (D >= 1)\n        {\n            return string.Format(ScriptLocalization.Get(\"alliance_members_online_time_days\"), D);\n        }\n\n        long H = leftTime / hour;\n        if (H >= 1)\n        {\n            return string.Format(ScriptLocalization.Get(\"alliance_members_online_time_hours\"), H);\n        }\n\n        if (leftTime >= 1)\n        {\n            return string.Format(ScriptLocalization.Get(\"alliance_members_online_time_minutes\"), leftTime);\n        }\n\n        return string.Format(ScriptLocalization.Get(\"alliance_members_online_time_minutes\"), 1);\n    }\n\n    public static string FormatCeremonyCDTime(long duration)\n    {\n        long leftTime = duration / 60;\n\n        const long hour = 60;\n        const long day = 24 * hour;\n\n        long D = leftTime / day;\n        if (D >= 1)\n        {\n            return D + XLAT(\"chat_time_day\");\n        }\n\n        long H = leftTime / hour;\n        if (H >= 1)\n        {\n            return H + XLAT(\"chat_time_hour\");\n        }\n\n        if (leftTime >= 1)\n        {\n            return leftTime + XLAT(\"chat_time_min\");\n        }\n\n        return 1 + XLAT(\"chat_time_min\");\n    }\n\n    public static string UnixTimeStmapToFormattedTime(int unixTimeStamp)\n    {\n        DateTime startTime = TimeZone.CurrentTimeZone.ToLocalTime(new DateTime(1970, 1, 1)); // 当地时区\n        DateTime dt = startTime.AddSeconds(unixTimeStamp);\n        return dt.ToString(\"yyyy/MM/dd HH:mm:ss\");\n    }\n\n    public static DateTime UnixTimeStampToLocalDateTime(int unixTimeStamp)\n    {\n        DateTime startTime = TimeZone.CurrentTimeZone.ToLocalTime(new DateTime(1970, 1, 1)); // 当地时区\n        DateTime dt = startTime.AddSeconds(unixTimeStamp);\n        return dt;\n    }\n\n    public static void OpenGeneralPlotPopup(string titleKey, string desKey, string bgPath)\n    {\n        GeneralPlotInstructionPopup.Parameter param = new GeneralPlotInstructionPopup.Parameter();\n        param.tile = XLAT(titleKey);\n        param.description = XLAT(desKey);\n        param.bgPath = bgPath;\n\n        UIManager.inst.OpenPopupAsync(UIManager.PopupType.GeneralPlotInstructionPopup, param);\n    }\n\n    public static string GetDragonTendencyDesc(DragonData dragonData)\n    {\n        IDragonInfo info = DragonManager.Instance.GetDragonInfoByLevel(dragonData.Level);\n        string result = \"\";\n        string desc = \"\";\n        switch (dragonData.tendency)\n        {\n            case DragonData.Tendency.normal:\n                desc = \"dragon_character_neutral_0_name\";\n                break;\n            case DragonData.Tendency.pure:\n                desc = \"dragon_character_light_5_name\";\n                break;\n            case DragonData.Tendency.swift:\n                desc = \"dragon_character_dark_5_name\";\n                break;\n            case DragonData.Tendency.shine:\n                desc = \"dragon_character_light_10_name\";\n                break;\n            case DragonData.Tendency.ferocious:\n                desc = \"dragon_character_dark_10_name\";\n                break;\n        }\n\n        string age = string.Format(\"dragon_stage_{0}_name\", info.Age);\n\n        result = ScriptLocalization.Get(desc) + \" \" + ScriptLocalization.Get(age);\n\n        return result;\n    }\n\n    public static float GetScrollViewSize(UIScrollView scroll)\n    {\n        Bounds b = scroll.bounds;\n        Vector2 bmin = b.min;\n        Vector2 bmax = b.max;\n\n        Vector2 vect = Vector2.zero;\n        Vector4 clip = scroll.panel.finalClipRegion;\n\n        int intViewSize = Mathf.RoundToInt(clip.z);\n        if ((intViewSize & 1) != 0)\n            intViewSize -= 1;\n        float halfViewSize = intViewSize * 0.5f;\n        halfViewSize = Mathf.Round(halfViewSize);\n\n        if (scroll.panel.clipping == UIDrawCall.Clipping.SoftClip)\n            halfViewSize -= scroll.panel.clipSoftness.x;\n\n        float contentSize = bmax.x - bmin.x;\n        float viewSize = halfViewSize * 2f;\n\n        return viewSize;\n    }\n\n    public static Vector2 GetScrollViewCurrentContentSize(UIScrollView scroll)\n    {\n        Bounds b = scroll.bounds;\n        Vector2 bmin = b.min;\n        Vector2 bmax = b.max;\n\n        Vector2 vect = Vector2.zero;\n        Vector4 clip = scroll.panel.finalClipRegion;\n\n        int intViewSize = Mathf.RoundToInt(clip.z);\n        if ((intViewSize & 1) != 0)\n            intViewSize -= 1;\n        float halfViewSize = intViewSize * 0.5f;\n        halfViewSize = Mathf.Round(halfViewSize);\n\n        if (scroll.panel.clipping == UIDrawCall.Clipping.SoftClip)\n            halfViewSize -= scroll.panel.clipSoftness.x;\n\n        float contentSize = bmax.x - bmin.x;\n        float viewSize = halfViewSize * 2f;\n        float contentMin = bmin.x;\n        float contentMax = bmax.x;\n        float viewMin = clip.x - halfViewSize;\n        float viewMax = clip.x + halfViewSize;\n\n        contentMin = viewMin - contentMin;\n        contentMax = contentMax - viewMax;\n\n        vect.x = contentMin;\n        vect.y = contentMax;\n\n        return vect;\n    }\n\n    public static List<T> Merge<T>(List<T> source, List<T> target)\n    {\n        List<T> mergedList = new List<T>(source);\n\n        for (int i = 0; i < target.Count; i++)\n        {\n            if (!mergedList.Contains(target[i]))\n            {\n                mergedList.Add(target[i]);\n            }\n        }\n\n        return mergedList;\n    }\n\n    public static string GetResIconPath(string resType)\n    {\n        string pathRoot = \"Texture/BuildingConstruction/\";\n        switch (resType)\n        {\n            case CityResourceInfo.ResourceName.FOOD:\n                return pathRoot + \"food_icon\";\n            case CityResourceInfo.ResourceName.WOOD:\n                return pathRoot + \"wood_icon\";\n            case CityResourceInfo.ResourceName.ORE:\n                return pathRoot + \"ore_icon\";\n            case CityResourceInfo.ResourceName.SILVER:\n                return pathRoot + \"silver_icon\";\n            default:\n                return pathRoot + \"gold_coin\";\n        }\n    }\n\n    public static string GetResoureSpriteName(string resourName)\n    {\n        string path = \"\";\n        switch (resourName)\n        {\n            case CityResourceInfo.ResourceName.FOOD:\n                path = \"food_icon\";\n                break;\n            case CityResourceInfo.ResourceName.WOOD:\n                path = \"wood_icon\";\n                break;\n            case CityResourceInfo.ResourceName.ORE:\n                path = \"ore_icon\";\n                break;\n            case CityResourceInfo.ResourceName.SILVER:\n                path = \"silver_icon\";\n                break;\n        }\n\n        return path;\n    }\n\n    // 获取资源背景图 目前只有这一个 \n    public static string GetResourceBgPath(ResourceType resType)\n    {\n        return \"Texture/Equipment/frame_equipment_0\";\n    }\n\n    //获取资源图片名称\n    public static string GetResourceSpriteName(ResourceType resType)\n    {\n        string iconName = null;\n        switch (resType)\n        {\n            case ResourceType.Food:\n                iconName = \"food_icon\";\n                break;\n            case ResourceType.Wood:\n                iconName = \"wood_icon\";\n                break;\n            case ResourceType.Ore:\n                iconName = \"ore_icon\";\n                break;\n            case ResourceType.Silver:\n                iconName = \"silver_icon\";\n                break;\n            case ResourceType.Coin:\n                iconName = \"icon_currency_premium\";\n                break;\n            case ResourceType.Steel:\n                iconName = \"steel_icon\";\n                break;\n        }\n\n        return iconName;\n    }\n\n    //获取资源图片路径\n    public static string GetResourceSpritePath(ResourceType resType)\n    {\n        string iconName = GetResourceSpriteName(resType);\n        if (string.IsNullOrEmpty(iconName))\n            return null;\n        return string.Format(\"Texture/BuildingConstruction/{0}\", iconName);\n    }\n\n    public static string GerResourceOrItemSpritePath(ResourceType resType, long itemId)\n    {\n        if (resType == ResourceType.Item)\n        {\n            ItemlistInfo item = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n            if (item != null)\n            {\n                return item.ImagePath;\n            }\n\n            return string.Empty;\n        }\n\n        return GetResourceSpritePath(resType);\n    }\n\n    //获取资源或道具名称\n    public static string GetResourceAndItemName(ResourceType resType, long itemId)\n    {\n        ItemlistInfo item = null;\n        if (resType == ResourceType.Item)\n        {\n            item = ConfigManager2.Instance.DB_Itemlist.GetItem(itemId);\n        }\n\n        return GetResourceAndItemName(resType, item);\n    }\n\n    //获取资源或道具名称\n    public static string GetResourceAndItemName(ResourceType resType, ItemlistInfo item)\n    {\n        switch (resType)\n        {\n            case ResourceType.Item:\n                if (item != null)\n                    return item.LocName;\n                break;\n            case ResourceType.Steel:\n                return XLAT(\"item_id_steel\");\n        }\n\n        return string.Empty;\n    }\n\n    public const int SIGN_COOL_DOWN = 7;\n    public const float DOUBLE_CLICK_TIMEOUT = 0.3f;\n    public const int ONE_MINUTE = 60;\n    public const int ONE_HOUR = 3600;\n    public const int ONE_DAY = 86400;\n    public const int TWO_DAYS = 172800;\n\n    public static int GetSignInDays()\n    {\n        StatsData statsData = DBManager.Instance.DB_Stats.Get(\"sign_in\");\n        if (statsData != null)\n        {\n            int lastZeroTime = ((int)statsData.mtime / ONE_DAY) * ONE_DAY;\n            int duration = NetServerTime.Instance.ServerTimestamp - lastZeroTime;\n            if (duration <= TWO_DAYS)\n            {\n                if (duration > ONE_DAY && statsData.count >= SIGN_COOL_DOWN)\n                {\n                    return 0;\n                }\n\n                return (int)statsData.count;\n            }\n        }\n\n        return 0;\n    }\n\n    public static bool IsSignedIn()\n    {\n        StatsData statsData = DBManager.Instance.DB_Stats.Get(\"sign_in\");\n        if (statsData != null)\n        {\n            int lastZeroTime = ((int)statsData.mtime / ONE_DAY) * ONE_DAY;\n            int duration = NetServerTime.Instance.ServerTimestamp - lastZeroTime;\n            return (duration <= ONE_DAY);\n        }\n\n        return false;\n    }\n\n    public static bool IsIAPSevenDay()\n    {\n        long startTime = (PlayerData.inst.userData.CTime / ONE_DAY) * ONE_DAY;\n\n        int activityNum = ConfigManager.inst.DB_ConfigIapSevenDayRewards.GetActivityDayNum();\n        long endTime = startTime + ONE_DAY * activityNum;\n\n        return NetServerTime.Instance.ServerTimestamp < endTime;\n    }\n\n    //是否注册小于7天，后台可能配置多天\n    public static bool IsRegMinNDay()\n    {\n        long startTime = (PlayerData.inst.userData.CTime / ONE_DAY) * ONE_DAY;\n\n        long day = ConfigManager2.Instance.DB_GameConfigs.GetLongValue(\"show_days_from_register\"); //\n\n        long endTime = startTime + ONE_DAY * day;\n\n        return NetServerTime.Instance.ServerTimestamp < endTime;\n    }\n\n    public static bool CanOpenActivityDlg()\n    {\n        return PlayerData.inst.CityData.mStronghold.Level >= 3;\n    }\n\n    public static bool IsShowSevenDay()\n    {\n        if (!SwitchManager.Instance.GetSwitch(SwitchConst.IS_SEVEN_DAYS_ACTIVITY_OPEN))\n            return false;\n\n        int total = DBManager.Instance.DB_SevenDays.TotalDays;\n        if (total <= 0)\n        {\n            return false;\n        }\n\n        int lastTime = PlayerPrefsEx.GetIntByUid(LocalDataConst.SEVEN_DAYS_TIME);\n        bool needShow = false;\n        if (lastTime <= 0)\n        {\n            needShow = true;\n        }\n        else\n        {\n            int lastZeroTime = (lastTime / ONE_DAY) * ONE_DAY;\n            int duration = NetServerTime.Instance.ServerTimestamp - lastZeroTime;\n            if (duration > ONE_DAY)\n            {\n                needShow = true;\n            }\n        }\n\n        if (needShow)\n        {\n            int maxDay = 7;\n            SevenDaysData data = DBManager.Instance.DB_SevenDays.GetSevenDaysData(maxDay);\n            if (data != null)\n            {\n                needShow = !data.IsExpired;\n            }\n        }\n\n        return needShow;\n    }\n\n\n    public static string GetBookmarkIconSpriteName(Bookmark bookmark)\n    {\n        string iconName = string.Empty;\n        if (bookmark == null) return iconName;\n        long type = bookmark.MarkType;\n        switch (bookmark.Category)\n        {\n            case BookMarkCategory.warzone:\n                switch ((AllianceBookmarkType)type)\n                {\n                    case AllianceBookmarkType.BUILDING_TOWER:\n                        iconName = \"icon_war_zone_team_mark_attack_1\";\n                        break;\n                    case AllianceBookmarkType.DEFENSE:\n                        iconName = \"icon_war_zone_team_mark_attack_2\";\n                        break;\n                    case AllianceBookmarkType.ATTACK:\n                        iconName = \"icon_war_zone_team_mark_cluster_1\";\n                        break;\n                    case AllianceBookmarkType.SUN:\n                        iconName = \"icon_war_zone_team_mark_defense_1\";\n                        break;\n                    case AllianceBookmarkType.MOON:\n                        iconName = \"icon_war_zone_team_mark_defense_2\";\n                        break;\n                }\n\n                if (type > 14)\n                {\n                    iconName = \"alliance_update_focus\";\n                }\n\n                break;\n            case BookMarkCategory.fantasy_s7_guild:\n            case BookMarkCategory.alliance:\n            case BookMarkCategory.lostBattleField:\n                switch ((AllianceBookmarkType)type)\n                {\n                    case AllianceBookmarkType.BUILDING_TOWER:\n                        iconName = \"alliance_update_tower\";\n                        break;\n                    case AllianceBookmarkType.DEFENSE:\n                        iconName = \"alliance_update_defense\";\n                        break;\n                    case AllianceBookmarkType.ATTACK:\n                        iconName = \"alliance_update_attack\";\n                        break;\n                    case AllianceBookmarkType.SUN:\n                        iconName = \"alliance_update_sun\";\n                        break;\n                    case AllianceBookmarkType.MOON:\n                        iconName = \"alliance_update_moon\";\n                        break;\n                    case AllianceBookmarkType.WONDER_WHEEL_TOWER_1:\n                    case AllianceBookmarkType.WONDER_WHEEL_TOWER_2:\n                    case AllianceBookmarkType.WONDER_WHEEL_TOWER_3:\n                    case AllianceBookmarkType.WONDER_WHEEL_TOWER_4:\n                        iconName = \"alliance_update_focus\";\n                        break;\n                }\n\n                break;\n            case BookMarkCategory.user:\n                switch (type)\n                {\n                    case BookmarkType.Other:\n                        iconName = \"icon_bookmark_marked\";\n                        break;\n                    case BookmarkType.Friend:\n                        iconName = \"icon_bookmark_friend\";\n                        break;\n                    case BookmarkType.Enemy:\n                        iconName = \"icon_bookmark_enemy\";\n                        break;\n                }\n\n                break;\n        }\n\n        return iconName;\n    }\n\n    public static Vector3 Dampen(ref Vector3 velocity, float damping, float strength, float dt)\n    {\n        float TIME_PER_FRAME = 1.0f / PlatformAdaptor.Adaptor.GetFrameRate();\n        ;\n\n        Vector3 offset = Vector3.zero;\n        int loop = (int)(dt / TIME_PER_FRAME + 0.5);\n        loop = Math.Max(1, loop);\n\n        for (int i = 0; i < loop; i++)\n        {\n            offset += velocity * TIME_PER_FRAME;\n            velocity = (float)Math.Pow(damping, strength * dt) * velocity;\n        }\n\n        return offset;\n    }\n\n    public static FileMode GetReplaceFileModel(string path)\n    {\n        return File.Exists(path) ? FileMode.Truncate : FileMode.OpenOrCreate;\n    }\n\n    public static void WriteFile(string path, byte[] bytes)\n    {\n        if (File.Exists(path))\n        {\n            File.Delete(path);\n        }\n\n        using (var rfile = new FileStream(path, GetReplaceFileModel(path), FileAccess.Write))\n        {\n            rfile.Write(bytes, 0, bytes.Length);\n        }\n    }\n\n    public static void SetLabelOutFlowText(UILabel uiLabel)\n    {\n        string strContent = uiLabel.text; // UILabel中显示的内容\n        if (string.IsNullOrEmpty(strContent))\n        {\n            return;\n        }\n\n        string strOut = string.Empty;\n        bool bWarp = uiLabel.Wrap(strContent, out strOut, uiLabel.height);\n        // 如果不能，就是说Text内容不能全部显示，这个时候，我们把最后一个字符去掉，换成省略号\"...\"\n        if (!bWarp && !string.IsNullOrEmpty(strOut))\n        {\n            strOut = CheckChangeEllipsis(uiLabel, strOut);\n        }\n\n        // 如果可以包围，就是说Text内容可以完全显示，这个时候，我们不做处理，直接显示内容。\n        uiLabel.text = strOut;\n    }\n\n    private static string CheckChangeEllipsis(UILabel uiLabel, string str)\n    {\n        if (string.IsNullOrEmpty(str) || uiLabel == null)\n            return str;\n\n        uiLabel.UpdateNGUIText();\n        if (str.Length < 5) //这种情况要不就直接省略号？不配用算法算一下\n            return \"...\";\n\n        float wDot2 = 0;\n        float wDot = NGUIText.GetGlyphWidth('.', '.');\n        wDot = (wDot + NGUIText.finalSpacingX) * 2;\n\n        bool isDo = false;\n        int count = str.Length - 1;\n        int subIndex = count;\n        float textWidth = 0;\n\n        for (int i = count; i >= 1; i--)\n        {\n            int ch = str[i];\n            int pre = str[i - 1];\n            textWidth += NGUIText.GetGlyphWidth(ch, pre) + NGUIText.finalSpacingX;\n            wDot2 = NGUIText.GetGlyphWidth('.', pre);\n            if (textWidth >= wDot2 + wDot)\n            {\n                subIndex = i;\n                break;\n            }\n        }\n\n        str = str.Substring(0, subIndex);\n        str += \"...\";\n\n        return str;\n    }\n\n    public static QuestRewardAgent GetRewardAgent(long questId)\n    {\n        QuestData2 quest = DBManager.Instance.DB_Quest.Get(questId);\n        if (quest != null)\n        {\n            return quest.RewardAgent;\n        }\n\n        TimerQuestData time = DBManager.Instance.DB_Local_TimerQuest.Get(questId);\n        if (time != null)\n        {\n            return time.RewardAgent;\n        }\n\n        return null;\n    }\n\n    public static string GetBenefitsOneDesc(Dictionary<int, float> Benefits)\n    {\n        PropertyDefinition benfit = null;\n        StringBuilder sb = new StringBuilder();\n        bool hasBenefits = false;\n        if (Benefits != null)\n        {\n            for (var i = Benefits.Keys.GetEnumerator(); i.MoveNext();)\n            {\n                benfit = ConfigManager.inst.DB_Properties[i.Current];\n                float value = Mathf.Abs(Benefits[i.Current]);\n                if (benfit != null)\n                {\n                    string sign = \"+\";\n                    if (benfit.IsNegative)\n                    {\n                        sign = \"-\";\n                    }\n\n                    sb.Append(\"[99ff00] \");\n                    sb.Append(sign);\n                    switch (benfit.Format)\n                    {\n                        case PropertyDefinition.FormatType.Percent:\n                            sb.Append(value * 100);\n                            sb.Append(\"%\");\n                            break;\n                        case PropertyDefinition.FormatType.Integer:\n                            sb.Append(value);\n                            break;\n                        case PropertyDefinition.FormatType.Seconds:\n                            sb.Append(value);\n                            sb.Append(\"S\");\n                            break;\n                        case PropertyDefinition.FormatType.Boolean:\n                            sb.Append((value == 1).ToString());\n                            break;\n                        default:\n                            sb.Append(value);\n                            break;\n                    }\n\n                    sb.Append(\"[-] \");\n                    break;\n                }\n            }\n        }\n\n        return sb.ToString();\n    }\n\n    public static string GetBenefitsDesc(Dictionary<int, float> Benefits)\n    {\n        PropertyDefinition benfit = null;\n        StringBuilder sb = new StringBuilder();\n        bool hasBenefits = false;\n        if (Benefits != null)\n        {\n            for (var i = Benefits.Keys.GetEnumerator(); i.MoveNext();)\n            {\n                benfit = ConfigManager.inst.DB_Properties[i.Current];\n                float value = Mathf.Abs(Benefits[i.Current]);\n                if (benfit != null)\n                {\n                    string sign = \"+\";\n                    if (benfit.IsNegative)\n                    {\n                        sign = \"-\";\n                    }\n\n                    sb.Append(benfit.Name);\n                    sb.Append(\"[99ff00] \");\n                    sb.Append(sign);\n                    switch (benfit.Format)\n                    {\n                        case PropertyDefinition.FormatType.Percent:\n                            sb.Append(value * 100);\n                            sb.Append(\"%\");\n                            break;\n                        case PropertyDefinition.FormatType.Integer:\n                            sb.Append(value);\n                            break;\n                        case PropertyDefinition.FormatType.Seconds:\n                            sb.Append(value);\n                            sb.Append(\"S\");\n                            break;\n                        case PropertyDefinition.FormatType.Boolean:\n                            sb.Append((value == 1).ToString());\n                            break;\n                        default:\n                            sb.Append(value);\n                            break;\n                    }\n\n                    sb.Append(\"[-] \");\n                }\n            }\n        }\n\n        return sb.ToString();\n    }\n\n    public static string GetSkillValueDesc(LegendSkillInfo skill)\n    {\n        PropertyDefinition benfit = null;\n        StringBuilder sb = new StringBuilder();\n        bool hasBenefits = false;\n        if (skill.Benefits != null)\n        {\n            for (var i = skill.Benefits.Keys.GetEnumerator(); i.MoveNext();)\n            {\n                benfit = ConfigManager.inst.DB_Properties[i.Current];\n                float value = skill.Benefits[i.Current];\n\n                if (benfit != null)\n                {\n                    string sign = \"+\";\n                    if (value < 0)\n                    {\n                        sign = \"-\";\n                    }\n\n                    sb.Append(benfit.Name);\n                    sb.Append(\"[99ff00] \");\n                    sb.Append(sign);\n                    sb.Append(value * 100);\n                    sb.Append(\"%[-] \");\n                    hasBenefits = true;\n                }\n            }\n        }\n\n\n        if (skill.OppBenefits != null)\n        {\n            if (skill.OppBenefits != null)\n            {\n                for (var i = skill.OppBenefits.Keys.GetEnumerator(); i.MoveNext();)\n                {\n                    benfit = ConfigManager.inst.DB_Properties[i.Current];\n                    float value = skill.OppBenefits[i.Current];\n\n                    if (benfit != null)\n                    {\n                        string sign = \"+\";\n                        if (value < 0)\n                        {\n                            sign = \"\";\n                        }\n\n                        sb.Append(benfit.Name);\n                        sb.Append(\"[99ff00] \");\n                        sb.Append(sign);\n                        sb.Append(value * 100);\n                        sb.Append(\"%[-] \");\n                        hasBenefits = true;\n                    }\n                }\n            }\n        }\n\n        if (!hasBenefits)\n        {\n            sb.Append(skill.Loc_Effect);\n        }\n\n        return sb.ToString();\n    }\n\n    public static T ParseEnum<T>(string value, bool ignoreCase = true)\n    {\n        try\n        {\n            return (T)Enum.Parse(typeof(T), value, ignoreCase);\n        }\n        catch (Exception e)\n        {\n            D.Error(\"Failed to parse enum for \" + typeof(T) + \" / \" + value + \" \" + e);\n            return (T)Enum.GetValues(typeof(T)).GetValue(0);\n        }\n    }\n\n    public static bool CheckBoostIsStart(string type)\n    {\n        JobEvent jobEvent = BoostType2JobEvent(type);\n        JobHandle job = JobManager.Instance.GetSingleJobByClass(jobEvent);\n\n        if (type == BoostType.peaceshield)\n        {\n            if (job == null) job = JobManager.Instance.GetSingleJobByClass(JobEvent.JOB_ACTIVITY_PEACE_SHIELD);\n        }\n\n        return job != null;\n    }\n\n    public static JobEvent BoostType2JobEvent(string type)\n    {\n        JobEvent jobEvent = JobEvent.JOB_UNKNOWN;\n        switch (type)\n        {\n            case BoostType.antiscout:\n                jobEvent = JobEvent.JOB_ANTI_SCOUT;\n                break;\n            case BoostType.peaceshield:\n                jobEvent = JobEvent.JOB_PEACE_SHIELD;\n                break;\n            case BoostType.attack:\n                jobEvent = JobEvent.JOB_ATTACK_BOOST;\n                break;\n            case BoostType.defense:\n                jobEvent = JobEvent.JOB_DEFENSE_BOOST;\n                break;\n            case BoostType.gatherspeed:\n                jobEvent = JobEvent.JOB_GATHER_SPEED_UP;\n                break;\n            case BoostType.marchsize:\n                jobEvent = JobEvent.JOB_MARCH_SIZE;\n                break;\n            case BoostType.rallycapacity:\n                jobEvent = JobEvent.JOB_RALLY_CAPACITY;\n                break;\n            case BoostType.troopdamage:\n                jobEvent = JobEvent.JOB_ARMY_DAMAGE_DECREASE_PERCENT;\n                break;\n            case BoostType.infantrydamage:\n                jobEvent = JobEvent.JOB_INFANTRY_DAMAGE_DECREASE_PERCENT;\n                break;\n            case BoostType.bowmendamage:\n                jobEvent = JobEvent.JOB_RANGED_DAMAGE_DECREASE_PERCENT;\n                break;\n            case BoostType.cavalrydamage:\n                jobEvent = JobEvent.JOB_CAVALRY_DAMAGE_DECREASE_PERCENT;\n                break;\n            case BoostType.marchspeed:\n                jobEvent = JobEvent.JOB_PVP_MARCHING;\n                break;\n            case BoostType.foodboost:\n                jobEvent = JobEvent.JOB_RESOURCE_FOOD_BOOST;\n                break;\n            case BoostType.woodboost:\n                jobEvent = JobEvent.JOB_RESOURCE_WOOD_BOOST;\n                break;\n            case BoostType.oreboost:\n                jobEvent = JobEvent.JOB_RESOURCE_ORE_BOOST;\n                break;\n            case BoostType.silverboost:\n                jobEvent = JobEvent.JOB_RESOURCE_SILVER_BOOST;\n                break;\n            case BoostType.upkeepreduction:\n                jobEvent = JobEvent.JOB_UPKEEP_REDUCE;\n                break;\n            case BoostType.alert:\n                jobEvent = JobEvent.JOB_ALERT_BOOST;\n                break;\n        }\n\n        return jobEvent;\n    }\n\n    public static void EnableNGUIControlInteraction(GameObject ob, bool enable)\n    {\n        var c = ob.GetComponentInChildren<Collider>();\n        if (c != null)\n        {\n            c.enabled = enable;\n        }\n    }\n\n    public static BasePresent GetBasePresentByID(long questId)\n    {\n        QuestData2 quest = DBManager.Instance.DB_Quest.Get(questId);\n        TimerQuestData time = DBManager.Instance.DB_Local_TimerQuest.Get(questId);\n        AchievementData achievementData = DBManager.Instance.DB_Achievements.Get(questId);\n        BasePresent present = null;\n        if (quest != null)\n        {\n            present = quest.Present;\n        }\n        else if (time != null)\n        {\n            present = time.Present;\n        }\n        else if (achievementData != null)\n        {\n            present = achievementData.Present;\n        }\n\n        return present;\n    }\n\n    public static string GetUITextPath()\n    {\n        return \"Texture/ItemIcons/\";\n    }\n\n    public static void DeleteFile(string path)\n    {\n        if (File.Exists(path))\n        {\n            File.Delete(path);\n        }\n    }\n\n    public static bool CheckFile(string path)\n    {\n        return File.Exists(path);\n    }\n\n    public static string XLAT(string source)\n    {\n        return (ScriptLocalization.Get(source));\n    }\n\n    [ReloadCallClear] private static readonly Dictionary<string, string> Dicts = new Dictionary<string, string>();\n\n    public static string XLATWithArgs(string source, string[] args)\n    {\n        Dicts.Clear();\n        for (int i = 0; i < args.Length; i++)\n        {\n            string key = i.ToString();\n            string value = \"\";\n            if (args[i] != null)\n            {\n                value = args[i].ToString();\n            }\n            else\n            {\n                value = \"null\";\n            }\n\n            Dicts.Add(key, value);\n        }\n\n        string text = ScriptLocalization.GetWithPara(source, Dicts);\n        return text;\n    }\n\n    public static string XLAT(string source, params object[] kvs)\n    {\n        if (kvs.Length % 2 != 0)\n        {\n            D.Error(\"Error: kvs pair should be an even number\");\n            return source;\n        }\n\n        Dicts.Clear();\n        for (int i = 0; i < kvs.Length; i += 2)\n        {\n            if (kvs[i] == null)\n            {\n                continue;\n            }\n\n            string key = kvs[i].ToString();\n            string value = \"\";\n            if (kvs[i + 1] != null)\n            {\n                value = kvs[i + 1].ToString();\n            }\n            else\n            {\n                value = \"null\";\n            }\n\n            Dicts.Add(key, value);\n        }\n\n        string text = ScriptLocalization.GetWithPara(source, Dicts);\n        return text;\n    }\n\n    public static Dictionary<string, string> _dicts = new Dictionary<string, string>();\n\n    public static string XLAT_Extend(string source, params object[] kvs)\n    {\n        if (kvs != null)\n        {\n            for (int i = 0; i < kvs.Length; i += 1)\n            {\n                string key = i.ToString();\n                string value = \"\";\n                if (kvs[i] != null)\n                {\n                    value = kvs[i].ToString();\n                }\n                else\n                {\n                    value = \"null\";\n                }\n\n                _dicts.Add(key, value);\n            }\n        }\n\n        string text = ScriptLocalization.GetWithPara(source, _dicts);\n        _dicts.Clear();\n\n        return text;\n    }\n\n    /// <summary>\n    /// -1:Invalid 0:Unfinished 1:Finished 2:Can get again\n    /// </summary>\n    /// <param name=\"strId\"></param>\n    /// <returns></returns>\n    public static int GetOnceRewardState(string strId)\n    {\n        var info = ConfigManager.inst.DB_ConfigOnceReward.GetData(strId);\n        if (info != null)\n        {\n            var data = DBManager.Instance.DB_Stats.Get(info.StatsName);\n            if (data != null)\n            {\n                if (info.DailyReset == 1 && !NetServerTime.Instance.IsToday(data.count))\n                    return 2;\n\n                return 1;\n            }\n\n            return 0;\n        }\n\n        return -1;\n    }\n\n    /// <summary>\n    /// 第二天可重复领取的状态为2，处理成未完成，逻辑统一\n    /// </summary>\n    /// <param name=\"strId\"></param>\n    /// <returns></returns>\n    public static bool HasOnceRewardDone(string strId)\n    {\n        return GetOnceRewardState(strId) == 1;\n    }\n\n    /// <summary>\n    /// \n    /// </summary>\n    /// <param name=\"source\">多语言key</param>\n    /// <param name=\"param\">带插入的参数</param>\n    /// <returns></returns>\n    public static string XLATParam(string source, params object[] param)\n    {\n        return string.Format(ScriptLocalization.Get(source), param);\n    }\n\n    /// <summary>\n    /// 把参数匹配符{0}, {1}替换掉\n    /// </summary>\n    /// <param name=\"source\"></param>\n    /// <param name=\"repStr\"></param>\n    /// <param name=\"sourceIsKey\">参数source是否是多语言key</param>\n    /// <returns></returns>\n    public static string XLATNoParam(string source, string repStr = \"\", bool sourceIsKey = true)\n    {\n        if (string.IsNullOrEmpty(source))\n        {\n            return string.Empty;\n        }\n\n        if (sourceIsKey)\n        {\n            source = ScriptLocalization.Get(source);\n        }\n\n        //修复错误的正则表达式\n        Regex repRegex = new Regex(@\"\\{[0-9][0-9]*\\}\");\n        //new Regex(@\"{[1-9][1-9]*}|{0}\");\n        return repRegex.Replace(source, repStr);\n    }\n\n    public static Color GetRedColor()\n    {\n        return GetColorFromHex(0xcc4747);\n    }\n\n    public static Color GetGreenColor()\n    {\n        return GetColorFromHex(0x4cbf96);\n    }\n\n    public static Color GetYellowColor()\n    {\n        return GetColorFromHex(0xe2be5d);\n    }\n\n    public static Color GetColorFromHex(uint hex)\n    {\n        uint red = hex >> 16;\n        uint greenBlue = hex - (red << 16);\n        uint green = greenBlue >> 8;\n        uint blue = greenBlue - (green << 8);\n\n        return new Color(red / 255.0f, green / 255.0f, blue / 255.0f);\n    }\n\n    public static Color GetColorFromHexAlpha(uint hex)\n    {\n        uint red = hex >> 24;\n        uint greenBlueAlpha = hex - (red << 24);\n        uint green = greenBlueAlpha >> 16;\n        uint blueAlpha = greenBlueAlpha - (green << 16);\n        uint blue = blueAlpha >> 8;\n        uint alpha = blueAlpha - (blue << 8);\n\n        return new Color(red / 255.0f, green / 255.0f, blue / 255.0f, alpha / 255.0f);\n    }\n\n    public static uint GetARGBFromColor32(Color32 color)\n    {\n        uint hex = 0;\n\n        hex |= (uint)color.a << 24;\n        hex |= (uint)color.r << 16;\n        hex |= (uint)color.g << 8;\n        hex |= color.b;\n\n        return hex;\n    }\n\n    public static uint GetRGBFromColor32(Color32 color)\n    {\n        uint hex = 0;\n\n        hex |= (uint)color.r << 16;\n        hex |= (uint)color.g << 8;\n        hex |= color.b;\n\n        return hex;\n    }\n\n    public static string ColorToHex(Color color)\n    {\n        int r = Mathf.RoundToInt(color.r * 255.0f);\n        int g = Mathf.RoundToInt(color.g * 255.0f);\n        int b = Mathf.RoundToInt(color.b * 255.0f);\n        int a = Mathf.RoundToInt(color.a * 255.0f);\n        string hex = $\"{r:X2}{g:X2}{b:X2}{a:X2}\";\n        return hex;\n    }\n\n\n    public static string GetRGBAFromColor(Color c)\n    {\n        return c.r.ToString(\"X2\") + c.g.ToString(\"X2\") + c.b.ToString(\"X2\") + c.a.ToString(\"X2\");\n    }\n\n    public static string WarpWord(string originalWord, int lineWidth)\n    {\n        StringBuilder sb = new StringBuilder();\n\n        Regex punctuationRegex = new Regex(@\"[，。；？~！：‘“”’【】 （）]\");\n        int tempNum = 0;\n        char[] c = originalWord.ToCharArray();\n\n        for (int i = 0; i < c.Length; i++)\n        {\n            if (c[i] >= 0x4e00 && c[i] <= 0x9fa5) // 汉字的范围\n            {\n                tempNum += 2;\n                if (tempNum > lineWidth)\n                {\n                    i--;\n                    sb.Append(\"\\n\");\n                    tempNum = 0;\n                }\n                else\n                {\n                    sb.Append(c[i]);\n                }\n            }\n            else\n            {\n                if (punctuationRegex.IsMatch(c[i].ToString()))\n                {\n                    tempNum += 2;\n                    if (tempNum > lineWidth)\n                    {\n                        i--;\n                        sb.Append(\"\\n\");\n                        tempNum = 0;\n                    }\n                    else\n                    {\n                        sb.Append(c[i]);\n                    }\n                }\n                else\n                {\n                    tempNum++;\n                    if (tempNum > lineWidth)\n                    {\n                        i--;\n                        sb.Append(\"\\n\");\n                        tempNum = 0;\n                    }\n                    else\n                    {\n                        sb.Append(c[i]);\n                    }\n                }\n            }\n        }\n\n        return sb.ToString();\n    }\n\n    public static string GetBenefitDescription(PropertyDefinition.FormatType format, double value,\n        bool negativeIsGood = false, Color32 goodColor = default(Color32), Color32 badColor = default(Color32))\n    {\n        //\n        bool negative = value < 0;\n\n        value = Math.Abs(value);\n        string content = \"\";\n        switch (format)\n        {\n            case PropertyDefinition.FormatType.Integer:\n                content = value.ToString();\n                break;\n\n            case PropertyDefinition.FormatType.Percent:\n                content = string.Format(\"{0:P}\", value);\n                break;\n        }\n\n        //\n        if (!negativeIsGood)\n        {\n            return negative ? GetColoredString(\"-\" + content, badColor) : GetColoredString(\"+\" + content, goodColor);\n        }\n\n        return negative ? GetColoredString(\"-\" + content, goodColor) : GetColoredString(\"+\" + content, badColor);\n    }\n\n    public static string GetBenefitValueString(PropertyDefinition.FormatType format, double value)\n    {\n        //\n\n# ... 文件过大，已截断\n```\n\n## 检查 Skill\n\n### Game\\.agents\\skills\\unity-code-review\\SKILL.md\n\n````markdown\n---\nname: unity-code-review\ndescription: Reviews Unity C# code against Unity's official style guide. Supports local git diff and GitHub PR review.\nargument-hint: [file | diff | PR_URL]\nallowed-tools: Read, Grep, Glob, Edit, Bash(git *, gh pr *, gh api *)\n---\n\n# Unity Code Review Skill\n\nYou are a Unity C# code review expert. Review code based on Unity C# style, project conventions, maintainability, lifecycle safety, and runtime risk.\n\n## Trigger Conditions\n\nThis skill activates when:\n\n- User invokes `/unity-code-review` with a file or diff.\n- User asks conversationally about code review, style guide compliance, or Unity best practices.\n- User mentions Unity code quality, SRP, naming conventions, performance, lifecycle, or code smells.\n\n## Review Modes\n\n### Local Git Diff Review\n\nWhen invoked without arguments or with `--diff`, review changes in `git diff`.\n\n### GitHub PR Review\n\nWhen provided with a PR URL, fetch the PR diff using `gh` commands and review.\n\n## Unity C# Style Guide Core Rules\n\n### Naming Conventions\n\n| Type | Rule | Example |\n| --- | --- | --- |\n| Classes, Structs | PascalCase | `PlayerController`, `GameStateMachine` |\n| Methods, Properties | PascalCase | `MovePlayer`, `Health` |\n| Private Fields | project-local convention | match nearby code, commonly `_camelCase` in this repo |\n| Local Variables | camelCase | `playerPosition`, `damage` |\n\nAvoid:\n\n- Single letter names except loop counters.\n- Hungarian notation.\n- Vague names such as `data`, `temp`, or `manager`.\n- Booleans without question-style names such as `isDead`, `hasLoaded`, or `canAttack`.\n\n### Single Responsibility\n\n- Each MonoBehaviour should have one clear engine-facing responsibility.\n- Keep gameplay logic testable outside Unity where practical.\n- Avoid boolean flag parameters when separate methods communicate intent better.\n- Keep methods small enough to review and test.\n\n### Comments\n\n- Comments should explain why, not what.\n- Public APIs may use XML documentation.\n- Do not leave commented-out code or stale TODOs.\n\n## Unity-Specific Review Focus\n\n### MonoBehaviour Lifecycle\n\n- Use `Awake` for local initialization and component caching.\n- Use `Start` only for initialization that depends on other objects being ready.\n- Subscribe in `OnEnable` and unsubscribe in `OnDisable` or `OnDestroy`.\n- Clean up coroutines, events, UniRx subscriptions, and async callbacks.\n\n### Coroutine and Async Patterns\n\n- Store coroutine references when cancellation is needed.\n- Avoid broad `StopAllCoroutines()` unless local ownership is obvious.\n- Stop async work when the owning object is disabled or destroyed.\n- In this repo, prefer existing helpers such as `Utils.StartCoroutine()` when local conventions require them.\n\n### Unity API Misuse\n\n| Issue | Correct Approach |\n| --- | --- |\n| `GetComponent` every frame | cache in `Awake` or use serialized references |\n| `tag == \"Enemy\"` | use `CompareTag()` |\n| allocating physics queries | use non-alloc APIs where appropriate |\n| frequent `Instantiate` / `Destroy` | use object pooling |\n| `GameObject.Find` in runtime paths | use serialized references, binders, or existing managers |\n\n### Performance Concerns\n\n- Avoid GC allocations in `Update`, `FixedUpdate`, and `LateUpdate`.\n- Avoid LINQ and string concatenation in hot paths.\n- Cache repeated lookups and temporary collections where appropriate.\n- Keep draw calls, physics checks, loading, and memory ownership in view when reviewing gameplay and UI changes.\n\n### Testing\n\n- Prefer pure C# tests for gameplay logic that can be separated from Unity.\n- Use Unity Test Framework for engine-dependent behavior.\n- Check edge cases: null, empty collections, zero values, destroyed objects, delayed callbacks, and partial data sync.\n\n## Review Workflow\n\n1. Run `git diff` or inspect the specified file / PR diff.\n2. Read full changed files and nearby related files for context.\n3. Review against Unity lifecycle, performance, architecture, and project conventions.\n4. Lead with correctness, runtime risk, and missing validation.\n5. Keep findings actionable and cite exact files.\n\n## Review Output Format\n\n```markdown\n## Code Review: [scope]\n\n### Findings\n\n1. **Issue title** (`path/to/file.cs`)\n   - What is wrong.\n   - Why it matters.\n   - Suggested fix.\n\n### Open Questions\n\n- Any assumptions or unclear ownership.\n\n### Test Gaps\n\n- Validation that is missing or could not be run.\n```\n\n## Related Agents\n\n- unity-reviewer\n\n## Related Commands\n\n- unity-review\n\n## Common Code Smells\n\n| Code Smell | Description | Fix |\n| --- | --- | --- |\n| Enigmatic naming | Mysterious or unclear names | Use straightforward, descriptive names |\n| Needless complexity | Over-engineering, God objects | Break into smaller dedicated parts |\n| Inflexibility | Small change requires many changes | Check SRP violations |\n| Fragility | Minor change breaks everything | Review dependencies |\n| Immobility | Code not reusable elsewhere | Decouple logic |\n| Duplicate code | Copy-pasted logic | Extract core functionality |\n| Excessive commentary | Comments for every line | Use better names, trust the code |\n\n````"}]
